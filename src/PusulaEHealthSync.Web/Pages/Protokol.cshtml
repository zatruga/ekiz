        @* KULLANICI ISTEGI (2026-09-30): "epikrize tıklayınca da epikriz ön görüntüsü yani
           epikriz bilgisi yazsın". Buradaki bölümler CompositionMapper.Bolumler'den geliyor
           -- yani gönderim anında FHIR Composition'ın section[] dizisine yazılacak olan TAM
           liste, aynı sırayla. Ekranda ne görünüyorsa TRƏS'e o gidiyor; ayrı bir
           "önizleme mantığı" yok ki zamanla gerçekten gidenden ayrışsın. *@
        @{
            var (epPanelBadgeClass, epPanelBadgeLabel) = Model.EpikrizBadge();
        }
        <div class="side-card tab-panel-content" id="tab-panel-epikriz">
            <div class="side-card-section">
                <div class="side-card-head">
                    <span class="rt-name">
                        Epikriz (Composition) <span class="count">@Model.EpikrizBolumleri.Count bölüm</span>
                        <span class="badge @epPanelBadgeClass" style="padding:3px 9px; font-size:11px;"><span class="badge-dot"></span>@epPanelBadgeLabel</span>
                    </span>
                    <div class="side-card-actions">
                        @if (!isRecete && Model.EpikrizBolumleri.Count > 0)
                        {
                            <form method="post" asp-page-handler="GonderEpikriz" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-bulk btn-sm"
                                        onclick="return confirm('Epikriz TRƏS\'e CANLI olarak (kalıcı) gönderilecek. Emin misiniz?')">
                                    @(Model.EpikrizDurumKaydi is null ? "Gönder" : "Tekrar Gönder")
                                </button>
                            </form>
                        }
                        @if (SyncLogEntry.CanDelete(Model.EpikrizDurumKaydi))
                        {
                            <form method="post" asp-page-handler="SilEpikriz" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-outline btn-sm" style="border-color:var(--danger); color:var(--danger);"
                                        onclick="return confirm('Epikriz kaydı TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">
                                    Sil
                                </button>
                            </form>
                        }
                    </div>
                </div>
                @if (Model.EpikrizBolumleri.Count == 0)
                {
                    <div class="side-card-empty">
                        @if (Model.GenelMuayene is null)
                        {
                            <text>Bu protokol için Pusula'da muayene/epikriz kaydı bulunamadı -- gönderilecek içerik yok.</text>
                        }
                        else
                        {
                            <text>Epikriz alanlarının hiçbirinde metin yok -- gönderilecek içerik yok.</text>
                        }
                    </div>
                }
                else
                {
                    <p class="epikriz-onizleme-not">
                        Aşağıdaki @Model.EpikrizBolumleri.Count bölüm, TRƏS'e gönderilecek belgenin içeriğidir.
                        Pusula'daki RTF biçimlendirmesi düz metne çevrilmiş haliyle gösteriliyor -- gönderilen de budur.
                    </p>
                    @foreach (var bolum in Model.EpikrizBolumleri)
                    {
                        <div class="epikriz-bolum">
                            <div class="epikriz-bolum-head">
                                <span class="epikriz-bolum-baslik">@bolum.Baslik</span>
                                <span class="epikriz-bolum-kod" title="Bu bölümün FHIR section.code değeri">LOINC @bolum.LoincKodu</span>
                            </div>
                            <div class="epikriz-bolum-metin">@bolum.Metin</div>
                        </div>
                    }
                }
            </div>
        </div>

        @* ============ YAPILACAKLAR PANELI (2026-10-01) ============
           KULLANICI ISTEGI: "Seçenek B'nin mantığını çok sevdim ... sağ tarafa Yapılacaklar
           diye sistem bize ne yapmamız gerektiğini söylesin."

           Liste ProtokolModel.Yapilacaklar()'tan geliyor. Her kart uc seyi birden soyluyor:
           NE oldu (baslik), NEDEN (sebep -- hata mesajlarindan en sik gorulen kategori) ve
           HANGILERI (ornekler). Eskiden bunlarin ucu de ayri yerlerdeydi: sayi satirda,
           sebep Kayit Detayi'nda, hangileri ise acilir panelde tek tek bakilarak bulunuyordu. *@
        @{
            var yapilacakListesi = Model.Yapilacaklar();
        }
        <div class="side-card tab-panel-content" id="tab-panel-yapilacaklar">
            <div class="side-card-section">
                <div class="side-card-head">
                    <span class="rt-name">
                        Yapılacaklar
                        @if (yapilacakListesi.Count > 0)
                        {
                            <span class="count">@yapilacakListesi.Count madde</span>
                        }
                    </span>
                </div>

                @if (yapilacakListesi.Count == 0)
                {
                    <div class="yapilacak-temiz">
                        <strong>Bu protokolde yapılacak bir şey yok.</strong>
                        Gönderilebilecek her kayıt TRƏS'e gitmiş durumda.
                    </div>
                }
                else
                {
                    @foreach (var fis in yapilacakListesi)
                    {
                        <div class="yapilacak @(fis.Hata ? "yapilacak--hata" : "yapilacak--bekleyen")">
                            <div class="yapilacak-govde">
                                <div class="yapilacak-baslik">@fis.Baslik</div>
                                <div class="yapilacak-sebep">@fis.Sebep</div>
                                @if (!string.IsNullOrEmpty(fis.Ornek))
                                {
                                    <div class="yapilacak-ornek">@fis.Ornek</div>
                                }
                            </div>
                            <div class="yapilacak-aksiyon">
                                @if (fis.Handler is not null)
                                {
                                    <form method="post" asp-page-handler="@fis.Handler" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                        <button type="submit" class="btn btn-primary btn-sm"
                                                onclick="return confirm('Bu kayıtlar TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                                            @(fis.Hata ? "Tekrar Dene" : "Gönder")
                                        </button>
                                    </form>
                                }
                                @if (fis.BaglantiSayfa is not null)
                                {
                                    <a asp-page="@fis.BaglantiSayfa" class="btn btn-outline btn-sm">@fis.BaglantiAdi</a>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* ============ ALT SERIT (2026-10-01 kullanici istegi) ============
       "diğer seçeneklerde olan altta protokolü TRƏS'ten sil butonu koyalım."

       Silme buraya tasindi, cunku geri alinamaz: TRƏS devlet kayit sistemi ve silinen kayit
       geri gelmiyor. Sayfanin en altinda, kendi seridinde, tek basina duruyor -- kullanici
       oraya ancak bilerek iner. Ust seritte "Tümünü Gönder"in yaninda dururken ikisi esit
       agirliktaydi; biri gunluk is, digeri son care. *@
    @if (!isRecete)
    {
        <div class="alt-serit">
            <div class="alt-serit-bilgi">
                @{
                    var sonIslem = new[] { Model.HastaDurumKaydi, Model.MuayineDurumKaydi, Model.EpikrizDurumKaydi, Model.VitalDurumKaydi }
                        .Where(d => d is not null)
                        .OrderByDescending(d => d!.CreatedAtUtc)
                        .FirstOrDefault();
                }
                @if (sonIslem is not null)
                {
                    <text>Son gönderim: @AzTime.ToLocal(sonIslem.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm")</text>
                }
                else
                {
                    <text>Bu protokolden TRƏS'e henüz hiçbir kayıt gönderilmedi.</text>
                }
            </div>
            <form method="post" asp-page-handler="TumunuSil" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                <button type="submit" class="btn btn-outline btn-sm alt-serit-sil"
                        onclick="return confirm('Bu protokolün TRƏS\'e gönderilmiş TÜM kayıtları silinecek: Patoloji, Radyoloji, Laboratuvar, Vital Bulgular, Epikriz, İşlem, Tanı ve Müayinə.\n\nHasta (Patient) SİLİNMEZ -- aynı hasta başka protokollerde de kullanılıyor.\n\nBu işlem geri alınamaz. Emin misiniz?')">
                    Protokolü TRƏS'ten sil
                </button>
            </form>
        </div>
    }
}

@section Scripts {
    <script>
        // KULLANICI ISTEGI (2026-08-29, protokol 50853078 -- sonra 2026-08-31'de "bu işlem
        // diğer tüm gönderimler için geçerli olsun tanı ve procedür" ile TÜM gönderim
        // listelerine genellendi): Tarih basligina tiklayinca satirlari (ve lab'daki panel
        // gruplarini -- gruplama BOZULMAZ, sadece en ust seviye tarihe gore siralanir)
        // A-Z/Z-A sirala. Her liste kendi containerId/arrowId'siyle bagimsiz calisir. DOM
        // node'lari appendChild ile TASINIYOR (klonlanmiyor) -- form/event handler'lar ve
        // acik <details> durumu korunur.
        const pusulaSortState = {};
        function pusulaSortRows(containerId, arrowId) {
            var container = document.getElementById(containerId);
            if (!container) return;
            var items = Array.prototype.filter.call(container.children, function (el) {
                return el.hasAttribute('data-sort-date');
            });
            var dir = pusulaSortState[containerId] === 'asc' ? 'desc' : 'asc';
            pusulaSortState[containerId] = dir;
            items.sort(function (a, b) {
                var da = a.getAttribute('data-sort-date') || '';
                var db = b.getAttribute('data-sort-date') || '';
                if (da === db) return 0;
                if (dir === 'asc') return da < db ? -1 : 1;
                return da > db ? -1 : 1;
            });
            items.forEach(function (el) { container.appendChild(el); });
            var arrow = document.getElementById(arrowId);
            if (arrow) arrow.textContent = dir === 'asc' ? '↑' : '↓';
        }

        // KULLANICI ISTEGI (2026-08-31): "üst taraftaki başlıklar tıklanılabilir olsun ...
        // alt taraftaki alanda bu bilgiler gösterilsin". Aynı anda TEK panel görünür --
        // sayfa yüksekliği artık liste uzunluğundan bağımsız. Hangi panelin açık olduğu
        // protokol id'sine göre sessionStorage'da tutuluyor -- Gönder/Sil bir tam sayfa
        // yenilemesi (RedirectToPage) tetiklediği için, bu olmasa kullanıcı her işlemden
        // sonra "yukarı çık, tekrar tıkla" yapmak zorunda kalırdı.
        var pusulaTabKey = 'pusula-protokol-tab-@(Model.Protokol?.ProtokolId ?? 0)';

        function pusulaShowTab(name) {
            document.querySelectorAll('.checklist-item--tab').forEach(function (el) {
                el.classList.toggle('active', el.dataset.tab === name);
            });
            document.getElementById('tab-detail-empty').style.display = 'none';
            document.querySelectorAll('.tab-panel-content').forEach(function (el) {
                el.classList.toggle('active', el.id === 'tab-panel-' + name);
            });
            try { sessionStorage.setItem(pusulaTabKey, name); } catch (e) { /* gizli mod vb. -- sessizce yoksay */ }
        }

        (function pusulaRestoreTab() {
            var saved = null;
            try { saved = sessionStorage.getItem(pusulaTabKey); } catch (e) { /* yoksay */ }
            if (saved && document.getElementById('tab-panel-' + saved)) {
                pusulaShowTab(saved);
            }
        })();
    </script>
}

                    </span>
                    <div class="side-card-actions">
                        @if (Model.LabsGonderilebilir)
                        {
                            <form method="post" asp-page-handler="TumunuGonderLab" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-bulk btn-sm"

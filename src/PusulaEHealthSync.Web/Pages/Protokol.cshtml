@page "{id:int}"
@model PusulaEHealthSync.Web.Pages.ProtokolModel
@using PusulaEHealthSync.Persistence
@using PusulaEHealthSync.Mapping
@{
    ViewData["Title"] = Model.Protokol is null ? "Protokol" : $"Protokol #{Model.Protokol.ProtokolId}";
}

@if (Model.Protokol is null)
{
    <div class="table-wrap empty-state"><p>Protokol bulunamadı.</p></div>
}
else
{
    var p = Model.Protokol;
    var h = Model.Hasta;
    var isRecete = p.ProtokolTipiId == EncounterMapper.ReceteProtokolTipiId;
    <p class="breadcrumb"><a asp-page="/Index">Protokol Listesi</a> / Protokol Detay</p>
    @* Bir bolumun Pusula sorgusu zaman asimina ugrarsa sayfa artik 500 vermiyor; o bolum
   bos kaliyor ve sebebi burada yaziyor. Uyari GONDERIM butonlarindan ONCE, sayfanin en
   basinda duruyor -- eksik veriyle gonderim yapilmasin diye. *@
@if (Model.BolumHatalari.Count > 0)
{
    <div class="alert alert-warning" style="margin-bottom:16px;">
        <strong>Bu sayfa eksik yüklendi.</strong>
        <ul style="margin:6px 0 0 18px; padding:0;">
            @foreach (var hata in Model.BolumHatalari)
            {
                <li>@hata</li>
            }
        </ul>
    </div>
}

<div class="page-header">
        <div>
            <h1 class="page-title">@p.HastaAdiSoyadi</h1>
        </div>
        <div style="display:flex; gap:8px;">
            @* KULLANICI ISTEGI (2026-10-01): "sağ tarafa Yapılacaklar diye sistem bize ne
               yapmamız gerektiğini söylesin." Rakam, mudahale bekleyen is sayisi -- sifirsa
               buton sakin durur, varsa kirmizi rozetle kendini gosterir. *@
            @{ var yapilacakSayisi = Model.Yapilacaklar().Count; }
            <button type="button" class="btn btn-outline btn-sm yapilacaklar-btn" onclick="pusulaShowTab('yapilacaklar')">
                Yapılacaklar
                @if (yapilacakSayisi > 0)
                {
                    <span class="yapilacaklar-sayi">@yapilacakSayisi</span>
                }
            </button>
            <a asp-page="/Hasta" asp-route-id="@p.HastaId" class="btn btn-outline btn-sm">Hasta Detay</a>
            <a asp-page="/Index" class="btn btn-outline btn-sm">&larr; Listeye dön</a>
        </div>
    </div>

    <div class="card info-strip" style="margin-bottom:16px;">
        <div class="info-item">
            <span class="label">Protokol No</span>
            <span class="value">@p.ProtokolId</span>
        </div>
        <div class="info-item">
            <span class="label">Hasta No</span>
            <span class="value"><a asp-page="/Hasta" asp-route-id="@p.HastaId" style="color:inherit; text-decoration:none;">@p.HastaId</a></span>
        </div>
        <div class="info-item">
            <span class="label">Bölüm</span>
            <span class="value" style="font-family:var(--font-body); font-weight:400;">@(p.BolumAdi ?? "-")</span>
        </div>
        <div class="info-item">
            <span class="label">FIN No</span>
            <span class="value">@(h?.TCKimlikNo ?? p.Fin ?? "-")</span>
        </div>
        <div class="info-item">
            <span class="label">Doğum tarihi</span>
            <span class="value">@(h?.DogumTarihi?.ToString("yyyy-MM-dd") ?? "-")</span>
        </div>
        <div class="info-item">
            <span class="label">Cinsiyet</span>
            <span class="value" style="font-family:var(--font-body); font-weight:400;">
                @(h?.CinsiyetId switch { "E" => "Erkek", "K" => "Kadın", "D" => "Diğer", _ => h?.CinsiyetId ?? "-" })
            </span>
        </div>
        <div class="info-item">
            <span class="label">Protokol açılış tarihi</span>
            <span class="value">@(p.AcilisTarihi?.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
        </div>
        <div class="info-item">
            <span class="label">Doktor</span>
            <span class="value" style="font-family:var(--font-body); font-weight:400;">@(p.DoktorAdiSoyadi ?? "-")</span>
        </div>
        <div class="info-item">
            <span class="label">Geliş Tipi</span>
            <span class="value" style="font-family:var(--font-body); font-weight:400;">@PusulaEHealthSync.Web.Pages.IndexModel.GelisTipiLabel(p.GelisTipiId)</span>
        </div>
        <div class="info-item">
            <span class="label">Protokol Tipi</span>
            <span class="value" style="font-family:var(--font-body); font-weight:400;">@PusulaEHealthSync.Web.Pages.IndexModel.ProtokolTipiLabel(p.ProtokolTipiId)</span>
        </div>
        <div class="info-item">
            <span class="label">Kapanış</span>
            <span class="value" style="font-family:var(--font-body); font-weight:400;">@(p.KapanisTarihi?.ToString("yyyy-MM-dd HH:mm") ?? "Açık protokol")</span>
        </div>
        @if (!isRecete)
        {
            @* "Tümünü Sil" ARTIK BURADA DEGIL (2026-10-01 kullanici istegi): sayfanin en
               altina, kendi seridine tasindi. Gerekce: silme gunde bir kez bile basilmayan,
               geri alinamaz bir islem; her gun basilan "Tümünü Gönder"in yaninda esit
               agirlikta durmasi hem dikkati bolüyor hem de yanlis tiklama riski yaratiyordu. *@
            <div style="margin-left:auto; align-self:center; display:flex; gap:8px;">
                <form method="post" asp-page-handler="TumunuGonder" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                    <button type="submit" class="btn btn-bulk btn-sm"
                            onclick="return confirm('Bu protokol için Hasta, Müayinə, Tanı, İşlem, Epikriz, Vital Bulgular, Laboratuvar, Radyoloji ve Patoloji TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                        Tümünü Gönder
                    </button>
                </form>
            </div>
        }
    </div>

    @* ============ SECENEK A: SADE LISTE (2026-10-01 kullanici karari) ============
       Her satirda TEK rozet, TEK sayi, TEK birincil buton. Ikincil islemler (Detay, Sil,
       Tekrar Gonder) satirin sonundaki ⋯ menusunde.

       NEDEN: eskiden satir basina uc buton vardi ve hepsi ayni gorsel agirliktaydi -- her
       gun basilan Gonder ile ayda bir basilan Sil esit yer kapliyordu. Ekranda 12 buton
       olunca hicbiri one cikmiyor. Sil'i menuye almak ayni zamanda yanlislikla silme
       riskini de dusuruyor.

       Rozet artik ALT AGACI sayiyor (bkz. ProtokolModel.Topla): Muayine satiri, altindaki
       21 islemden 19'u gitmediyse yesil "Gonderildi" diyemez.

       ⋯ menusu native <details>/<summary> -- JS gerekmiyor, klavyeyle de acilir. Satirin
       kendisi tiklanabilir oldugu icin summary'de stopPropagation var. *@
    <p class="section-title">TRƏS gönderim durumu</p>
    <div class="checklist">

        @{
            var hastaSatir = Model.HastaSatiri();
        }
        <div class="checklist-item">
            <span class="rt-stripe rt-stripe--@hastaSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Hasta <span class="rt-fhir">Patient</span></span>
                <span class="rt-desc">
                    @if (Model.HastaDurumKaydi is null)
                    {
                        <text>Henüz gönderim denemesi yapılmadı.</text>
                    }
                    else
                    {
                        var hastaMsj = Model.HastaDurumKaydi.Message is null ? ""
                            : Model.HastaDurumKaydi.Status == SyncStatus.Failed ? SyncLogEntry.FriendlyError(Model.HastaDurumKaydi.Message)
                            : Model.HastaDurumKaydi.Message;
                        <text>Son deneme @AzTime.ToLocal(Model.HastaDurumKaydi.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm")@(string.IsNullOrEmpty(hastaMsj) ? "." : $" — {hastaMsj}")</text>
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @hastaSatir.CssClass"><span class="badge-dot"></span>@hastaSatir.Etiket</span>
                @if (!PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(Model.HastaDurumKaydi))
                {
                    <form method="post" asp-page-handler="GonderHasta" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm"
                                onclick="return confirm('Hasta bilgisi TRƏS\'e CANLI olarak (kalıcı) gönderilecek. Emin misiniz?')">
                            @(Model.HastaDurumKaydi is null ? "Gönder" : "Tekrar Dene")
                        </button>
                    </form>
                }
                <details class="rt-menu">
                    <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Hasta için diğer işlemler">&#8943;</summary>
                    <div class="rt-menu-pop">
                        @if (Model.HastaDurumKaydi is not null)
                        {
                            <a asp-page="/Detail" asp-route-id="@Model.HastaDurumKaydi.Id" asp-route-fromProtokol="@p.ProtokolId" class="rt-menu-item">Kayıt detayı</a>
                            @if (PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(Model.HastaDurumKaydi))
                            {
                                <form method="post" asp-page-handler="GonderHasta" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                    <button type="submit" class="rt-menu-item"
                                            onclick="return confirm('Hasta bilgisi TRƏS\'e yeniden gönderilecek. Emin misiniz?')">Tekrar gönder</button>
                                </form>
                            }
                        }
                        @if (SyncLogEntry.CanDelete(Model.HastaDurumKaydi))
                        {
                            <form method="post" asp-page-handler="SilHasta" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                        onclick="return confirm('Hasta kaydı TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">TRƏS'ten sil</button>
                            </form>
                        }
                        @if (Model.HastaDurumKaydi is null)
                        {
                            <span class="rt-menu-bos">Henüz kayıt yok</span>
                        }
                    </div>
                </details>
            </div>
        </div>

        @{
            var muayineSatir = Model.MuayineSatiri();
        }
        <div class="checklist-item checklist-item--tab" data-tab="muayine" onclick="pusulaShowTab('muayine')">
            <span class="rt-stripe rt-stripe--@muayineSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Müayinə <span class="rt-fhir">Encounter</span> <span class="tab-chevron">&#9656;</span></span>
                <span class="rt-desc">
                    @if (isRecete)
                    {
                        <text>Protokol tipi Reçete — bu tür protokoller TRƏS'e gönderilmez.</text>
                    }
                    else
                    {
                        <text>@Model.Tanilar.Count tanı, @Model.Islemler.Count işlem — listesi için tıklayın.</text>
                        @if (p.KapanisTarihi is null && !Model.MuayineGonderimeUygun)
                        {
                            <text> Protokol açık; kapanana kadar beklemesi öneriliyor.</text>
                        }
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @muayineSatir.CssClass"><span class="badge-dot"></span>@muayineSatir.Etiket</span>
                @if (!isRecete && muayineSatir.Giden < muayineSatir.Toplam)
                {
                    <form method="post" asp-page-handler="GonderMuayine" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm" onclick="event.stopPropagation(); return confirm('Müayinə, tanılar ve işlemler TRƏS\'e CANLI olarak (kalıcı) gönderilecek. Emin misiniz?')">
                            @(Model.MuayineDurumKaydi is null ? "Gönder" : "Tekrar Dene")
                        </button>
                    </form>
                }
                @{
                    // Menu BOS acilmasin: hicbir sey gonderilmemis bir protokolde Muayine
                    // menusundeki her ogenin kosulu false olup bos beyaz bir kutu aciliyordu
                    // (canli ekranda goruldu). Ayni kalip Hasta/Epikriz/Lab satirlarinda zaten
                    // vardi, burada eksikti.
                    var muayineMenuDolu = Model.MuayineDurumKaydi is not null
                        || Model.TanilarSilinebilir || Model.IslemlerSilinebilir;
                }
                <details class="rt-menu" onclick="event.stopPropagation()">
                    <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Müayinə için diğer işlemler">&#8943;</summary>
                    <div class="rt-menu-pop">
                        @if (!muayineMenuDolu)
                        {
                            <span class="rt-menu-bos">Henüz kayıt yok</span>
                        }
                        @if (Model.MuayineDurumKaydi is not null)
                        {
                            <a asp-page="/Detail" asp-route-id="@Model.MuayineDurumKaydi.Id" asp-route-fromProtokol="@p.ProtokolId" class="rt-menu-item">Kayıt detayı</a>
                        }
                        @if (!isRecete && muayineSatir.Giden == muayineSatir.Toplam && muayineSatir.Toplam > 0)
                        {
                            <form method="post" asp-page-handler="GonderMuayine" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item" onclick="return confirm('Müayinə TRƏS\'e yeniden gönderilecek. Emin misiniz?')">Tekrar gönder</button>
                            </form>
                        }
                        @if (Model.TanilarSilinebilir)
                        {
                            <form method="post" asp-page-handler="TumunuSilTani" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                        onclick="return confirm('Gönderilmiş TÜM tanı kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">Tanıları sil</button>
                            </form>
                        }
                        @if (Model.IslemlerSilinebilir)
                        {
                            <form method="post" asp-page-handler="TumunuSilIslem" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                        onclick="return confirm('Gönderilmiş TÜM işlem kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">İşlemleri sil</button>
                            </form>
                        }
                        @if (SyncLogEntry.CanDelete(Model.MuayineDurumKaydi))
                        {
                            <form method="post" asp-page-handler="SilMuayine" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                        onclick="return confirm('Müayinə kaydı TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">Müayinə'yi sil</button>
                            </form>
                        }
                    </div>
                </details>
            </div>
        </div>

        @{
            var labSatir = Model.LabSatiri();
        }
        <div class="checklist-item checklist-item--tab" data-tab="lab" onclick="pusulaShowTab('lab')">
            <span class="rt-stripe rt-stripe--@labSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Laboratuvar <span class="rt-fhir">Observation</span> <span class="tab-chevron">&#9656;</span></span>
                <span class="rt-desc">
                    @if (Model.LabGroups.Count == 0)
                    {
                        <text>Onaylanmış laboratuvar sonucu bulunamadı.</text>
                    }
                    else
                    {
                        <text>@Model.LabGroups.Count tetkik, @Model.Labs.Count satır — listesi için tıklayın.</text>
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @labSatir.CssClass"><span class="badge-dot"></span>@labSatir.Etiket</span>
                @if (Model.LabsGonderilebilir)
                {
                    <form method="post" asp-page-handler="TumunuGonderLab" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm" onclick="event.stopPropagation(); return confirm('Henüz gönderilmemiş/hatalı tüm laboratuvar sonuçları TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                            @(labSatir.Giden == 0 ? "Gönder" : "Eksikleri Gönder")
                        </button>
                    </form>
                }
                @if (Model.LabGroups.Count > 0)
                {
                    <details class="rt-menu" onclick="event.stopPropagation()">
                        <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Laboratuvar için diğer işlemler">&#8943;</summary>
                        <div class="rt-menu-pop">
                            @if (Model.LabsSilinebilir)
                            {
                                <form method="post" asp-page-handler="TumunuSilLab" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                    <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                            onclick="return confirm('Gönderilmiş TÜM laboratuvar kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">Tümünü TRƏS'ten sil</button>
                                </form>
                            }
                            else
                            {
                                <span class="rt-menu-bos">Silinecek kayıt yok</span>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        @{
            var radSatir = Model.RadSatiri();
        }
        <div class="checklist-item checklist-item--tab" data-tab="radiology" onclick="pusulaShowTab('radiology')">
            <span class="rt-stripe rt-stripe--@radSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Radyoloji <span class="rt-fhir">DiagnosticReport</span> <span class="tab-chevron">&#9656;</span></span>
                <span class="rt-desc">
                    @if (Model.RadiologyReports.Count == 0)
                    {
                        <text>Onaylanmış radyoloji raporu bulunamadı.</text>
                    }
                    else
                    {
                        <text>@Model.RadiologyReports.Count rapor — listesi için tıklayın.</text>
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @radSatir.CssClass"><span class="badge-dot"></span>@radSatir.Etiket</span>
                @if (Model.RadiologyGonderilebilir)
                {
                    <form method="post" asp-page-handler="TumunuGonderRadiology" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm" onclick="event.stopPropagation(); return confirm('Henüz gönderilmemiş/hatalı tüm radyoloji raporları TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                            @(radSatir.Giden == 0 ? "Gönder" : "Eksikleri Gönder")
                        </button>
                    </form>
                }
                @if (Model.RadiologyReports.Count > 0)
                {
                    <details class="rt-menu" onclick="event.stopPropagation()">
                        <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Radyoloji için diğer işlemler">&#8943;</summary>
                        <div class="rt-menu-pop">
                            @if (Model.RadiologySilinebilir)
                            {
                                <form method="post" asp-page-handler="TumunuSilRadiology" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                    <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                            onclick="return confirm('Gönderilmiş TÜM radyoloji kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">Tümünü TRƏS'ten sil</button>
                                </form>
                            }
                            else
                            {
                                <span class="rt-menu-bos">Silinecek kayıt yok</span>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        @{
            var patSatir = Model.PatSatiri();
        }
        <div class="checklist-item checklist-item--tab" data-tab="pathology" onclick="pusulaShowTab('pathology')">
            <span class="rt-stripe rt-stripe--@patSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Patoloji <span class="rt-fhir">DiagnosticReport</span> <span class="tab-chevron">&#9656;</span></span>
                <span class="rt-desc">
                    @if (Model.PathologyReports.Count == 0)
                    {
                        <text>Onaylanmış patoloji raporu bulunamadı.</text>
                    }
                    else
                    {
                        <text>@Model.PathologyReports.Count rapor — listesi için tıklayın.</text>
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @patSatir.CssClass"><span class="badge-dot"></span>@patSatir.Etiket</span>
                @if (Model.PathologyGonderilebilir)
                {
                    <form method="post" asp-page-handler="TumunuGonderPathology" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm" onclick="event.stopPropagation(); return confirm('Henüz gönderilmemiş/hatalı tüm patoloji raporları TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                            @(patSatir.Giden == 0 ? "Gönder" : "Eksikleri Gönder")
                        </button>
                    </form>
                }
                @if (Model.PathologyReports.Count > 0)
                {
                    <details class="rt-menu" onclick="event.stopPropagation()">
                        <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Patoloji için diğer işlemler">&#8943;</summary>
                        <div class="rt-menu-pop">
                            @if (Model.PathologySilinebilir)
                            {
                                <form method="post" asp-page-handler="TumunuSilPathology" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                    <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                            onclick="return confirm('Gönderilmiş TÜM patoloji kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">Tümünü TRƏS'ten sil</button>
                                </form>
                            }
                            else
                            {
                                <span class="rt-menu-bos">Silinecek kayıt yok</span>
                            }
                        </div>
                    </details>
                }
            </div>
        </div>

        @{
            var epikrizSatir = Model.EpikrizSatiri();
        }
        <div class="checklist-item checklist-item--tab" data-tab="epikriz" onclick="pusulaShowTab('epikriz')">
            <span class="rt-stripe rt-stripe--@epikrizSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Epikriz <span class="rt-fhir">Composition</span> <span class="tab-chevron">&#9656;</span></span>
                <span class="rt-desc">
                    @if (isRecete)
                    {
                        <text>Protokol tipi Reçete — bu tür protokoller TRƏS'e gönderilmez.</text>
                    }
                    else if (!Model.EpikrizSendEnabled)
                    {
                        <text>Epikriz gönderimi Ayarlar sayfasından kapatılmış.</text>
                    }
                    else if (Model.EpikrizBolumleri.Count == 0)
                    {
                        <text>Pusula'da epikriz metni girilmemiş.</text>
                    }
                    else
                    {
                        <text>@Model.EpikrizBolumleri.Count bölüm — önizleme için tıklayın.</text>
                        @if (!Model.GenelMuayene!.IsLocked)
                        {
                            <text> Pusula'da henüz kilitlenmemiş.</text>
                        }
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @epikrizSatir.CssClass"><span class="badge-dot"></span>@epikrizSatir.Etiket</span>
                @if (!isRecete && Model.EpikrizSendEnabled && Model.EpikrizBolumleri.Count > 0
                     && !PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(Model.EpikrizDurumKaydi))
                {
                    <form method="post" asp-page-handler="GonderEpikriz" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm"
                                onclick="event.stopPropagation(); return confirm('Epikriz TRƏS\'e CANLI olarak (kalıcı) gönderilecek. Emin misiniz?')">
                            @(Model.EpikrizDurumKaydi is null ? "Gönder" : "Tekrar Dene")
                        </button>
                    </form>
                }
                <details class="rt-menu" onclick="event.stopPropagation()">
                    <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Epikriz için diğer işlemler">&#8943;</summary>
                    <div class="rt-menu-pop">
                        @if (Model.EpikrizDurumKaydi is not null)
                        {
                            <a asp-page="/Detail" asp-route-id="@Model.EpikrizDurumKaydi.Id" asp-route-fromProtokol="@p.ProtokolId" class="rt-menu-item">Kayıt detayı</a>
                        }
                        @if (!isRecete && Model.EpikrizBolumleri.Count > 0
                             && PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(Model.EpikrizDurumKaydi))
                        {
                            <form method="post" asp-page-handler="GonderEpikriz" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item" onclick="return confirm('Epikriz TRƏS\'e yeniden gönderilecek. Emin misiniz?')">Tekrar gönder</button>
                            </form>
                        }
                        @if (SyncLogEntry.CanDelete(Model.EpikrizDurumKaydi))
                        {
                            <form method="post" asp-page-handler="SilEpikriz" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="rt-menu-item rt-menu-item--danger"
                                        onclick="return confirm('Epikriz kaydı TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">TRƏS'ten sil</button>
                            </form>
                        }
                        @if (Model.EpikrizDurumKaydi is null)
                        {
                            <span class="rt-menu-bos">Henüz kayıt yok</span>
                        }
                    </div>
                </details>
            </div>
        </div>

        @{
            var vitalSatir = Model.VitalSatiri();
        }
        <div class="checklist-item">
            <span class="rt-stripe rt-stripe--@vitalSatir.CssClass"></span>
            <div class="rt-info">
                <span class="rt-name">Vital Bulgular <span class="rt-fhir">Observation</span></span>
                <span class="rt-desc">
                    @if (isRecete)
                    {
                        <text>Protokol tipi Reçete — bu tür protokoller TRƏS'e gönderilmez.</text>
                    }
                    else if (Model.Vitaller.Count == 0)
                    {
                        <text>Epikrizin Bulgular alanında ölçüm bulunamadı.</text>
                    }
                    else
                    {
                        <text>@string.Join(" · ", Model.Vitaller.Select(v => VitalSignsMapper.Ozet(v.Tur, v.Deger)))</text>
                    }
                </span>
            </div>
            <div class="rt-right">
                <span class="badge @vitalSatir.CssClass"><span class="badge-dot"></span>@vitalSatir.Etiket</span>
                @if (!isRecete && Model.Vitaller.Count > 0
                     && !PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(Model.VitalDurumKaydi))
                {
                    <form method="post" asp-page-handler="GonderVital" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                        <button type="submit" class="btn btn-primary btn-sm"
                                onclick="return confirm('Vital bulgular TRƏS\'e CANLI olarak (kalıcı) gönderilecek. Emin misiniz?')">
                            @(Model.VitalDurumKaydi is null ? "Gönder" : "Tekrar Dene")
                        </button>
                    </form>
                }
                @if (Model.VitalDurumKaydi is not null)
                {
                    <details class="rt-menu">
                        <summary class="rt-menu-btn" title="Diğer işlemler" aria-label="Vital bulgular için diğer işlemler">&#8943;</summary>
                        <div class="rt-menu-pop">
                            <a asp-page="/Detail" asp-route-id="@Model.VitalDurumKaydi.Id" asp-route-fromProtokol="@p.ProtokolId" class="rt-menu-item">Kayıt detayı</a>
                        </div>
                    </details>
                }
            </div>
        </div>
    </div>

    <!-- KULLANICI ISTEGI (2026-08-31): "bir alan daha açalım listeleme alanı ... üst taraftaki
         başlıklar tıklanılabilir olsun ... alt taraftaki alanda bu bilgiler gösterilsin".
         Aynı anda TEK panel görünür (pusulaShowTab) -- sayfa yüksekliği artık kaç kayıt olursa
         olsun sabit kalıyor, tüm listeler burada birikip sayfayı uzatmıyor. Hangi panelin açık
         olduğu sessionStorage'da tutuluyor (protokol id'sine göre) -- Gönder/Sil sonrası sayfa
         yenilendiğinde (RedirectToPage) kullanıcı kaldığı yerde kalsın diye. -->
    <div class="tab-detail-anchor" id="tab-detail-anchor">
        <p id="tab-detail-empty" class="tab-detail-empty">Yukarıdan <b style="color:var(--text-muted);">Müayinə</b>, <b style="color:var(--text-muted);">Laboratuvar</b>, <b style="color:var(--text-muted);">Radyoloji</b>, <b style="color:var(--text-muted);">Patoloji</b> veya <b style="color:var(--text-muted);">Epikriz</b> satırına tıklayın, gönderilecek içerik burada açılsın. Ne yapmanız gerektiğini görmek için yukarıdaki <b style="color:var(--text-muted);">Yapılacaklar</b> düğmesine basın.</p>


        @{
            var (muayineOzetClass, muayineOzetLabel, muayineOzetS, muayineOzetT) = Model.MuayineIcerikOzet();
            var (taniOzetClass, taniOzetLabel, taniOzetS, taniOzetT) = Model.TanilarOzet();
            var (islemOzetClass, islemOzetLabel, islemOzetS, islemOzetT) = Model.IslemlerOzet();

            // KULLANICI ISTEGI (2026-08-31): "muayene ve tanı alanı başlıkları aynı renk
            // şerit halinde böyle olmasın, detay ekranında kullandığımız simge ve başlık
            // gibi ortada gözüksün" -- Detail.cshtml'deki AYNI resource-chip/avatar/eyebrow
            // kalibi (kucuk versiyon) burada da kullaniliyor, boylece her basligin rengi
            // TEK bir sabit yesil serit yerine kendi kaynak turune gore ayirt ediliyor.
            void RenderResourceChip(string rtClass, string resourceType, string label)
            {
                <div class="resource-chip resource-chip--sm @rtClass">
                    <div class="resource-avatar @rtClass">
                        @switch (resourceType)
                        {
                            case "Encounter":
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><path d="m9 15 2 2 4-4" /></svg>
                                break;
                            default:
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /></svg>
                                break;
                        }
                    </div>
                    <span class="resource-eyebrow @rtClass" style="margin:0;">@label</span>
                </div>
            }
        }
        <div class="side-card tab-panel-content" id="tab-panel-muayine">
            <div class="side-card-head side-card-head--chip">
                <span></span>
                @{ RenderResourceChip("rt-encounter", "Encounter", "Müayinə → Tanı & İşlem"); }
                <div class="side-card-actions">
                    @if (muayineOzetT > 0)
                    {
                        <span class="badge @muayineOzetClass" style="padding:3px 9px; font-size:11px;">@muayineOzetS/@muayineOzetT @muayineOzetLabel</span>
                    }
                </div>
            </div>
            <div class="side-card-section">
                <div class="side-card-head">
                    <span class="rt-name">
                        Tanı (Condition) <span class="count">@Model.Tanilar.Count</span>
                        @if (taniOzetT > 0)
                        {
                            <span class="badge @taniOzetClass" style="padding:3px 9px; font-size:11px;">@taniOzetS/@taniOzetT @taniOzetLabel</span>
                        }
                    </span>
                    <div class="side-card-actions">
                        @if (Model.TanilarGonderilebilir)
                        {
                            <form method="post" asp-page-handler="TumunuGonderTani" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-bulk btn-sm"
                                        onclick="return confirm('Henüz gönderilmemiş/hatalı tüm tanılar TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                                    Tümünü Gönder
                                </button>
                            </form>
                        }
                        @if (Model.TanilarSilinebilir)
                        {
                            <form method="post" asp-page-handler="TumunuSilTani" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-outline btn-sm" style="border-color:var(--danger); color:var(--danger);"
                                        onclick="return confirm('Gönderilmiş TÜM tanı kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">
                                    Tümünü Sil
                                </button>
                            </form>
                        }
                    </div>
                </div>
                @if (Model.Tanilar.Count == 0)
                {
                    <div class="side-card-empty">Bu protokol için ICD-10 tanısı bulunamadı.</div>
                }
                else
                {
                    @foreach (var (tani, durum) in Model.Tanilar)
                    {
                        var (taniBadgeClass, taniBadgeLabel) = SyncLogEntry.StatusBadge(durum);
                        <div class="side-row">
                            <div class="side-row-main">
                                <span class="side-row-code">@tani.Kodu</span>
                                <span class="side-row-name">@(tani.Adi ?? "-")</span>
                            </div>
                            <div class="side-row-actions">
                                <span class="badge @taniBadgeClass" style="padding:3px 9px; font-size:11px;"><span class="badge-dot"></span>@taniBadgeLabel</span>
                                @if (durum is not null)
                                {
                                    <a asp-page="/Detail" asp-route-id="@durum.Id" asp-route-fromProtokol="@p.ProtokolId" class="icon-btn-detay" title="Detay">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                    </a>
                                }
                                @if (!PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(durum))
                                {
                                    <form method="post" asp-page-handler="GonderTani" asp-route-id="@p.ProtokolId" asp-route-taniId="@tani.Id" onsubmit="pusulaLockSubmit(this)">
                                        <button type="submit" class="icon-btn-gonder" title="@(durum is null ? "Gönder" : "Tekrar Gönder")"
                                                onclick="return confirm('Bu tanı TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
                                        </button>
                                    </form>
                                }
                                @if (SyncLogEntry.CanDelete(durum))
                                {
                                    <form method="post" asp-page-handler="SilTani" asp-route-id="@p.ProtokolId" asp-route-durumId="@durum!.Id" onsubmit="pusulaLockSubmit(this)">
                                        <button type="submit" class="icon-btn-sil" title="Sil"
                                                onclick="return confirm('Bu tanı kaydı TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="side-card-section">
                <div class="side-card-head">
                    <span class="rt-name">
                        İşlem (Procedure) <span class="count">@Model.Islemler.Count</span>
                        @if (islemOzetT > 0)
                        {
                            <span class="badge @islemOzetClass" style="padding:3px 9px; font-size:11px;">@islemOzetS/@islemOzetT @islemOzetLabel</span>
                        }
                    </span>
                    <div class="side-card-actions">
                        @if (Model.IslemlerGonderilebilir)
                        {
                            <form method="post" asp-page-handler="TumunuGonderIslem" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-bulk btn-sm"
                                        onclick="return confirm('Henüz gönderilmemiş/hatalı tüm işlemler TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                                    Tümünü Gönder
                                </button>
                            </form>
                        }
                        @if (Model.IslemlerSilinebilir)
                        {
                            <form method="post" asp-page-handler="TumunuSilIslem" asp-route-id="@p.ProtokolId" onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-outline btn-sm" style="border-color:var(--danger); color:var(--danger);"
                                        onclick="return confirm('Gönderilmiş TÜM işlem kayıtları TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">
                                    Tümünü Sil
                                </button>
                            </form>
                        }
                    </div>
                </div>
                @if (Model.Islemler.Count == 0)
                {
                    <div class="side-card-empty">Bu protokol için İCBARI SİGORTA FİYAT LİSTESİ ile eşleşen hizmet bulunamadı.</div>
                }
                else
                {
                    <div class="list-header">
                        <button type="button" class="sort-btn" onclick="pusulaSortRows('islem-rows', 'islemSortArrow')">
                            Tarih <span class="arrow" id="islemSortArrow">↓</span>
                        </button>
                    </div>
                    <div id="islem-rows">
                    @foreach (var (islem, durum) in Model.Islemler)
                    {
                        var (islemBadgeClass, islemBadgeLabel) = SyncLogEntry.StatusBadge(durum);
                        <div class="side-row" data-sort-date="@(islem.IslemTarihi?.ToString("yyyy-MM-ddTHH:mm:ss"))">
                            <span class="date-col" title="@(islem.IslemTarihi?.ToString("dd.MM.yyyy HH:mm"))">@(islem.IslemTarihi?.ToString("dd.MM.yyyy") ?? "-")</span>
                            <div class="side-row-main">
                                <span class="side-row-name">@(islem.HizmetAdi ?? "-")</span>
                            </div>
                            <div class="side-row-actions">
                                <span class="badge @islemBadgeClass" style="padding:3px 9px; font-size:11px;"><span class="badge-dot"></span>@islemBadgeLabel</span>
                                @if (durum is not null)
                                {
                                    <a asp-page="/Detail" asp-route-id="@durum.Id" asp-route-fromProtokol="@p.ProtokolId" class="icon-btn-detay" title="Detay">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                    </a>
                                }
                                @if (!PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(durum))
                                {
                                    <form method="post" asp-page-handler="GonderIslem" asp-route-id="@p.ProtokolId" asp-route-islemId="@islem.Id" onsubmit="pusulaLockSubmit(this)">
                                        <button type="submit" class="icon-btn-gonder" title="@(durum is null ? "Gönder" : "Tekrar Gönder")"
                                                onclick="return confirm('Bu işlem TRƏS\'e CANLI olarak gönderilecek. Emin misiniz?')">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
                                        </button>
                                    </form>
                                }
                                @if (SyncLogEntry.CanDelete(durum))
                                {
                                    <form method="post" asp-page-handler="SilIslem" asp-route-id="@p.ProtokolId" asp-route-durumId="@durum!.Id" onsubmit="pusulaLockSubmit(this)">
                                        <button type="submit" class="icon-btn-sil" title="Sil"
                                                onclick="return confirm('Bu işlem kaydı TRƏS\'ten KALICI olarak SİLİNECEK. Emin misiniz?')">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>

        @{
            @* Bir tetkik grubunun ALT satiri. KULLANICI SORUSU (2026-09-30): grup "Gönderildi"
               derken alt satirlar "Gönderilmedi" diyor ve yanlarinda Gönder butonu var --
               basilinca grup yeniden gidiyor ama satir asla degismiyordu. Sebep: buraya durum
               olarak HER ZAMAN null geciliyordu.

               Alt parametrenin ayri bir TRƏS kaydi YOK (bakanlik istegi 2026-09-16: panel
               tek Observation, alt parametreler component[] icinde). Bu yuzden satirda artik
               ne Gönder ne Sil ne Detay var -- bunlar grup basliginda, kaydin gercekten
               bulundugu yerde duruyor. Satirdaki rozet "bu satir tetkikle birlikte gitti mi"
               sorusunu cevapliyor (bkz. LabGrupGorunum.SatirDurumu). *@
            async Task RenderLabRow(PusulaEHealthSync.Db.LabResultRecord lab, PusulaEHealthSync.Web.Pages.ProtokolModel.LabGrupGorunum grup)
            {
                var isPanelHeader = lab.TetkikAdi == grup.Grup.PanelAdi;
                var (labBadgeClass, labBadgeLabel, labBadgeAciklama) = grup.SatirDurumu(lab);
                var labDate = lab.TetkikSonucOnayTarihi ?? lab.TetkikSonucTarihi;
                <div class="side-row @(isPanelHeader ? "lab-panel-header-row" : "")" data-sort-date="@(labDate?.ToString("yyyy-MM-ddTHH:mm:ss"))">
                    <span class="date-col" title="@(labDate?.ToString("dd.MM.yyyy HH:mm"))">@(labDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                    <div class="side-row-main">
                        <span class="side-row-name">@(lab.TetkikAdi ?? "-")</span>
                        <div style="color:var(--text-faint); font-size:11.5px; margin-top:2px;">
                            @(string.IsNullOrWhiteSpace(lab.TetkikSonucu) ? "-" : lab.TetkikSonucu) @lab.TetkikSonucuBirimi
                            @(string.IsNullOrWhiteSpace(lab.TetkikSonucuReferansDegeri) ? "" : $"(ref: {lab.TetkikSonucuReferansDegeri})")
                            @(string.IsNullOrWhiteSpace(lab.LoincKodu) ? " -- test kodu yok, gönderilemez" : "")
                        </div>
                    </div>
                    <div class="side-row-actions">
                        <span class="badge @labBadgeClass" style="padding:3px 9px; font-size:11px;" title="@labBadgeAciklama"><span class="badge-dot"></span>@labBadgeLabel</span>
                    </div>
                </div>
            }
        }

        @{
            async Task RenderRadiologyRow(PusulaEHealthSync.Db.RadiologyReportRecord report, SyncLogEntry? durum, int protokolId)
            {
                var (radBadgeClass, radBadgeLabel) = SyncLogEntry.StatusBadge(durum);
                var radDate = report.OnaylanmaTarihi ?? report.CalismaTarihi;
                <div class="side-row" data-sort-date="@(radDate?.ToString("yyyy-MM-ddTHH:mm:ss"))">
                    <span class="date-col" title="@(radDate?.ToString("dd.MM.yyyy HH:mm"))">@(radDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                    <div class="side-row-main">
                        <span class="side-row-name">@(report.HizmetAdi ?? "-")</span>
                        <div style="color:var(--text-faint); font-size:11.5px; margin-top:2px;">
                            @{ var raporDuzMetin = PusulaEHealthSync.Mapping.RtfText.ToPlainText(report.Rapor); }
                            @(string.IsNullOrWhiteSpace(raporDuzMetin) ? "Rapor metni boş -- gönderilemez" : (raporDuzMetin.Length > 160 ? raporDuzMetin[..160] + "…" : raporDuzMetin))
                        </div>
                    </div>
                    <div class="side-row-actions">
                        <span class="badge @radBadgeClass" style="padding:3px 9px; font-size:11px;"><span class="badge-dot"></span>@radBadgeLabel</span>
                        @if (durum is not null)
                        {
                            <a asp-page="/Detail" asp-route-id="@durum.Id" asp-route-fromProtokol="@protokolId" class="icon-btn-detay" title="Detay">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                            </a>
                        }
                        @if (!PusulaEHealthSync.Web.Pages.ProtokolModel.BasariylaGonderildi(durum))
                        {

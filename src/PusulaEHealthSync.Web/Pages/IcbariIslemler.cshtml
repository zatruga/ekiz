@page
@model PusulaEHealthSync.Web.Pages.IcbariIslemlerModel
@using PusulaEHealthSync.Reporting
@using PusulaEHealthSync.Web.Pages
@{
    ViewData["Title"] = "İcbari İşlemler";
    ViewData["Genis"] = true;
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var fromIso = Model.EffectiveFrom.ToString("yyyy-MM-dd");
    var toIso = Model.EffectiveTo.ToString("yyyy-MM-dd");
    var o = Model.Ozet;
    string pYuzde(int n) => "%" + o.ProtokolYuzde(n).ToString("0.0");
    var ortamAdi = Model.AktifOrtam == "Live" ? "Canlı" : "Sandbox (Test)";
}

<header class="yh-bas">
    <div>
        <p class="breadcrumb" style="margin:0 0 4px;"><a asp-page="/GenelBakis">Genel Bakış</a> / İcbari İşlemler</p>
        <h1 class="page-title" style="margin:0;">İcbari İşlemler</h1>
        <p class="text-muted" style="margin:4px 0 0; font-size:13px;">
            Seçili kurumu İcbari Tibbi Sığorta olan protokoller ve canlı TRƏS durumları &middot;
            tarih aralığı protokolün Pusula'daki açılış tarihi &middot; gönderim ortamı <strong>@ortamAdi</strong>
        </p>
    </div>
    <form method="get" class="akis-filtre">
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Sebep" value="@Model.Sebep" />
        <input type="hidden" name="Hizmet" value="@Model.Hizmet" />
        <div class="akis-filtre-tarih">
            <label for="from">Açılış</label>
            <input type="date" id="from" name="From" value="@fromIso" onchange="this.form.submit()" />
            <span aria-hidden="true">→</span>
            <label for="to" class="sr-only">Bitiş</label>
            <input type="date" id="to" name="To" value="@toIso" onchange="this.form.submit()" />
        </div>
        <label for="q" class="sr-only">Ara</label>
        <input type="search" id="q" name="Q" value="@Model.Q" placeholder="Protokol, hasta veya hizmet" class="akis-filtre-ara" />
        <button type="submit" class="btn btn-outline btn-sm">Ara</button>
    </form>
</header>

@if (!string.IsNullOrWhiteSpace(Model.IslemMesaji))
{
    <div class="alert @(Model.IslemBasarili ? "alert-success" : "alert-danger")">@Model.IslemMesaji</div>
}
@if (Model.PusulaHatasi)
{
    <div class="alert alert-danger"><strong>Liste okunamadı.</strong> Pusula'ya erişilemedi; sayfayı yenileyip tekrar deneyin.</div>
}
@if (Model.AktifOrtam != "Live")
{
    @* Durumlar CANLI ortama gore; gonderim ise aktif ortama gidiyor. Ikisi farkliysa
       "Gonder"e basan kisi durumun degismedigini gorur -- sessiz kalmamali. *@
    <div class="alert alert-warning">
        Durumlar <strong>canlı</strong> gönderimlere göre gösteriliyor, ama gönderim şu an <strong>@ortamAdi</strong> ortamına yapılıyor.
        Buradan gönderilenler bu listedeki durumu değiştirmez.
    </div>
}

<section class="yh-kartlar" aria-label="Özet">
    <div class="yh-kart-grup">
        <span class="yh-grup-ad">@o.Toplam.Protokol.ToString("N0", tr) icbari protokol · @o.Toplam.Islem.ToString("N0", tr) işlem</span>
        @foreach (var (anahtar, ad, sayi, ton) in new[]
        {
            ((string?)null, "Tümü", o.Toplam, "neutral"),
            ("gitti", "Tamamı gönderildi", o.Gitti, "success"),
            ("gitmedi", "Tamamı gitmeyen", o.Gitmedi, "danger"),
            ("denenmedi", "Henüz denenmedi", o.Denenmedi, "neutral"),
            ("eksik", "Eksik verili", o.Eksik, "warning"),
            ("hatali", "Hatalı", o.Hatali, "danger"),
        })
        {
            <a asp-page="/IcbariIslemler" asp-route-Durum="@anahtar" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q"
               class="yh-kart yh-kart--@ton @((Model.Durum ?? "") == (anahtar ?? "") && string.IsNullOrEmpty(Model.Sebep) && string.IsNullOrEmpty(Model.Hizmet) ? "active" : "")">
                <span class="yh-kart-ad">@ad</span>
                <span class="yh-kart-sayi">@sayi.Protokol.ToString("N0", tr)</span>
                <span class="yh-kart-ad">@(anahtar is null ? "" : pYuzde(sayi.Protokol) + " · ")@sayi.Islem.ToString("N0", tr) işlem</span>
            </a>
        }
    </div>
</section>

@if (!string.IsNullOrEmpty(Model.Sebep) || !string.IsNullOrEmpty(Model.Hizmet))
{
    <div class="filter-chip-bar">
        @if (!string.IsNullOrEmpty(Model.Sebep))
        {
            <span class="filter-chip">Sebep: <strong>@Model.Sebep</strong>
                <a asp-page="/IcbariIslemler" asp-route-Durum="@Model.Durum" asp-route-Hizmet="@Model.Hizmet" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q" class="filter-chip-x" title="Sebep filtresini kaldır">&times;</a></span>
        }
        @if (!string.IsNullOrEmpty(Model.Hizmet))
        {
            <span class="filter-chip">Hizmet: <strong>@Model.Hizmet</strong>
                <a asp-page="/IcbariIslemler" asp-route-Durum="@Model.Durum" asp-route-Sebep="@Model.Sebep" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q" class="filter-chip-x" title="Hizmet filtresini kaldır">&times;</a></span>
        }
    </div>
}

<section class="card" style="padding:0;">
    <form id="ic-toplu" method="post" asp-page-handler="TopluGonder"
          asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="@Model.Durum" asp-route-Sebep="@Model.Sebep"
          asp-route-Hizmet="@Model.Hizmet" asp-route-Q="@Model.Q" asp-route-P="@Model.PageNumber"></form>
    <div class="yh-arac">
        <span class="text-muted">@Model.ListelenenSayi.ToString("N0", tr) protokol · @Model.ListelenenIslem.ToString("N0", tr) işlem
            @if (Model.ListelenenSayi > 0) { <text>· @(((Model.PageNumber - 1) * 50 + 1))–@(Math.Min(Model.PageNumber * 50, Model.ListelenenSayi)) arası</text> }</span>
        <span style="flex:1"></span>
        <a asp-page-handler="Excel" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="@Model.Durum" asp-route-Sebep="@Model.Sebep"
           asp-route-Hizmet="@Model.Hizmet" asp-route-Q="@Model.Q" class="btn btn-outline btn-sm">Excel'e indir</a>
        <button type="submit" form="ic-toplu" class="btn btn-primary btn-sm"
                onclick="return icSecimVar() && confirm('Seçilen protokoller @ortamAdi ortamına GÖNDERİLECEK (en fazla 25). Emin misiniz?')">
            Seçilenleri gönder
        </button>
    </div>

    @if (Model.Satirlar.Count == 0)
    {
        <div class="empty-state"><p>Bu filtrede icbari protokol yok.</p></div>
    }
    else
    {
        @* SATIR = Aktivite Akisi satiri (kullanici 2026-10-26): kimlik, protokolun TUM
           gonderim zinciri, Detay/Gonder. Durum sutunu ve sebep satiri ICBARI sinifi --
           kartlardaki sayilarla ayni kaynak. Acilinca protokolun icbari islemleri. *@
        <div class="akis-sutunlar">
            <span><input type="checkbox" aria-label="Sayfadakilerin tümünü seç" onchange="document.querySelectorAll('.ic-sec').forEach(c => c.checked = this.checked)" /></span>
            <span>Hasta · protokol</span>
            <span>Gönderim zinciri</span>
            <span>Durum</span>
            <span class="akis-sag">İcbari işlem</span>
            <span></span>
        </div>
        @foreach (var s in Model.Satirlar)
        {
            var p = s.Icbari;
            var pr = s.P;
            var durumCss = IcbariIslemlerModel.AkisCss(p.Durum);
            var sebepler = p.Kalemler.Where(k => k.Durum != IcbariKapsamService.Durum.Gitti)
                .GroupBy(k => k.Sebep).OrderByDescending(g => g.Count()).Take(3).ToList();
            <details class="akis-satir akis-satir--@durumCss">
                <summary>
                    <span class="akis-satir-sec" onclick="event.stopPropagation()">
                        <input type="checkbox" class="ic-sec" name="protokolIds" value="@p.ProtokolId" form="ic-toplu" aria-label="Protokol @p.ProtokolId seç" />
                    </span>
                    <span class="akis-satir-kimlik">
                        <span class="akis-satir-ad">
                            <span class="akis-grup-ok" aria-hidden="true"></span>
                            @(string.IsNullOrWhiteSpace(s.Akis.HastaAdi) ? (string.IsNullOrWhiteSpace(p.Hasta) ? "—" : p.Hasta) : s.Akis.HastaAdi)
                            @if (!string.IsNullOrWhiteSpace(s.Akis.Fin)) { <span class="akis-satir-fin">@s.Akis.Fin</span> }
                        </span>
                        @if (pr is not null)
                        {
                            <span class="akis-satir-alt">@string.Join(" · ", new[] { pr.BolumAdi, pr.DoktorAdiSoyadi }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                        }
                        <span class="akis-satir-alt akis-mono">
                            protokol @p.ProtokolId.ToString(System.Globalization.CultureInfo.InvariantCulture)
                            @if (pr?.AcilisTarihi is { } ac) { <text> · @ac.ToString("dd.MM.yyyy")</text> }
                            @if (pr?.GelisTipiId is { } gt) { <text> · @(gt == "Y" ? "Yatan" : gt == "G" ? "Günübirlik" : "Ayaktan")</text> }
                        </span>
                    </span>
                    <span class="akis-zincir">
                        @foreach (var h in s.Akis.Zincir)
                        {
                            <span class="akis-halka akis-halka--@h.Css" title="@h.Aciklama">
                                <span class="akis-kare akis-kare--@h.Css" aria-hidden="true"></span>
                                @h.Ad
                                @if (h.Adet > 0)
                                {
                                    <span class="akis-halka-adet">@(h.Takilan > 0 ? $"{h.Takilan}/{h.Adet}" : h.Adet.ToString(tr))</span>
                                }
                            </span>
                        }
                    </span>
                    <span class="akis-satir-durum">
                        <span class="akis-kare akis-kare--@durumCss" aria-hidden="true"></span>
                        <span>
                            @(p.Durum == IcbariKapsamService.Durum.Gitti ? "Tamamı gönderildi" : IcbariIslemlerModel.DurumAdi(p.Durum))
                            @if (p.SonDenemeUtc is { } sd) { <span class="akis-satir-hic">son @AzTime.ToLocal(sd).ToString("dd.MM HH:mm", tr)</span> }
                        </span>
                    </span>
                    <span class="akis-satir-sayac akis-mono">
                        @if (p.IslemYok)
                        {
                            <text>—</text>
                            <span class="akis-satir-saat">icbari işlem yok</span>
                        }
                        else
                        {
                            <text>@p.Gitti/@p.Kalemler.Count</text>
                            <span class="akis-satir-saat">gönderildi</span>
                        }
                    </span>
                    <span class="akis-satir-eylem" onclick="event.stopPropagation()">
                        <a asp-page="/Protokol" asp-route-id="@p.ProtokolId" class="btn btn-outline btn-sm"
                           target="_blank" rel="noopener" title="Protokol detayını yeni sekmede aç">Detay</a>
                        <form method="post" asp-page-handler="Gonder" asp-route-protokolId="@p.ProtokolId"
                              asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="@Model.Durum" asp-route-Sebep="@Model.Sebep"
                              asp-route-Hizmet="@Model.Hizmet" asp-route-Q="@Model.Q" asp-route-P="@Model.PageNumber"
                              onsubmit="return confirm('Protokol @p.ProtokolId @ortamAdi ortamına gönderilecek. Emin misiniz?')">
                            <button type="submit" class="btn btn-primary btn-sm"
                                    title="Bu protokolün tüm zincirini gönder (müayinə, tanı, işlem, epikriz, laboratuvar, radyoloji, patoloji)">Gönder</button>
                        </form>
                    </span>
                    @if (sebepler.Count > 0 || p.ZincirTakili)
                    {
                        <span class="akis-satir-sebep">
                            @if (p.ZincirTakili)
                            {
                                <strong class="akis-renk--@IcbariIslemlerModel.AkisCss(p.Kalemler[0].Zincir!.Value)" title="@p.ZincirMesaj">@p.ZincirSebep</strong>
                                if (sebepler.Count > 0) { <text> · </text> }
                            }
                            @for (var i = 0; i < sebepler.Count; i++)
                            {
                                var g = sebepler[i];
                                var mesaj = g.Select(k => k.Mesaj).FirstOrDefault(m => !string.IsNullOrWhiteSpace(m));
                                if (i > 0) { <text> · </text> }
                                <strong class="akis-renk--@IcbariIslemlerModel.AkisCss(g.First().Durum)" title="@mesaj">@g.Key</strong>
                                if (!p.IslemYok && g.Count() > 1) { <text> (@g.Count() işlem)</text> }
                            }
                        </span>
                    }
                </summary>

                @* PROTOKOLUN TUM KAYITLARI VE DENEMELERI -- Aktivite Akisi'nin acilan tablosu
                   (kullanici 2026-10-26: "protokole ait tum islemlerin durumunu gostermeli, en
                   son gonderilen degil"). Hic denenmemis icbari islemler SyncLog'da yok; onlar
                   tablonun ustunde ayrica yaziyor. *@
                @{
                    var denenmemis = p.Kalemler.Where(k => k.KayitId is null && !k.Muayene).ToList();
                }
                @if (denenmemis.Count > 0)
                {
                    <div class="ic-denenmemis">
                        <strong>Henüz denenmemiş icbari işlem (@denenmemis.Count):</strong>
                        @string.Join(" · ", denenmemis.GroupBy(k => IcbariKapsamService.HizmetAdi(k.Islem)).Select(g => g.Count() > 1 ? $"{g.Key} ×{g.Count()}" : g.Key))
                        <span class="text-muted"> — @denenmemis[0].Sebep</span>
                    </div>
                }
                <div class="table-wrap akis-grup-tablo">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:104px;">Tarih / Saat</th>
                                <th style="width:150px;">Tür</th>
                                <th style="width:110px;">Pusula Id</th>
                                <th style="width:104px;" title="Kaydın Pusula'daki tarihi: sonuç onayı, işlem zamanı, muayene başlangıcı…">Pusula Tarihi</th>
                                <th style="width:26%;">Gönderim içeriği</th>
                                <th style="width:130px;">Durum</th>
                                <th style="width:80px;">İşlem</th>
                                <th>Mesaj</th>
                                <th style="width:72px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (s.Akis.Kayitlar.Count == 0)
                            {
                                <tr><td colspan="9" class="text-muted">Bu protokol için canlı ortamda henüz gönderim denemesi yok.</td></tr>
                            }
                            @foreach (var e in s.Akis.Kayitlar)
                            {
                                <tr>
                                    <td class="mono text-muted">
                                        @{ var zaman = AzTime.ToLocal(e.CreatedAtUtc); }
                                        @zaman.ToString("HH:mm:ss")
                                        <span class="akis-satir-tarih">@zaman.ToString("dd.MM.yyyy")</span>
                                    </td>
                                    <td><span class="badge @PusulaEHealthSync.Persistence.SyncLogEntry.ResourceTypeCssClass(e.ResourceType)">@PusulaEHealthSync.Persistence.SyncLogEntry.ResourceTypeLabel(e.ResourceType)</span></td>
                                    <td class="mono">@e.PusulaId.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                                    <td class="mono text-muted">
                                        @if (PusulaEHealthSync.Web.Pages.AktiviteModel.PusulaTarihi(e) is { } pt)
                                        {
                                            @pt.ToString("HH:mm:ss")
                                            <span class="akis-satir-tarih">@pt.ToString("dd.MM.yyyy")</span>
                                        }
                                        else { <span class="text-faint">—</span> }
                                    </td>
                                    <td>
                                        @if (e.ResourceType == "Encounter" && pr?.BolumAdi is { Length: > 0 } muayeneBolum)
                                        {
                                            <span>@muayeneBolum</span>
                                        }
                                        else if (e.ResourceType == "Patient")
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(e.PatientFullName) ? "—" : e.PatientFullName)</span>
                                            @if (!string.IsNullOrWhiteSpace(e.Fin)) { <span class="mono text-muted" style="margin-left:6px;">@e.Fin</span> }
                                        }
                                        else if (Model.Aciklamalar.TryGetValue((e.ResourceType, e.PusulaId), out var icerik))
                                        {
                                            @if (e.ResourceType == "Composition") { <span class="text-muted">Yazan:</span> }
                                            <span>@icerik</span>
                                        }
                                        else { <span class="text-faint">—</span> }
                                    </td>
                                    <td>
                                        @{ var (aBadgeClass, aBadgeLabel) = PusulaEHealthSync.Persistence.SyncLogEntry.StatusBadge(e); }
                                        <span class="badge @aBadgeClass"><span class="badge-dot"></span>@aBadgeLabel</span>
                                    </td>
                                    <td class="text-muted">@(e.Operation?.ToString() ?? "-")</td>
                                    <td class="cell-wide text-muted">
                                        @if (e.Status == PusulaEHealthSync.Persistence.SyncStatus.Failed && e.Message is not null)
                                        {
                                            <span title="@e.Message">@PusulaEHealthSync.Persistence.SyncLogEntry.FriendlyError(e.Message)</span>
                                        }
                                        else { @(e.Message ?? "-") }
                                    </td>
                                    <td>
                                        <a asp-page="/Detail" asp-route-id="@e.Id" asp-route-fromProtokol="@p.ProtokolId" class="btn btn-outline btn-sm">Detay</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
        <div class="yh-sayfa">
            @if (Model.PageNumber > 1)
            {
                <a class="btn btn-outline btn-sm" asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="@Model.Durum" asp-route-Sebep="@Model.Sebep" asp-route-Hizmet="@Model.Hizmet" asp-route-Q="@Model.Q" asp-route-P="@(Model.PageNumber - 1)">&larr; Önceki</a>
            }
            @if (Model.HasNextPage)
            {
                <a class="btn btn-outline btn-sm" asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="@Model.Durum" asp-route-Sebep="@Model.Sebep" asp-route-Hizmet="@Model.Hizmet" asp-route-Q="@Model.Q" asp-route-P="@(Model.PageNumber + 1)">Sonraki &rarr;</a>
            }
        </div>
    }
</section>

<script>
    function icSecimVar() {
        if (document.querySelectorAll('.ic-sec:checked').length > 0) return true;
        alert('Önce listeden protokol seçin.');
        return false;
    }
</script>

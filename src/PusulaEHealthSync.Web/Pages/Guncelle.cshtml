@page
@model PusulaEHealthSync.Web.Pages.GuncelleModel
@{
    ViewData["Title"] = "Sürüm Güncelle";
    var d = Model.Durum;
    var (badgeClass, badgeLabel) = d?.State switch
    {
        "InProgress" => ("warning", "İşleniyor"),
        "Success" => ("success", "Başarılı"),
        "Failed" => ("danger", "Hatalı"),
        _ => ("neutral", "Bekliyor"),
    };
    var k = Model.Kontrol;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Sürüm Güncelle</h1>
        <p class="page-subtitle">GitHub deposundaki en son sürümü çeker, derler ve sunucuya alır -- servisler sadece dosya kopyalama sırasında kısa süreliğine durur.</p>
    </div>
</div>

<div class="settings-grid">
    <div class="card card-pad settings-card span-2">
        <p class="section-title">Durum</p>
        <p class="card-desc">
            Güncelleme sırasında dashboard ve senkron servisi birkaç saniye kesintiye uğrar.
            İşlem öncesi mevcut sürüm otomatik olarak yedeklenir -- bir sorun çıkarsa
            <strong>"Son Yedeğe Geri Dön"</strong> ile geri alınabilir.
        </p>

        <div id="durum-panel" style="display:flex; flex-direction:column; gap:10px; margin:18px 0;">
            <div style="display:flex; align-items:center; gap:10px;">
                <span id="durum-badge" class="badge @badgeClass"><span class="badge-dot"></span><span id="durum-badge-text">@badgeLabel</span></span>
                <span id="durum-operasyon" class="text-muted">@(d?.Operation switch { "Guncelleme" => "Güncelleme", "GeriAlma" => "Geri Alma", _ => "" })</span>
            </div>
            <p id="durum-mesaj" class="card-desc" style="margin:0;">@(d?.Message ?? "Henüz bir güncelleme çalıştırılmadı.")</p>
            <p id="durum-zaman" class="text-muted" style="font-size:12.5px; margin:0;">
                @if (d?.FinishedAtUtc is not null)
                {
                    @:Son çalışma: @d.FinishedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") @(string.IsNullOrWhiteSpace(d.RequestedBy) ? "" : $"· {d.RequestedBy}")
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(d?.CommitHash))
            {
                <p id="durum-commit" class="text-muted" style="font-size:12.5px; margin:0; font-family:monospace;">
                    Sürüm: @d.CommitHash.Substring(0, Math.Min(7, d.CommitHash.Length)) — @d.CommitMessage
                </p>
            }
            else
            {
                <p id="durum-commit" class="text-muted" style="font-size:12.5px; margin:0; font-family:monospace; display:none;"></p>
            }
        </div>

        <div class="card-actions">
            <form id="form-ana-buton" method="post" asp-page-handler="@(k?.HasUpdate == true ? "Guncelle" : "KontrolEt")"
                  data-mode="@(k?.HasUpdate == true ? "guncelle" : "kontrol")" onsubmit="return pusulaAnaButonSubmit(this)">
                <button id="btn-guncelle" type="submit" class="btn btn-primary">@(k?.HasUpdate == true ? "Versiyon Güncelle" : "Güncelleme Kontrol Et")</button>
            </form>
            <form method="post" asp-page-handler="GeriAl" onsubmit="return pusulaBaslatGuncelleme(this, 'En son alınan yedeğe geri dönülecek, emin misiniz?')">
                <button id="btn-geri-al" type="submit" class="btn btn-outline" style="border-color:var(--danger); color:var(--danger);">Son Yedeğe Geri Dön</button>
            </form>
        </div>

        <div id="kontrol-panel" style="margin-top:18px; padding-top:16px; border-top:1px solid var(--border); display:@(k?.HasUpdate == true ? "block" : "none");">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                <span class="badge warning"><span class="badge-dot"></span>Yeni sürüm mevcut</span>
                <span class="text-muted" style="font-size:12.5px;">Güncelleyince gelecek değişiklikler:</span>
            </div>
            <ul id="kontrol-liste" style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:6px;">
                @if (k?.PendingCommits is not null)
                {
                    @foreach (var pc in k.PendingCommits)
                    {
                        <li style="font-size:13px; font-family:monospace;">
                            @(pc.Hash.Substring(0, Math.Min(7, pc.Hash.Length))) — @pc.Message
                        </li>
                    }
                }
            </ul>
        </div>
        <p id="kontrol-yok" class="text-muted" style="font-size:12px; margin:14px 0 0; padding-top:16px; border-top:1px solid var(--border); display:@(k?.HasUpdate == true ? "none" : "block");">
            @if (k?.CheckedAtUtc is not null)
            {
                @:GitHub kontrol edildi (@k.CheckedAtUtc.Value.ToLocalTime().ToString("HH:mm")) -- güncel sürüm çalışıyor.
            }
            else
            {
                @:GitHub sürüm kontrolü henüz yapılmadı.
            }
        </p>
    </div>

    <div class="card card-pad settings-card span-2">
        <p class="section-title">Güncelleme Geçmişi</p>
        <p class="card-desc">Sunucuya alınan her sürümün ne zaman ve ne içerdiği -- en yeni üstte.</p>

        <ul id="gecmis-liste" style="list-style:none; margin:14px 0 0; padding:0; display:flex; flex-direction:column; gap:0;">
            @if (Model.Gecmis.Count == 0)
            {
                <li id="gecmis-bos" class="text-muted" style="font-size:13px; padding:10px 0;">Henüz kayıtlı bir güncelleme geçmişi yok.</li>
            }
            else
            {
                @foreach (var h in Model.Gecmis)
                {
                    var (hBadgeClass, hBadgeLabel) = h.State switch
                    {
                        "Success" => ("success", "Başarılı"),
                        "Failed" => ("danger", "Hatalı"),
                        _ => ("neutral", h.State),
                    };
                    <li style="display:flex; align-items:baseline; gap:10px; padding:10px 0; border-top:1px solid var(--border);">
                        <span class="badge @hBadgeClass" style="flex-shrink:0;"><span class="badge-dot"></span>@hBadgeLabel</span>
                        <span class="text-muted" style="font-size:12px; flex-shrink:0; white-space:nowrap;">
                            @(h.FinishedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "")
                        </span>
                        <span style="font-size:13px;">
                            @(h.Operation switch { "Guncelleme" => "Güncelleme", "GeriAlma" => "Geri Alma", _ => h.Operation })
                            @if (!string.IsNullOrWhiteSpace(h.CommitMessage))
                            {
                                @:— @h.CommitMessage
                            }
                            else if (!string.IsNullOrWhiteSpace(h.Message))
                            {
                                @:— @h.Message
                            }
                        </span>
                    </li>
                }
            }
        </ul>
    </div>
</div>

@section Scripts {
    <script>
        function pusulaBaslatGuncelleme(form, confirmMessage) {
            if (!confirm(confirmMessage)) return false;
            pusulaLockSubmit(form);
            return true;
        }

        // Ana buton "kontrol" modundaysa (güncel sürüm/henüz kontrol edilmemiş) sadece bir
        // git fetch tetikler -- yıkıcı olmadığı için onay penceresi yok. "guncelle" modundaysa
        // (bkz. pusulaKontrolUygula) gerçek güncelleme akışı devreye girer, o zaman onay istenir.
        function pusulaAnaButonSubmit(form) {
            if (form.dataset.mode === 'guncelle') {
                if (!confirm('Bu işlem servisleri kısa süreliğine durdurup yeni sürümü yükleyecek. Devam edilsin mi?')) return false;
            }
            pusulaLockSubmit(form);
            return true;
        }

        function pusulaDurumUygula(data) {
            if (!data) return;
            var badgeMap = { Idle: ['neutral', 'Bekliyor'], InProgress: ['warning', 'İşleniyor'], Success: ['success', 'Başarılı'], Failed: ['danger', 'Hatalı'] };
            var map = badgeMap[data.state] || badgeMap.Idle;
            var badge = document.getElementById('durum-badge');
            badge.className = 'badge ' + map[0];
            document.getElementById('durum-badge-text').textContent = map[1];

            document.getElementById('durum-operasyon').textContent =
                data.operation === 'Guncelleme' ? 'Güncelleme' : (data.operation === 'GeriAlma' ? 'Geri Alma' : '');
            document.getElementById('durum-mesaj').textContent = data.message || 'Henüz bir güncelleme çalıştırılmadı.';

            if (data.finishedAtUtc) {
                var d = new Date(data.finishedAtUtc);
                var zamanText = 'Son çalışma: ' + d.toLocaleString('tr-TR');
                if (data.requestedBy) zamanText += ' · ' + data.requestedBy;
                document.getElementById('durum-zaman').textContent = zamanText;
            }

            var commitEl = document.getElementById('durum-commit');
            if (data.commitHash) {
                commitEl.textContent = 'Sürüm: ' + data.commitHash.substring(0, 7) + ' — ' + (data.commitMessage || '');
                commitEl.style.display = '';
            }

            var isBusy = data.state === 'InProgress';
            document.getElementById('btn-guncelle').disabled = isBusy;
            document.getElementById('btn-geri-al').disabled = isBusy;
        }

        (function pusulaPollDurum() {
            fetch(window.location.pathname + '?handler=Durum')
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(pusulaDurumUygula)
                .catch(function () { /* guncelleme sirasinda site kisa sure yanit vermeyebilir -- sessizce yeniden dene */ })
                .finally(function () { setTimeout(pusulaPollDurum, 2000); });
        })();

        function pusulaKontrolUygula(data) {
            if (!data) return;
            var panel = document.getElementById('kontrol-panel');
            var yok = document.getElementById('kontrol-yok');
            var liste = document.getElementById('kontrol-liste');
            var anaForm = document.getElementById('form-ana-buton');
            var anaBtn = document.getElementById('btn-guncelle');

            if (data.hasUpdate) {
                liste.textContent = '';
                (data.pendingCommits || []).forEach(function (pc) {
                    var li = document.createElement('li');
                    li.style.cssText = 'font-size:13px; font-family:monospace;';
                    li.textContent = pc.hash.substring(0, 7) + ' — ' + pc.message;
                    liste.appendChild(li);
                });
                panel.style.display = 'block';
                yok.style.display = 'none';
                anaForm.action = window.location.pathname + '?handler=Guncelle';
                anaForm.dataset.mode = 'guncelle';
                anaBtn.textContent = 'Versiyon Güncelle';
            } else {
                panel.style.display = 'none';
                yok.style.display = 'block';
                yok.textContent = data.checkedAtUtc
                    ? ('GitHub kontrol edildi (' + new Date(data.checkedAtUtc).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) + ') -- güncel sürüm çalışıyor.')
                    : 'GitHub sürüm kontrolü henüz yapılmadı.';
                anaForm.action = window.location.pathname + '?handler=KontrolEt';
                anaForm.dataset.mode = 'kontrol';
                anaBtn.textContent = 'Güncelleme Kontrol Et';
            }
        }

        // Updater artik arka planda OTOMATIK kontrol etmiyor (KULLANICI ISTEGI, 2026-08-27:
        // "1 dakikada bir versiyon güncellemeyi kontrol etmesin") -- kontrol sadece sayfa
        // acilirken (OnGet) ve "Güncelleme Kontrol Et" butonuyla tetikleniyor. Bu poll sadece
        // o tetiklemelerin sonucunu (Updater PollSeconds icinde islemis olmali) hizlica
        // ekrana yansitmak icin var, kendisi yeni bir kontrol BASLATMAZ.
        (function pusulaPollKontrol() {
            fetch(window.location.pathname + '?handler=Kontrol')
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(pusulaKontrolUygula)
                .catch(function () { /* sessizce yeniden dene */ })
                .finally(function () { setTimeout(pusulaPollKontrol, 5000); });
        })();

        var pusulaGecmisSayisi = @Model.Gecmis.Count;
        var pusulaBadgeMetin = { Success: 'Başarılı', Failed: 'Hatalı' };
        var pusulaOperasyonMetin = { Guncelleme: 'Güncelleme', GeriAlma: 'Geri Alma' };

        function pusulaGecmisUygula(data) {
            if (!data || data.length === pusulaGecmisSayisi) return; // degisiklik yoksa DOM'a dokunma
            pusulaGecmisSayisi = data.length;

            var liste = document.getElementById('gecmis-liste');
            liste.textContent = '';

            if (data.length === 0) {
                var bos = document.createElement('li');
                bos.id = 'gecmis-bos';
                bos.className = 'text-muted';
                bos.style.cssText = 'font-size:13px; padding:10px 0;';
                bos.textContent = 'Henüz kayıtlı bir güncelleme geçmişi yok.';
                liste.appendChild(bos);
                return;
            }

            data.forEach(function (h) {
                var li = document.createElement('li');
                li.style.cssText = 'display:flex; align-items:baseline; gap:10px; padding:10px 0; border-top:1px solid var(--border);';

                var badge = document.createElement('span');
                badge.className = 'badge ' + (h.state === 'Success' ? 'success' : h.state === 'Failed' ? 'danger' : 'neutral');
                badge.style.flexShrink = '0';
                var dot = document.createElement('span');
                dot.className = 'badge-dot';
                badge.appendChild(dot);
                badge.appendChild(document.createTextNode(pusulaBadgeMetin[h.state] || h.state));
                li.appendChild(badge);

                var zaman = document.createElement('span');
                zaman.className = 'text-muted';
                zaman.style.cssText = 'font-size:12px; flex-shrink:0; white-space:nowrap;';
                zaman.textContent = h.finishedAtUtc ? new Date(h.finishedAtUtc).toLocaleString('tr-TR') : '';
                li.appendChild(zaman);

                var aciklama = document.createElement('span');
                aciklama.style.fontSize = '13px';
                var op = pusulaOperasyonMetin[h.operation] || h.operation || '';
                var detay = h.commitMessage || h.message || '';
                aciklama.textContent = detay ? (op + ' — ' + detay) : op;
                li.appendChild(aciklama);

                liste.appendChild(li);
            });
        }

        (function pusulaPollGecmis() {
            fetch(window.location.pathname + '?handler=Gecmis')
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(pusulaGecmisUygula)
                .catch(function () { /* sessizce yeniden dene */ })
                .finally(function () { setTimeout(pusulaPollGecmis, 5000); });
        })();
    </script>
}

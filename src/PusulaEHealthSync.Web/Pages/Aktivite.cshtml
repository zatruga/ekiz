@page
@model PusulaEHealthSync.Web.Pages.AktiviteModel
@using PusulaEHealthSync.Persistence
@{
    ViewData["Title"] = "Aktivite Akışı";
    ViewData["Genis"] = true;   // zincir rozetleri + islemler -- genislik sinirindan muaf
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var fromIso = Model.EffectiveFrom.ToString("yyyy-MM-dd");
    var toIso = Model.EffectiveTo.ToString("yyyy-MM-dd");
    var hicbiri = PusulaEHealthSync.Web.Pages.AktiviteModel.HicbiriAnahtari;
}

@* ==== ONAYLANAN TASARIM: "D · PROTOKOL LISTESI ODAKLI (BIRLESIK)" (2026-10-21) ====
   Kullanici dort yon arasindan bunu secti ("evet bunu sevdim"). Yukaridan asagi:
     1. canli gonderim seridi   -- su an ne oluyor (kendini tazeliyor)
     2. baslik + filtreler      -- tarih, arama, kayit turu
     3. donem ozeti             -- kutular TIKLANABILIR SUZGEC
     4. protokol listesi        -- sayfanin asil isi; her satirda gonderim zinciri

   ESKI EKRANIN SORUNU: adi "akis" ama zaman ekseni yoktu ve bes kart esit agirlikta
   duruyordu -- oysa "Hic gonderilemeyen" digerlerinin ALT KUMESI. Kullanici "sanki bir
   seyler olmadi" dedi. Yeni ekranda ozet tek satirlik bir suzgec, agirlik listede.

   RENKLER OLCULDU (dataviz dogrulayicisi, alti denetim de gecti; bkz. site.css
   --akis-ok/--akis-eksik/--akis-hata). Renk hicbir yerde TEK BASINA anlam tasimiyor:
   her rozetin adi ve sayisi yazili, durumun etiketi yazili. *@

<partial name="_AktiviteSerit" model="Model.Serit" />

<header class="akis-bas">
    <div>
        <p class="breadcrumb" style="margin:0 0 4px;"><a asp-page="/Index">Protokol Listesi</a> / Aktivite Akışı</p>
        <h1 class="page-title" style="margin:0;">Aktivite Akışı</h1>
    </div>

    <form method="get" class="akis-filtre">
        <input type="hidden" name="Status" value="@Model.Status" />
        <input type="hidden" name="Kategori" value="@Model.Kategori" />
        <input type="hidden" name="Sira" value="@Model.Sira" />
        @* ORTAM SECICI -- secilen ortamin kayitlari listelenir. Varsayilan gonderimin su an
           yapildigi ortam; "•" o ortami isaretliyor. *@
        <div class="segmented akis-ortam" role="radiogroup" aria-label="Gösterilen ortam">
            <input type="radio" id="ortamLive" name="Ortam" value="Live" checked="@(Model.Ortam == "Live")" onchange="this.form.submit()" />
            <label for="ortamLive">Canlı@(Model.AktifOrtam == "Live" ? " •" : "")</label>
            <input type="radio" id="ortamTest" name="Ortam" value="Test" checked="@(Model.Ortam == "Test")" onchange="this.form.submit()" />
            <label for="ortamTest">Sandbox (Test)@(Model.AktifOrtam == "Test" ? " •" : "")</label>
        </div>
        <div class="akis-filtre-tarih">
            <label for="from">Başlangıç</label>
            <input type="date" id="from" name="From" value="@fromIso" onchange="this.form.submit()" />
            <span aria-hidden="true">→</span>
            <label for="to">Bitiş</label>
            <input type="date" id="to" name="To" value="@toIso" onchange="this.form.submit()" />
        </div>
        <label for="q" class="sr-only">Ara</label>
        <input type="search" id="q" name="Q" value="@Model.Q" placeholder="Hasta adı, FIN veya protokol no" class="akis-filtre-ara" />
        <label for="tur" class="sr-only">Kayıt türü</label>
        <select id="tur" name="ResourceType" onchange="this.form.submit()">
            <option value="">Tüm kayıt türleri</option>
            @foreach (var t in new[] { "Patient", "Encounter", "Practitioner", "Composition", "Condition", "Procedure", "Observation", "Observation-Vital", "DiagnosticReport", "DiagnosticReport-Patoloji", "Composition-Patoloji", "Observation-Patoloji" })
            {
                <option value="@t" selected="@(Model.ResourceType == t)">@SyncLogEntry.ResourceTypeLabel(t)</option>
            }
        </select>
        <button type="submit" class="btn btn-outline btn-sm">Ara</button>
    </form>
</header>

@if (Model.Ortam != Model.AktifOrtam)
{
    @* Gecmis bir ortama bakilirken "Gönder" dugmeleri o ortama DEGIL, su anki ortama
       gonderir -- sessiz kalirsa kullanici sandbox satirini sandbox'a yolladigini sanar. *@
    <div class="alert alert-warning">
        <strong>@(Model.Ortam == "Live" ? "Canlı" : "Sandbox (Test)") ortamının kayıtlarına bakıyorsunuz.</strong>
        Gönderim şu an <strong>@(Model.AktifOrtam == "Live" ? "Canlı" : "Sandbox (Test)")</strong> ortamına yapılıyor;
        bu sayfadaki "Gönder" düğmeleri de oraya gönderir.
    </div>
}

@* ==== DONEM OZETI -- KUTULAR SUZGEC ====
   Sayilar PROTOKOL sayar, kayit degil (alt satirda kayit). Araligin TAMAMI icin, sayfaya
   ve aramaya bagli degil; tavansiz SQL'den geliyor (bkz. AkisKartlariniHesaplaAsync).

   Uc durum kutusu birbirini disliyor, toplamlari "Donemde"ye esit. "Hic gonderilemeyen"
   onlarin UZERINE biniyor (Eksik verili + Hatali'nin alt kumesi) -- bu yuzden kesik
   cizgili ve ayri duruyor, ayni agirlikta bir dorduncu kova gibi gorunmesin. *@
<section class="akis-ozet" aria-label="Dönem özeti">
    <a asp-page="/Aktivite" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
       class="akis-ozet-toplam @(string.IsNullOrEmpty(Model.Status) ? "active" : "")" title="Tüm protokolleri listele">
        <span class="akis-ozet-etiket">Dönemde</span>
        <span class="akis-ozet-sayi">@Model.Ozet.HastaToplam.ToString("N0", tr)</span>
        <span class="akis-ozet-alt">protokol · @Model.Ozet.ToplamKayit.ToString("N0", tr) kayıt</span>
    </a>

    @foreach (var (durum, css, ad, sayi, alt) in new[]
    {
        ("Success", "ok", "Sorunsuz", Model.Ozet.HastaBasarili, $"{Model.Ozet.BasariliKayit.ToString("N0", tr)} kayıt başarılı"),
        ("Skipped", "eksik", "Eksik verili", Model.Ozet.HastaAtlanan, $"{Model.Ozet.AtlananKayit.ToString("N0", tr)} kayıt atlandı"),
        ("Failed", "hata", "Hatalı", Model.Ozet.HastaHatali, $"{Model.Ozet.HataliKayit.ToString("N0", tr)} kayıt hata aldı"),
    })
    {
        <a asp-page="/Aktivite" asp-route-Status="@durum" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
           asp-route-Kategori="@(durum == "Failed" ? Model.Kategori : null)"
           class="akis-ozet-kutu akis-ozet-kutu--@css @(Model.Status == durum ? "active" : "")"
           aria-current="@(Model.Status == durum ? "true" : null)">
            <span class="akis-kare akis-kare--@css" aria-hidden="true"></span>
            <span class="akis-ozet-kutu-metin">
                <span class="akis-ozet-etiket">@ad</span>
                <span class="akis-ozet-sayi akis-ozet-sayi--kucuk">@sayi.ToString("N0", tr)</span>
                <span class="akis-ozet-alt">@alt</span>
            </span>
        </a>
    }

    <a asp-page="/Aktivite" asp-route-Status="@hicbiri" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
       class="akis-ozet-kutu akis-ozet-kutu--altkume @(Model.Status == hicbiri ? "active" : "")"
       aria-current="@(Model.Status == hicbiri ? "true" : null)"
       title="Tek bir kaydı bile TRƏS'e ulaşmamış protokoller — Eksik verili ve Hatalı içinden">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="6.2"/><path d="M4 12 12 4"/></svg>
        <span class="akis-ozet-kutu-metin">
            <span class="akis-ozet-etiket">Hiç gönderilemeyen · alt küme</span>
            <span class="akis-ozet-sayi akis-ozet-sayi--kucuk">@Model.Ozet.HastaHicGitmedi.ToString("N0", tr)</span>
            <span class="akis-ozet-alt">@Model.Ozet.HicGitmeyenKayit.ToString("N0", tr) kayıt · hiçbiri ulaşmadı</span>
        </span>
    </a>
</section>

@* ISLEM SONUCU -- gonderme/silme POST-REDIRECT-GET ile bittigi icin TempData'dan
   geliyor. Sessiz basari yok: devlet kayit sistemine yazan bir dugmeye basan kisi
   ne oldugunu GORMELI. *@
@if (!string.IsNullOrWhiteSpace(Model.IslemMesaji))
{
    <div class="alert @(Model.IslemBasarili ? "alert-success" : "alert-danger")">@Model.IslemMesaji</div>
}

@* KIRPMA YALNIZCA LISTEYI ETKILIYOR (2026-10-16). Ozet sayilari tavansiz SQL'den
   geliyor, yani aralik genisleyince dusemezler. *@
@if (Model.Ozet.Kirpildi)
{
    <div class="alert alert-warning">
        Bu tarih aralığında <strong>60.000'den fazla farklı kayıt</strong> var;
        <strong>aşağıdaki liste</strong> en yeni 60.000 kayda göre çıkarıldı.
        Üstteki <strong>özet etkilenmez</strong> — doğrudan veritabanı toplamından gelir.
        Listenin tamamı için aralığı daraltın.
    </div>
}
@* DOLDURMA SURERKEN SUSMAK YANLIS OLUR: ozet sayilari protokol bagina dayaniyor ve
   bag henuz doldurulmamis eski satirlar sayima girmiyor (bkz. ProtokolBagiDoldurmaService). *@
@if (Model.Ozet.BagiEksikSatir > 0)
{
    <div class="alert alert-warning">
        Geçmiş kayıtların protokol bağlantısı hâlâ <strong>dolduruluyor</strong>
        (@Model.Ozet.BagiEksikSatir.ToString("N0", tr) satır kaldı). Bu süre boyunca üstteki
        protokol sayıları eski kayıtları <strong>henüz içermiyor</strong>; doldurma ilerledikçe
        kendiliğinden tamamlanır. Kayıt sayıları bundan etkilenmez.
    </div>
}
@if (Model.Ozet.PusulaHatasi)
{
    @* SAYI GUVENILMEZ OLDUGUNDA BUNU SOYLEMEK ZORUNDAYIZ -- yanlis yonu YUKARI. *@
    <div class="alert alert-danger">
        <strong>Liste eksik.</strong> Pusula'ya erişilemediği için bazı kayıtların hangi
        protokole ait olduğu çözülemedi; onlar listenin sonundaki <strong>kimliği çözülemeyen</strong>
        grupta duruyor. Sayfayı yenileyip tekrar deneyin.
    </div>
}

@if (Model.Status == "Failed" && !string.IsNullOrWhiteSpace(Model.Kategori))
{
    <div class="filter-chip-bar">
        <span class="filter-chip">
            Kategori: <strong>@Model.Kategori</strong>
            <a asp-page="/Aktivite" asp-route-Status="Failed" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam" class="filter-chip-x" title="Kategori filtresini kaldır">&times;</a>
        </span>
    </div>
}

<section class="card akis-liste" aria-label="Protokoller">
    @* SECILENLERI GONDER -- satirlardaki kutular bu forma form="akis-toplu" ile bagli.
       Ic ice form HTML'de yasak; satirlarin kendi Gonder/Sil formlari var. *@
    <form id="akis-toplu" method="post" asp-page-handler="TopluGonder"
          asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
          asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
          asp-route-P="@Model.PageNumber" asp-route-From="@fromIso" asp-route-To="@toIso"
          onsubmit="return akisTopluOnay(this)"></form>

    <div class="akis-liste-arac">
        <h2 class="akis-liste-baslik">Protokoller</h2>
        <span class="akis-liste-bilgi">
            @if (Model.ListelenenGrupSayisi == 0)
            {
                <text>0 protokol</text>
            }
            else
            {
                <text>@Model.ListelenenGrupSayisi.ToString("N0", tr) protokol · @Model.IlkSira–@Model.SonSira arası</text>
            }
        </span>

        <div class="akis-liste-eylem">
            <form method="get" class="akis-sirala">
                <input type="hidden" name="Status" value="@Model.Status" />
                <input type="hidden" name="Kategori" value="@Model.Kategori" />
                <input type="hidden" name="ResourceType" value="@Model.ResourceType" />
                <input type="hidden" name="Q" value="@Model.Q" />
                <input type="hidden" name="Ortam" value="@Model.Ortam" />
                <input type="hidden" name="From" value="@fromIso" />
                <input type="hidden" name="To" value="@toIso" />
                <label for="sira">Sırala</label>
                <select id="sira" name="Sira" onchange="this.form.submit()">
                    <option value="son" selected="@(Model.Sira is null or "son")">En son denenen</option>
                    <option value="deneme" selected="@(Model.Sira == "deneme")">En çok deneme</option>
                    <option value="tarih" selected="@(Model.Sira == "tarih")">Protokol tarihi</option>
                </select>
            </form>
            <button type="button" class="btn btn-outline btn-sm" onclick="akisSorunlulariSec()">Takılanları seç</button>
            <button type="submit" form="akis-toplu" class="btn btn-primary btn-sm" id="akis-toplu-dugme" disabled>Seçilenleri gönder</button>
        </div>
    </div>

    @if (Model.Gruplar.Count == 0)
    {
        <div class="empty-state">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <p>Bu filtreye uyan protokol yok.</p>
        </div>
    }
    else
    {
        <div class="akis-sutunlar" aria-hidden="true">
            <span></span>
            <span>Hasta · protokol</span>
            <span>Gönderim zinciri</span>
            <span>Durum</span>
            <span class="akis-sag">Kayıt · deneme</span>
            <span></span>
        </div>

        @foreach (var grup in Model.Gruplar)
        {
            var (durumCss, durumEtiket) = grup.DurumGosterimi;
            var sebep = grup.SebepBaslik;

            @* SATIR = <details>. Kapali haliyle tasarimdaki satir (kimlik, zincir, durum,
               sebep); acilinca eski ekranin deneme tablosu -- tekil Gonder/Sil/Detay orada.
               Kullanici 2026-10-08'de "tek tek, toplu, hasta bazli, hepsi" demisti; yeni
               gorunum bunlarin hicbirini geri almiyor.

               HEPSI KAPALI GELIR: takilan protokolun sebebi artik satirin altinda yaziyor,
               aramak icin acmak gerekmiyor. Suzgecle gelinmisse (Hatali'ya tiklandi) acik:
               kullanici zaten "bu satirlari goster" dedi. *@
            <details class="akis-satir akis-satir--@durumCss" open="@(grup.Suzulmus && !string.IsNullOrEmpty(Model.Kategori))">
                <summary>
                    <span class="akis-satir-sec" onclick="event.stopPropagation()">
                        @if (grup.ProtokolId is { } secPid)
                        {
                            <input type="checkbox" name="protokolIds" value="@secPid" form="akis-toplu"
                                   aria-label="Protokol @secPid seç" data-sorunlu="@(durumCss != "ok" ? "1" : "0")"
                                   onchange="akisSecimSay()" />
                        }
                    </span>

                    <span class="akis-satir-kimlik">
                        <span class="akis-satir-ad">
                            <span class="akis-grup-ok" aria-hidden="true"></span>
                            @if (grup.Kimliksiz)
                            {
                                @* FARKLI kisilerin kayitlari -- tek isim yanlis bilgi olurdu
                                   (bkz. AktiviteGrubu.HastaAdi). *@
                                <text>Kimliği çözülemeyen kayıtlar</text>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(grup.HastaAdi) ? "—" : grup.HastaAdi)
                            }
                            @if (!string.IsNullOrWhiteSpace(grup.Fin))
                            {
                                <span class="akis-satir-fin">@grup.Fin</span>
                            }
                        </span>
                        @if (grup.Protokol is { } pr)
                        {
                            <span class="akis-satir-alt">
                                @string.Join(" · ", new[] { pr.BolumAdi, pr.DoktorAdiSoyadi }.Where(x => !string.IsNullOrWhiteSpace(x)))
                            </span>
                            <span class="akis-satir-alt akis-mono">
                                protokol @pr.ProtokolId.ToString(System.Globalization.CultureInfo.InvariantCulture)
                                @if (pr.AcilisTarihi is { } ac) { <text> · @ac.ToString("dd.MM.yyyy")</text> }
                                · @(pr.GelisTipiId == "Y" ? "Yatan" : pr.GelisTipiId == "G" ? "Günübirlik" : "Ayaktan")
                            </span>
                        }
                        else if (grup.ProtokolId is { } bilgisizPid)
                        {
                            <span class="akis-satir-alt akis-mono">protokol @bilgisizPid.ToString(System.Globalization.CultureInfo.InvariantCulture) · bilgisi okunamadı</span>
                        }
                        else if (grup.HastaGrubu)
                        {
                            <span class="akis-satir-alt">Hasta kaydı — bu aralıkta protokol gönderimi yok</span>
                        }
                        else
                        {
                            <span class="akis-satir-alt">Doktor kayıtları ve protokolü çözülemeyen satırlar</span>
                        }
                    </span>

                    @* GONDERIM ZINCIRI -- hangi halka gitti, hangisi takildi. Kimliksiz grupta
                       yok: farkli protokollerin kayitlari tek bir zincir olusturmuyor. *@
                    <span class="akis-zincir">
                        @if (!grup.Kimliksiz)
                        {
                            @foreach (var h in grup.Zincir)
                            {
                                <span class="akis-halka akis-halka--@h.Css" title="@h.Aciklama">
                                    <span class="akis-kare akis-kare--@h.Css" aria-hidden="true"></span>
                                    @h.Ad
                                    @if (h.Adet > 0)
                                    {
                                        @* Takilan varsa "takilan/toplam" -- 9 islemden 2'si mi,
                                           9'u mu, rozetten okunsun. *@
                                        <span class="akis-halka-adet">@(h.Takilan > 0 ? $"{h.Takilan}/{h.Adet}" : h.Adet.ToString(tr))</span>
                                    }
                                </span>
                            }
                        }
                    </span>

                    <span class="akis-satir-durum">
                        <span class="akis-kare akis-kare--@durumCss" aria-hidden="true"></span>
                        <span>
                            @durumEtiket
                            @if (grup.Ozet.HicGitmedi)
                            {
                                <span class="akis-satir-hic">hiç gitmedi</span>
                            }
                        </span>
                    </span>

                    @* KAYIT ile DENEME ayri: bir kayit birden cok kez denenmis olabilir. *@
                    <span class="akis-satir-sayac akis-mono" title="@grup.ToplamKayit kayıt, @grup.ToplamDeneme deneme@(grup.Suzulmus ? $" — süzgece uyan {grup.Kayitlar.Count} deneme gösteriliyor" : "")">
                        @grup.ToplamKayit · @grup.ToplamDeneme
                        <span class="akis-satir-saat">@grup.SonZamanYerel.ToString("dd.MM HH:mm")</span>
                    </span>

                    @* PROTOKOL BAZLI ISLEMLER. <summary> icinde: stopPropagation sart, yoksa
                       dugmeye basmak satiri da acip kapatirdi. *@
                    <span class="akis-satir-eylem" onclick="event.stopPropagation()">
                        @if (grup.ProtokolId is { } grupPid)
                        {
                            @* Yeni sekmede: kisi listedeki yerini kaybetmesin (2026-10-10). *@
                            <a asp-page="/Protokol" asp-route-id="@grupPid" class="btn btn-outline btn-sm"
                               target="_blank" rel="noopener" title="Protokol detayını yeni sekmede aç">Detay</a>
                            <form method="post" asp-page-handler="GrupGonder" asp-route-protokolId="@grupPid"
                                  asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                  asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
                                  asp-route-P="@Model.PageNumber" asp-route-From="@fromIso" asp-route-To="@toIso"
                                  onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-primary btn-sm"
                                        title="Bu protokolün tüm zincirini yeniden gönder (müayinə, tanı, işlem, epikriz, laboratuvar, radyoloji, patoloji)">Gönder</button>
                            </form>
                            <form method="post" asp-page-handler="GrupSil" asp-route-protokolId="@grupPid"
                                  asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                  asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
                                  asp-route-P="@Model.PageNumber" asp-route-From="@fromIso" asp-route-To="@toIso"
                                  data-onay="Protokol @grupPid: bu hastanın TRƏS'e gönderilmiş TÜM kayıtları silinecek."
                                  onsubmit="return pusulaSilOnayi(this)">
                                <button type="submit" class="btn btn-outline btn-sm alt-serit-sil"
                                        title="Hasta kaydı silinmez -- başka protokollerde de kullanılıyor">Sil</button>
                            </form>
                        }
                    </span>

                    @if (sebep is not null)
                    {
                        <span class="akis-satir-sebep">
                            <strong class="akis-renk--@durumCss">@sebep</strong>
                            @if (grup.SebepMetni is { } metin)
                            {
                                <text> — @metin</text>
                            }
                        </span>
                    }
                </summary>

                <div class="table-wrap akis-grup-tablo">
                    <table>
                        <thead>
                            <tr>
                                <th style="width:104px;">Tarih / Saat</th>
                                <th style="width:150px;">Tür</th>
                                <th style="width:110px;">Pusula Id</th>
                                <th style="width:26%;">Gönderim içeriği</th>
                                <th style="width:130px;">Durum</th>
                                <th style="width:80px;">İşlem</th>
                                <th>Mesaj</th>
                                <th style="width:72px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in grup.Kayitlar)
                            {
                                <tr>
                                    @* Saat ustte, tarih altinda (2026-10-13): bir grup birden fazla
                                       gune yayilabiliyor. *@
                                    <td class="mono text-muted">
                                        @{ var zaman = AzTime.ToLocal(e.CreatedAtUtc); }
                                        @zaman.ToString("HH:mm:ss")
                                        <span class="akis-satir-tarih">@zaman.ToString("dd.MM.yyyy")</span>
                                    </td>
                                    <td><span class="badge @SyncLogEntry.ResourceTypeCssClass(e.ResourceType)">@SyncLogEntry.ResourceTypeLabel(e.ResourceType)</span></td>
                                    <td class="mono">@e.PusulaId.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                                    <td>
                                        @* GONDERIM ICERIGI: id'nin insan okunur karsiligi. Cozulemezse
                                           bos -- uydurma metin yazmaktansa bos birakmak dogru. *@
                                        @if (e.ResourceType == "Encounter" && grup.Protokol?.BolumAdi is { Length: > 0 } muayineBolum)
                                        {
                                            <span>@muayineBolum</span>
                                            @if (grup.Protokol?.GelisTipiId is { } gt)
                                            {
                                                <span class="text-muted">&nbsp;&middot; @(gt == "Y" ? "Yatan" : gt == "G" ? "Günübirlik" : "Ayaktan")</span>
                                            }
                                        }
                                        else if (e.ResourceType == "Patient")
                                        {
                                            <span>@(string.IsNullOrWhiteSpace(e.PatientFullName) ? "—" : e.PatientFullName)</span>
                                            @if (!string.IsNullOrWhiteSpace(e.Fin))
                                            {
                                                <span class="mono text-muted" style="margin-left:6px;">@e.Fin</span>
                                            }
                                        }
                                        else if (Model.Aciklamalar.TryGetValue((e.ResourceType, e.PusulaId), out var icerik))
                                        {
                                            @* Epikrizde onek: deger epikrizin kendisi degil, YAZAN doktor. *@
                                            @if (e.ResourceType == "Composition")
                                            {
                                                <span class="text-muted">Yazan:</span> <span>@icerik</span>
                                            }
                                            else
                                            {
                                                <span>@icerik</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-faint">—</span>
                                        }
                                    </td>
                                    <td>
                                        @{ var (aBadgeClass, aBadgeLabel) = SyncLogEntry.StatusBadge(e); }
                                        <span class="badge @aBadgeClass"><span class="badge-dot"></span>@aBadgeLabel</span>
                                    </td>
                                    <td class="text-muted">@(e.Operation?.ToString() ?? "-")</td>
                                    <td class="cell-wide text-muted">
                                        @if (e.Status == SyncStatus.Failed && e.Message is not null)
                                        {
                                            <span title="@e.Message">@SyncLogEntry.FriendlyError(e.Message)</span>
                                        }
                                        else
                                        {
                                            @(e.Message ?? "-")
                                        }
                                    </td>
                                    @* fromProtokol TASINIYOR (2026-10-08): Detay'daki "Tekrar gonder"
                                       Encounter baglamina ihtiyac duyuyor. *@
                                    <td>
                                        <div class="akis-satir-islem">
                                            <a asp-page="/Detail" asp-route-id="@e.Id"
                                               asp-route-fromProtokol="@grup.ProtokolId"
                                               class="btn btn-outline btn-sm">Detay</a>
                                            <form method="post" asp-page-handler="Gonder" asp-route-kayitId="@e.Id"
                                                  asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                                  asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
                                                  asp-route-P="@Model.PageNumber" asp-route-From="@fromIso" asp-route-To="@toIso"
                                                  onsubmit="pusulaLockSubmit(this)">
                                                <input type="hidden" name="ProtokolId" value="@grup.ProtokolId" />
                                                <button type="submit" class="btn btn-outline btn-sm" title="Bu kaydı yeniden gönder">Gönder</button>
                                            </form>
                                            @* Sil yalnizca TRƏS'te karsiligi olan kayitta. *@
                                            @if (e.AzResourceId is not null)
                                            {
                                                <form method="post" asp-page-handler="Sil" asp-route-kayitId="@e.Id"
                                                      asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                                      asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam"
                                                      asp-route-P="@Model.PageNumber" asp-route-From="@fromIso" asp-route-To="@toIso"
                                                      data-onay="@SyncLogEntry.ResourceTypeLabel(e.ResourceType) kaydı (Pusula @e.PusulaId) TRƏS'ten silinecek."
                                                      onsubmit="return pusulaSilOnayi(this)">
                                                    <button type="submit" class="btn btn-outline btn-sm alt-serit-sil">Sil</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }

        <div class="pagination akis-sayfalama">
            <span class="text-muted akis-mono" style="margin-right:auto; font-size:12px;">
                @Model.IlkSira–@Model.SonSira / @Model.ListelenenGrupSayisi.ToString("N0", tr)
            </span>
            @if (Model.PageNumber > 1)
            {
                <a class="btn btn-outline btn-sm" asp-page="/Aktivite" asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam" asp-route-P="@(Model.PageNumber - 1)">&larr; Önceki</a>
            }
            @if (Model.HasNextPage)
            {
                <a class="btn btn-outline btn-sm" asp-page="/Aktivite" asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Kategori="@Model.Kategori" asp-route-Q="@Model.Q" asp-route-Sira="@Model.Sira" asp-route-Ortam="@Model.Ortam" asp-route-P="@(Model.PageNumber + 1)">Sonraki &rarr;</a>
            }
        </div>
    }
</section>

<script>
    // SILME ONAYI. Silme bakanligin sistemine KALICI yaziyor ve geri alinamiyor.
    // Mesaj data-onay niteliginden okunuyor: kayit adindaki bir kesme isareti
    // ("Müayinə'nin") onsubmit icine gomulu bir JS dizesini bozardi.
    function pusulaSilOnayi(form) {
        var mesaj = form.getAttribute('data-onay') || 'Bu kayıt TRƏS\'ten silinecek.';
        if (!confirm(mesaj + '\n\nBu işlem geri alınamaz. Devam edilsin mi?')) { return false; }
        pusulaLockSubmit(form);
        return true;
    }

    function akisSecilenler() {
        return document.querySelectorAll('input[name="protokolIds"]:checked');
    }

    // Dugme secim yokken kapali ve kac protokol gidecegini yaziyor -- toplu gonderim
    // canli sisteme yazar, "kac tane" sorusu dugmeye basmadan cevaplanmali.
    function akisSecimSay() {
        var n = akisSecilenler().length;
        var d = document.getElementById('akis-toplu-dugme');
        if (!d) { return; }
        d.disabled = n === 0;
        d.textContent = n === 0 ? 'Seçilenleri gönder' : n + ' protokolü gönder';
    }

    // "Takilanlari sec": Eksik verili ve Hatali satirlar. Ikinci basis secimi kaldirir.
    function akisSorunlulariSec() {
        var kutular = document.querySelectorAll('input[name="protokolIds"][data-sorunlu="1"]');
        var hepsiSecili = kutular.length > 0 && Array.prototype.every.call(kutular, function (k) { return k.checked; });
        kutular.forEach(function (k) { k.checked = !hepsiSecili; });
        akisSecimSay();
    }

    function akisTopluOnay(form) {
        var n = akisSecilenler().length;
        if (n === 0) { return false; }
        if (!confirm(n + ' protokolün tüm zinciri yeniden gönderilecek. Bu, protokol başına birkaç saniye sürebilir; sayfa bitene kadar bekleyin.\n\nDevam edilsin mi?')) { return false; }
        pusulaLockSubmit(form);
        var d = document.getElementById('akis-toplu-dugme');
        if (d) { d.disabled = true; d.textContent = 'Gönderiliyor…'; }
        return true;
    }

    // CANLI SERIT 15 SN'DE BIR TAZELENIR -- yalnizca serit, liste degil. Liste kendiliginden
    // degisseydi kullanicinin bakmakta oldugu satir elinin altindan kayardi.
    // Sekme arka plandayken sorulmuyor; hata olursa sessizce eski serit kaliyor (bir
    // sonraki deneme 15 sn sonra).
    (function akisSeritTazele() {
        setInterval(function () {
            if (document.hidden) { return; }
            var mevcut = document.getElementById('akis-serit');
            if (!mevcut || mevcut.querySelector('button[disabled]')) { return; }
            fetch('?handler=Serit', { headers: { 'X-Requested-With': 'fetch' } })
                .then(function (r) { return r.ok ? r.text() : null; })
                .then(function (html) {
                    if (!html) { return; }
                    // DOMParser: ayristirilan belge betik calistirmaz, sayfaya eklenen yalnizca serit.
                    var yeni = new DOMParser().parseFromString(html, 'text/html').getElementById('akis-serit');
                    if (yeni) { mevcut.replaceWith(yeni); }
                })
                .catch(function () { });
        }, 15000);
    })();
</script>

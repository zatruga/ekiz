@page
@model PusulaEHealthSync.Web.Pages.AktiviteModel
@using PusulaEHealthSync.Persistence
@{
    ViewData["Title"] = "Aktivite Akışı";
    ViewData["Genis"] = true;   // 10+ sutunlu veri tablosu -- genislik sinirindan muaf
}

<p class="breadcrumb"><a asp-page="/Index">Protokol Listesi</a> / Aktivite Akışı</p>
<div class="page-header">
    <div>
        <h1 class="page-title">Aktivite Akışı</h1>
        <p class="page-subtitle">Her senkron denemesinin ham, teknik kaydı &mdash; hastaya göre gruplanmış, kaynak türüne göre filtrelenebilir</p>
    </div>
</div>

@{
    var fromIso = Model.EffectiveFrom.ToString("yyyy-MM-dd");
    var toIso = Model.EffectiveTo.ToString("yyyy-MM-dd");
}

<form method="get" class="filter-bar">
    <label for="from">Başlangıç</label>
    <input type="date" id="from" name="From" value="@fromIso" onchange="this.form.submit()" />
    <label for="to">Bitiş</label>
    <input type="date" id="to" name="To" value="@toIso" onchange="this.form.submit()" />
    <input type="hidden" name="Status" value="@Model.Status" />
    <input type="hidden" name="Kategori" value="@Model.Kategori" />
    <select name="ResourceType" onchange="this.form.submit()">
        <option value="">Tüm kayıt türleri</option>
        <option value="Patient" selected="@(Model.ResourceType == "Patient")">@SyncLogEntry.ResourceTypeLabel("Patient")</option>
        <option value="Encounter" selected="@(Model.ResourceType == "Encounter")">@SyncLogEntry.ResourceTypeLabel("Encounter")</option>
        <option value="Practitioner" selected="@(Model.ResourceType == "Practitioner")">@SyncLogEntry.ResourceTypeLabel("Practitioner")</option>
        <option value="Composition" selected="@(Model.ResourceType == "Composition")">@SyncLogEntry.ResourceTypeLabel("Composition")</option>
        <option value="Condition" selected="@(Model.ResourceType == "Condition")">@SyncLogEntry.ResourceTypeLabel("Condition")</option>
        <option value="Procedure" selected="@(Model.ResourceType == "Procedure")">@SyncLogEntry.ResourceTypeLabel("Procedure")</option>
        <option value="Observation" selected="@(Model.ResourceType == "Observation")">@SyncLogEntry.ResourceTypeLabel("Observation")</option>
        <option value="DiagnosticReport" selected="@(Model.ResourceType == "DiagnosticReport")">@SyncLogEntry.ResourceTypeLabel("DiagnosticReport")</option>
        <option value="DiagnosticReport-Patoloji" selected="@(Model.ResourceType == "DiagnosticReport-Patoloji")">@SyncLogEntry.ResourceTypeLabel("DiagnosticReport-Patoloji")</option>
        <option value="Composition-Patoloji" selected="@(Model.ResourceType == "Composition-Patoloji")">@SyncLogEntry.ResourceTypeLabel("Composition-Patoloji")</option>
        <option value="Observation-Patoloji" selected="@(Model.ResourceType == "Observation-Patoloji")">@SyncLogEntry.ResourceTypeLabel("Observation-Patoloji")</option>
    </select>
</form>

@* ==== KARTLAR HASTA SAYAR, SATIR DEGIL (KULLANICI ISTEGI 2026-10-07) ====
   "hasta sayilari tam gelsin, sayfa listelemesi icindeki hizmetlere gore degil hastayi
   saysin."

   Buyuk rakam HASTA/PROTOKOL sayisi, altindaki kucuk satir o hastalarin kac SyncLog
   kaydina karsilik geldigi. Ikisi de duruyor cunku iki ayri soruya cevap veriyorlar:
   "kac hastayi ilgilendiriyor" (is yuku) ve "kac deneme yapildi" (teknik hacim).

   EN KOTU DURUM KAZANIR: bir hastanin 40 kaydindan biri hata aldiysa o hasta Hatalı
   sayilir. Bu kart "hangi hastalarda sorun var" diye tiklaniyor; 39 kaydi gectigi icin
   basarili saymak kullaniciyi yanlis yere gotururdu. Kategoriler ortusmuyor,
   toplamlari Toplam'a esit.

   SAYILAR ARALIGIN TAMAMI ICIN -- goruntulenen sayfaya bagli degil. Sayfalar arasinda
   gezerken degismemeleri icin aralik ozeti iki dakika onbellekte tutuluyor. *@
<div class="stat-grid">
    <a asp-page="/Aktivite" asp-route-Status="" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" class="stat-card @(string.IsNullOrEmpty(Model.Status) ? "active" : "")">
        <div class="stat-top">
            <span class="stat-label">Toplam Hasta</span>
            <span class="stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
            </span>
        </div>
        <span class="stat-value">@Model.Ozet.HastaToplam</span>
        <span class="stat-foot">@Model.Ozet.ToplamKayit kayıt</span>
    </a>
    <a asp-page="/Aktivite" asp-route-Status="Success" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" class="stat-card success @(Model.Status == "Success" ? "active" : "")">
        <div class="stat-top">
            <span class="stat-label">Sorunsuz</span>
            <span class="stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
        </div>
        <span class="stat-value success">@Model.Ozet.HastaBasarili</span>
        <span class="stat-foot">@Model.Ozet.BasariliKayit kayıt başarılı</span>
    </a>
    <a asp-page="/Aktivite" asp-route-Status="Skipped" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" class="stat-card warning @(Model.Status == "Skipped" ? "active" : "")">
        <div class="stat-top">
            <span class="stat-label">Eksik verili</span>
            <span class="stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </span>
        </div>
        <span class="stat-value warning">@Model.Ozet.HastaAtlanan</span>
        <span class="stat-foot">@Model.Ozet.AtlananKayit kayıt atlandı</span>
    </a>
    <a asp-page="/Aktivite" asp-route-Status="Failed" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Kategori="@Model.Kategori" class="stat-card danger @(Model.Status == "Failed" ? "active" : "")">
        <div class="stat-top">
            <span class="stat-label">Hatalı</span>
            <span class="stat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </span>
        </div>
        <span class="stat-value danger">@Model.Ozet.HastaHatali</span>
        <span class="stat-foot">@Model.Ozet.HataliKayit kayıt hata aldı</span>
    </a>
</div>

@* ISLEM SONUCU -- gonderme/silme POST-REDIRECT-GET ile bittigi icin TempData'dan
   geliyor. Sessiz basari yok: devlet kayit sistemine yazan bir dugmeye basan kisi
   ne oldugunu GORMELI. *@
@if (!string.IsNullOrWhiteSpace(Model.IslemMesaji))
{
    <div class="alert @(Model.IslemBasarili ? "alert-success" : "alert-danger")">@Model.IslemMesaji</div>
}

@* Sessizce eksik sayi gostermek, hic gostermemekten kotu -- taban asildiginda
   kullanici bunu BILMEK zorunda, cunku karttaki "toplam hasta" artik eksik. *@
@if (Model.Ozet.Kirpildi)
{
    <div class="alert alert-warning">
        Bu tarih aralığında <strong>60.000'den fazla farklı kayıt</strong> var; hasta grupları en yeni
        60.000 kayda göre çıkarıldı. Üstteki <strong>kayıt sayıları etkilenmez</strong> (doğrudan
        veritabanı toplamından gelir); yalnızca hasta sayısı eksik kalabilir. Tam liste için aralığı daraltın.
    </div>
}
@if (Model.Ozet.PusulaHatasi)
{
    @* SAYI GUVENILMEZ OLDUGUNDA BUNU SOYLEMEK ZORUNDAYIZ. Kullanici ayni veri icin bir
       seferinde 340, digerinde 650 hasta gordu; aradaki fark Pusula'ya erisilemedigi an
       protokole baglanamayan kayitlardi. Yumusak bir not yeterli degil -- karttaki rakam
       o an YANLIS, ve yanlis yonu YUKARI. *@
    <div class="alert alert-danger">
        <strong>Hasta sayıları eksik.</strong> Pusula'ya erişilemediği için bazı kayıtların hangi
        protokole ait olduğu çözülemedi; onlar listenin sonundaki <strong>kimliği çözülemeyen</strong>
        grupta duruyor. Üstteki hasta sayılarını bu haliyle başka bir ölçümle karşılaştırmayın &mdash;
        sayfayı yenileyip tekrar deneyin. (Kayıt sayıları etkilenmez, onlar doğrudan veritabanından gelir.)
    </div>
}

@if (Model.Status == "Failed" && !string.IsNullOrWhiteSpace(Model.Kategori))
{
    <div class="filter-chip-bar">
        <span class="filter-chip">
            Kategori: <strong>@Model.Kategori</strong>
            <a asp-page="/Aktivite" asp-route-Status="Failed" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" class="filter-chip-x" title="Kategori filtresini kaldır">&times;</a>
        </span>
    </div>
}

@if (Model.Entries.Count == 0)
{
    <div class="table-wrap empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <p>Bu filtreye uyan senkron kaydı yok.</p>
    </div>
}
else
{
    @* ==== PROTOKOLE GORE GRUPLAMA (KULLANICI ISTEGI 2026-10-05) ====
       "tek tek tum islemler ve gonderimler icin tek tek satir yapmasin, protokole gore
       gruplayip yapsin, protokol bilgisi vs gosterilsin."

       Tek bir protokolun gonderimi onlarca satir uretiyor (bir hemogram paneli 50 satira
       kadar cikabiliyor); duz listede neyin hangi hastaya ait oldugu kayboluyordu.

       Hasta demografisi (ad, FIN, bolum, tarihler) artik GRUP BASLIGINDA, satirlarda
       degil -- protokol icinde sabit olan bir bilgiyi her satirda tekrarlamak tablonun
       1650px genisliginin asil sebebiydi. Satira ozgu kalan bilgi iceride duruyor.

       SAYFALAMA ARTIK GRUP BAZLI (2026-10-07): sayfa basina 25 HASTA/PROTOKOL. Eskiden
       60 SATIR cekiliyordu ve gruplama ondan sonra yapiliyordu -- tek bir yatan hastanin
       gunluk laboratuvari 60 satiri doldurabildigi icin 7.554 denemelik bir gun listede
       iki hasta olarak gorunuyordu. Bir grubun kayitlari artik iki sayfaya BOLUNMEZ. *@
    @* ==== ACILIR/KAPANIR GRUPLAR (KULLANICI ISTEGI 2026-10-06) ====
       Native <details>/<summary>: JavaScript gerektirmiyor, klavyeyle calisiyor, ekran
       okuyucular durumu kendiliginden bildiriyor.

       VARSAYILAN DURUM SORUNA GORE: hatali ya da eksik verili gruplar ACIK gelir, tamami
       basarili olanlar KAPALI. Bu sayfa pratikte "neyin yanlis gittigini" aramak icin
       aciliyor; 60 kayitlik bir sayfada sorunsuz protokollerin tamamini acik tutmak,
       aranan iki satiri kaydirmayla aratiyordu. Asagidaki "Tümünü aç/kapat" dugmesi
       varsayilani her an ezebiliyor, yani kimse kapali bir gruba mahkum kalmiyor. *@
    <div class="filter-bar" style="justify-content:flex-end; margin-bottom:10px;">
        <button type="button" class="btn btn-outline btn-sm" onclick="akisTumunuAyarla(true)">Tümünü aç</button>
        <button type="button" class="btn btn-outline btn-sm" onclick="akisTumunuAyarla(false)">Tümünü kapat</button>
    </div>

    @foreach (var grup in Model.Gruplar)
    {
        @* open="@bool": Razor, degeri false olan bool nitelikleri CIKTIYA HIC YAZMAZ.
           HTML'de "open" niteliginin VARLIGI grubu acar -- open="false" yazilsaydi grup
           yine acik gelirdi. *@
        @* Suzgec aciksa grup da acik gelir: kullanici zaten "bu durumdaki satirlari
           goster" dedi, hepsini tek tek acmasini istemek anlamsiz olurdu. *@
        <details class="card akis-grup" open="@(grup.Suzulmus || grup.Hatali > 0 || grup.Atlanan > 0)">
            <summary class="akis-grup-bas">
                @* Ok KIMLIK BLOGUNUN ICINDE: dogrudan summary'nin cocugu oldugunda
                   justify-content:space-between UC ogeyi dagitiyor ve kimlik ORTAYA
                   itiliyordu. Ici boslukta yuzen basliklar bu yuzden olusmustu. *@
                <div class="akis-grup-kimlik">
                    <span class="akis-grup-ok" aria-hidden="true"></span>
                    @if (grup.ProtokolId is { } pid)
                    {
                        @* stopPropagation: baglanti <summary> icinde oldugu icin tiklama
                           hem gezinti hem ac/kapat tetikleyebilirdi. Numaraya tiklamak
                           detaya gider, basligin bos yerine tiklamak acip kapatir. *@
                        <a asp-page="/Protokol" asp-route-id="@pid" class="akis-grup-no"
                           title="Protokol detayını aç" onclick="event.stopPropagation()">
                            @pid.ToString(System.Globalization.CultureInfo.InvariantCulture)
                        </a>
                    }
                    else if (grup.HastaGrubu)
                    {
                        @* HASTA GRUBU: protokolu yok ama kisi belli (aralikta protokol
                           gonderimi olmayan bir Hasta kaydi). Eskiden bu satirlar da
                           "Protokolsüz" kovasina dusuyordu; gunde protokol sayisi kadar
                           Hasta kaydi yazildigi icin o kova tek basina yuzlerce farkli
                           hastayi yutuyor ve "kac hasta" sayisini anlamsiz kiliyordu. *@
                        <span class="akis-grup-no akis-grup-no--yok" title="Hasta kaydı — bu aralıkta protokol gönderimi yok">
                            Hasta
                        </span>
                    }
                    else
                    {
                        <span class="akis-grup-no akis-grup-no--yok" title="Doktor kayıtları ve protokolü çözülemeyen satırlar">
                            Kimliksiz
                        </span>
                    }

                    <div class="akis-grup-metin">
                        <div class="akis-grup-hasta">
                            @if (grup.Kimliksiz)
                            {
                                @* Bu grupta FARKLI kisilerin kayitlari var -- tek bir isim
                                   yazmak yanlis bilgi olurdu (bkz. AktiviteGrubu.HastaAdi). *@
                                <text>Kimliği çözülemeyen kayıtlar</text>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(grup.HastaAdi) ? "—" : grup.HastaAdi)
                                @if (!string.IsNullOrWhiteSpace(grup.Fin))
                                {
                                    <span class="mono akis-grup-fin">@grup.Fin</span>
                                }
                            }
                        </div>
                        <div class="akis-grup-alt">
                            @if (grup.Protokol is { } pr)
                            {
                                @if (!string.IsNullOrWhiteSpace(pr.BolumAdi)) { <span>@pr.BolumAdi</span> }
                                @if (!string.IsNullOrWhiteSpace(pr.DoktorAdiSoyadi)) { <span>@pr.DoktorAdiSoyadi</span> }
                                <span>@(pr.GelisTipiId == "Y" ? "Yatan" : pr.GelisTipiId == "G" ? "Günübirlik" : "Ayaktan")</span>
                                @if (pr.AcilisTarihi is { } ac)
                                {
                                    <span class="mono">@ac.ToString("dd.MM.yyyy")@(pr.KapanisTarihi is { } kp ? " – " + kp.ToString("dd.MM.yyyy") : " – açık")</span>
                                }
                            }
                            else if (grup.ProtokolId is not null)
                            {
                                <span class="text-faint">Protokol bilgisi okunamadı</span>
                            }
                            else if (grup.HastaGrubu)
                            {
                                <span class="text-faint">Hasta kaydı &mdash; bu tarih aralığında bu hastaya ait protokol gönderimi yok</span>
                            }
                            else
                            {
                                <span class="text-faint">Doktor kayıtları ve protokolü çözülemeyen satırlar &mdash; her satırın kimliği kendi içeriğinde</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="akis-grup-sayim">
                    @if (grup.Basarili > 0)
                    {
                        <span class="badge success" title="@grup.Basarili kayıt gönderildi"><span class="badge-dot"></span>@grup.Basarili</span>
                    }
                    @if (grup.Hatali > 0)
                    {
                        <span class="badge danger" title="@grup.Hatali kayıt hata aldı"><span class="badge-dot"></span>@grup.Hatali</span>
                    }
                    @if (grup.Atlanan > 0)
                    {
                        <span class="badge warning" title="@grup.Atlanan kayıt eksik veri yüzünden gönderilemedi"><span class="badge-dot"></span>@grup.Atlanan</span>
                    }
                    <span class="mono text-muted akis-grup-saat">@grup.SonZamanYerel.ToString("dd.MM.yyyy HH:mm:ss")</span>
                    @* SUZGEC ACIKKEN KACTAN KACI: rozetler hastanin aralikta yaptigi
                       HER SEYI sayiyor, tablo ise yalnizca suzgece uyan satirlari
                       gosteriyor. Bu satir ikisi arasindaki farki aciklar -- yoksa
                       "3 basarili rozeti var ama tabloda 1 satir" celiski gibi gorunur. *@
                    @* HASTA BAZLI TOPLU ISLEMLER. <summary> icinde oldugu icin
                       stopPropagation sart -- yoksa dugmeye basmak grubu da acip
                       kapatirdi. Yalnizca protokolu BELLI gruplarda var: hasta kaydi
                       ve kimliksiz gruplarda gonderilecek/silinecek bir zincir yok,
                       o satirlarin kendi dugmeleri iceride duruyor. *@
                    @if (grup.ProtokolId is { } grupPid)
                    {
                        <span class="akis-grup-islem" onclick="event.stopPropagation()">
                            <form method="post" asp-page-handler="GrupGonder" asp-route-protokolId="@grupPid"
                                  asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                  asp-route-Kategori="@Model.Kategori" asp-route-P="@Model.PageNumber"
                                  asp-route-From="@fromIso" asp-route-To="@toIso"
                                  onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-outline btn-sm"
                                        title="Bu protokolün tüm zincirini yeniden gönder (müayinə, tanı, işlem, epikriz, laboratuvar, radyoloji, patoloji)">
                                    Tümünü gönder
                                </button>
                            </form>
                            <form method="post" asp-page-handler="GrupSil" asp-route-protokolId="@grupPid"
                                  asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                  asp-route-Kategori="@Model.Kategori" asp-route-P="@Model.PageNumber"
                                  asp-route-From="@fromIso" asp-route-To="@toIso"
                                  data-onay="Protokol @grupPid: bu hastanın TRƏS'e gönderilmiş TÜM kayıtları silinecek."
                                  onsubmit="return pusulaSilOnayi(this)"
                                  title="Hasta kaydı silinmez -- başka protokollerde de kullanılıyor">
                                <button type="submit" class="btn btn-outline btn-sm alt-serit-sil">Tümünü sil</button>
                            </form>
                        </span>
                    }
                    @* KAYIT ile DENEME ayri: bir kayit birden cok kez denenmis olabilir,
                       tablo denemeleri gosteriyor ama rozetler ve ust kart KAYIT sayiyor.
                       Ikisi farkliysa ikisi de yaziliyor, yoksa "3 kayit" basligi altinda
                       30 satir gormek celiski gibi duruyordu. *@
                    <span class="akis-grup-adet">
                        @if (grup.Suzulmus)
                        {
                            <text>@grup.ToplamDeneme denemeden @grup.Kayitlar.Count tanesi</text>
                        }
                        else if (grup.ToplamDeneme > grup.ToplamKayit)
                        {
                            <text>@grup.ToplamKayit kayıt &middot; @grup.ToplamDeneme deneme</text>
                        }
                        else
                        {
                            <text>@grup.ToplamKayit kayıt</text>
                        }
                    </span>
                </div>
            </summary>

            <div class="table-wrap akis-grup-tablo">
                <table>
                    <thead>
                        <tr>
                            <th style="width:92px;">Saat</th>
                            <th style="width:150px;">Tür</th>
                            <th style="width:110px;">Pusula Id</th>
                            @* Genislik payi verilmezse bu sutun MESAJ sutunuyla yarisiyor
                               ve kisa degerler bile ("Nevrologiya · Ayaktan") iki satira
                               sariyordu. *@
                            <th style="width:26%;">Gönderim içeriği</th>
                            <th style="width:130px;">Durum</th>
                            <th style="width:80px;">İşlem</th>
                            <th>Mesaj</th>
                            <th style="width:72px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in grup.Kayitlar)
                        {
                            <tr>
                                <td class="mono text-muted">@AzTime.ToLocal(e.CreatedAtUtc).ToString("HH:mm:ss")</td>
                                <td><span class="badge @SyncLogEntry.ResourceTypeCssClass(e.ResourceType)">@SyncLogEntry.ResourceTypeLabel(e.ResourceType)</span></td>
                                <td class="mono">@e.PusulaId.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>
                                    @* GONDERIM ICERIGI: id'nin insan okunur karsiligi. Hasta
                                       kayitlarinda ad zaten SyncLog'da tasiniyor, digerleri
                                       Pusula'dan toplu cozuluyor. Cozulemezse bos birakiliyor --
                                       uydurma metin yazmaktansa bos birakmak dogru. *@
                                    @* MUAYINE: PusulaId = ProtokolId oldugu icin Pusula'ya
                                       ayri sorgu gerekmiyor -- bolum bilgisi grubun protokol
                                       kaydindan geliyor (zaten okunmus durumda).
                                       Baslikta da yaziyor ama satir kendi basina
                                       okunabilir olmali: filtreyle tek tur suzuldugunde
                                       ya da satir kopyalandiginda baslik gorunmuyor. *@
                                    @if (e.ResourceType == "Encounter" && grup.Protokol?.BolumAdi is { Length: > 0 } muayineBolum)
                                    {
                                        <span>@muayineBolum</span>
                                        @if (grup.Protokol?.GelisTipiId is { } gt)
                                        {
                                            @* Ayirici ile tek satirda okunuyor; bos
                                               span'la yan yana koyunca iki satira sariyordu. *@
                                            <span class="text-muted">&nbsp;&middot; @(gt == "Y" ? "Yatan" : gt == "G" ? "Günübirlik" : "Ayaktan")</span>
                                        }
                                    }
                                    else if (e.ResourceType == "Patient")
                                    {
                                        <span>@(string.IsNullOrWhiteSpace(e.PatientFullName) ? "—" : e.PatientFullName)</span>
                                        @if (!string.IsNullOrWhiteSpace(e.Fin))
                                        {
                                            <span class="mono text-muted" style="margin-left:6px;">@e.Fin</span>
                                        }
                                    }
                                    else if (Model.Aciklamalar.TryGetValue((e.ResourceType, e.PusulaId), out var icerik))
                                    {
                                        @* Epikrizde onek var cunku deger EPIKRIZIN KENDISI degil,
                                           onu YAZAN doktor. Oneksiz birakilsaydi Doktor
                                           satirlarindan ayirt edilemezdi. *@
                                        @if (e.ResourceType == "Composition")
                                        {
                                            <span class="text-muted">Yazan:</span> <span>@icerik</span>
                                        }
                                        else
                                        {
                                            <span>@icerik</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-faint">—</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var (aBadgeClass, aBadgeLabel) = SyncLogEntry.StatusBadge(e);
                                    }
                                    <span class="badge @aBadgeClass"><span class="badge-dot"></span>@aBadgeLabel</span>
                                </td>
                                <td class="text-muted">@(e.Operation?.ToString() ?? "-")</td>
                                <td class="cell-wide text-muted">
                                    @if (e.Status == SyncStatus.Failed && e.Message is not null)
                                    {
                                        <span title="@e.Message">@SyncLogEntry.FriendlyError(e.Message)</span>
                                    }
                                    else
                                    {
                                        @(e.Message ?? "-")
                                    }
                                </td>
                                @* fromProtokol TASINIYOR (2026-10-08). Detay sayfasindaki
                                   "Tekrar gonder", Tani/Islem/Lab/Radyoloji turlerinde
                                   Encounter baglamina (azPatientId/azEncounterId) ihtiyac
                                   duyuyor ve o baglam yalnizca protokol biliniyorsa
                                   cozulebiliyor. Bu baglanti onu tasimadigi icin Aktivite
                                   Akisi'ndan gelen kullanici "desteklenmiyor, Protokol
                                   sayfasina gidin" mesajiyla karsilasiyordu -- oysa akis
                                   artik protokole gore grupli, protokol numarasi elimizde. *@
                                <td>
                                    <div class="akis-satir-islem">
                                        <a asp-page="/Detail" asp-route-id="@e.Id"
                                           asp-route-fromProtokol="@grup.ProtokolId"
                                           class="btn btn-outline btn-sm">Detay</a>

                                        @* TEKIL GONDERIM. ProtokolId gizli alanla gidiyor:
                                           Tani/Islem/Lab/Radyoloji/Patoloji gonderimi
                                           Encounter baglamina ihtiyac duyuyor ve o baglam
                                           ancak protokol biliniyorsa cozuluyor. Grup
                                           basligindan geldigi icin TAHMIN yok. *@
                                        <form method="post" asp-page-handler="Gonder" asp-route-kayitId="@e.Id"
                                              asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                              asp-route-Kategori="@Model.Kategori" asp-route-P="@Model.PageNumber"
                                              asp-route-From="@fromIso" asp-route-To="@toIso"
                                              onsubmit="pusulaLockSubmit(this)">
                                            <input type="hidden" name="ProtokolId" value="@grup.ProtokolId" />
                                            <button type="submit" class="btn btn-outline btn-sm" title="Bu kaydı yeniden gönder">Gönder</button>
                                        </form>

                                        @* SILME DUGMESI YALNIZCA TRƏS'TE KARSILIGI OLAN
                                           KAYITTA. AzResourceId bossa kayit yalnizca
                                           $validate edilmis demektir -- silinecek bir sey
                                           yok, dugmeyi gostermek yaniltici olurdu. *@
                                        @if (e.AzResourceId is not null)
                                        {
                                            <form method="post" asp-page-handler="Sil" asp-route-kayitId="@e.Id"
                                                  asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType"
                                                  asp-route-Kategori="@Model.Kategori" asp-route-P="@Model.PageNumber"
                                                  asp-route-From="@fromIso" asp-route-To="@toIso"
                                                  data-onay="@SyncLogEntry.ResourceTypeLabel(e.ResourceType) kaydı (Pusula @e.PusulaId) TRƏS'ten silinecek."
                                                  onsubmit="return pusulaSilOnayi(this)">
                                                <button type="submit" class="btn btn-outline btn-sm alt-serit-sil">Sil</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }

    <div class="pagination">
        <span class="text-muted" style="margin-right:auto; font-size:13px;">
            @Model.ListelenenGrupSayisi hastanın @Model.IlkSira&ndash;@Model.SonSira arası gösteriliyor
        </span>
        @if (Model.PageNumber > 1)
        {
            <a class="btn btn-outline btn-sm" asp-page="/Aktivite" asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Kategori="@Model.Kategori" asp-route-P="@(Model.PageNumber - 1)">&larr; Önceki</a>
        }
        @if (Model.HasNextPage)
        {
            <a class="btn btn-outline btn-sm" asp-page="/Aktivite" asp-route-Status="@Model.Status" asp-route-ResourceType="@Model.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Kategori="@Model.Kategori" asp-route-P="@(Model.PageNumber + 1)">Sonraki &rarr;</a>
        }
    </div>
}

<script>
    // SILME ONAYI. Silme, bakanligin sistemine KALICI yaziyor ve geri alinamiyor; bu ekran
    // ise 25 gruplu, filtrelenebilen bir gunluk -- yanlis tiklamanin en kolay oldugu yer.
    // Onaydan sonra dugme kilitleniyor (cift gonderim olmasin).
    // Mesaj data-onay niteliginden okunuyor, onsubmit'in icine gomulmuyor: kayit adinda
    // bir kesme isareti ("Müayinə'nin" gibi) JS dizesini bozardi ve dugme sessizce
    // calismaz hale gelirdi. Nitelikte Razor kodlamayi kendi yapiyor.
    function pusulaSilOnayi(form) {
        var mesaj = form.getAttribute('data-onay') || 'Bu kayıt TRƏS\'ten silinecek.';
        if (!confirm(mesaj + '\n\nBu işlem geri alınamaz. Devam edilsin mi?')) { return false; }
        pusulaLockSubmit(form);
        return true;
    }

    // Toplu ac/kapat -- varsayilani ezer. Sunucu tarafi varsayilani "sorunlu olanlar acik"
    // oldugu icin kullanicinin tam tersini isteyebilecegi durum her zaman var.
    function akisTumunuAyarla(acik) {
        document.querySelectorAll('details.akis-grup').forEach(function (d) { d.open = acik; });
    }
</script>

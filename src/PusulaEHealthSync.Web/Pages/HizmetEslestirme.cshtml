@page
@model PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel
@using PusulaEHealthSync.Persistence
@{
    ViewData["Title"] = "Hizmet Eşleştirme";

    // Siralanabilir baslik: ilk tik artan (istem icin azalan), ayni basliga ikinci tik
    // yonu cevirir. Esles suzgeci korunur.
    Microsoft.AspNetCore.Html.IHtmlContent Baslik(string anahtar, string ad)
    {
        var aktif = Model.Sira == anahtar;
        var ilk = anahtar == "istem" ? "desc" : "asc";
        var yon = aktif ? (Model.Yon == "desc" ? "asc" : "desc") : ilk;
        var url = Url.Page("/HizmetEslestirme", new { Model.Durum, Model.Tip, Model.Ara, Model.Esles, Sira = anahtar, Yon = yon });
        var ok = !aktif ? "↕" : Model.Yon == "desc" ? "↓" : "↑";
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a class=\"hz-sirala{(aktif ? " active" : "")}\" href=\"{enc.Encode(url!)}\">{enc.Encode(ad)} <span aria-hidden=\"true\">{ok}</span></a>");
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hizmet Eşleştirme</h1>
        <p class="page-subtitle">
            Pusula'daki tüm hizmetler ve bakanlık <code>az-procedure-codes</code> karşılıkları (6.094 kod).
            Asıl eşleştirme Pusula'da yapılır -- eşleşmeyenleri seçip Excel'e aktarın.
        </p>
    </div>
</div>

@if (Model.Toplu is { } toplu)
{
    <div class="alert alert-success">@toplu.ToString("N0") hizmet "gönderilmez" olarak işaretlendi.</div>
}
else if (Model.Saved)
{
    <div class="alert alert-success">Kaydedildi.</div>
}

@{
    var oran = Model.ToplamIstem == 0 ? 0 : 100.0 * Model.EslesenIstem / Model.ToplamIstem;
    var kutular = new (string Durum, string Ad, int Sayi, string Alt, string Css)[]
    {
        ("Tumu", "Tüm hizmetler", Model.ToplamSayi, "Pusula kataloğu", ""),
        ("Kullanimda", "Son 1 yılda kullanılan", Model.KullanilanSayi, "en az bir kez istenmiş", ""),
        ("Pusula", "Eşleşen", Model.PusulaSayi, "İcbari kodu var, gönderilir", "hz-k-yesil"),
        ("Eksik", "Eşleşme yok", Model.EksikSayi, "kodu yok, gönderilemez", "hz-k-kirmizi"),
        ("KullanimdaEksik", "Öncelikli", Model.EksikKullanilanSayi, "kullanımda + eşleşme yok", "hz-k-kirmizi hz-k-oncelik"),
        ("Gonderilmez", "Gönderilmez", Model.GonderilmezSayi, "bilerek gönderilmiyor", "hz-k-gri"),
    };
    var suzgecVar = !string.IsNullOrWhiteSpace(Model.Tip) || !string.IsNullOrWhiteSpace(Model.Ara);
}
<section class="card card-pad hz-ust" aria-label="Hizmet özeti">
    <div class="hz-kutular">
        @foreach (var k in kutular)
        {
            var secili = Model.Durum == k.Durum;
            <a asp-page="/HizmetEslestirme" asp-route-Durum="@k.Durum" asp-route-Tip="@Model.Tip" asp-route-Ara="@Model.Ara"
               asp-route-Sira="@Model.Sira" asp-route-Yon="@Model.Yon"
               class="hz-kutu @k.Css @(secili ? "active" : "")" aria-current="@(secili ? "true" : null)">
                <span class="hz-kutu-ad">@k.Ad</span>
                <span class="hz-kutu-sayi">@k.Sayi.ToString("N0")</span>
                <span class="hz-kutu-alt">@k.Alt</span>
            </a>
        }
    </div>
    <p class="hz-denklem">
        Eşleşen <b>@Model.PusulaSayi.ToString("N0")</b> + Eşleşme yok <b>@Model.EksikSayi.ToString("N0")</b>
        + Gönderilmez <b>@Model.GonderilmezSayi.ToString("N0")</b> = Tüm hizmetler <b>@Model.ToplamSayi.ToString("N0")</b>
    </p>

    <div class="hz-istem">
        <div class="hz-istem-bas">
            <span class="text-muted">Bakanlık kodu olan hizmetlerin yıllık istem payı</span>
            <span><strong>@oran.ToString("0.0")%</strong>
                  <span class="text-muted">(@Model.EslesenIstem.ToString("N0") / @Model.ToplamIstem.ToString("N0") istem)</span></span>
        </div>
        <div class="hz-istem-cubuk"><span style="width:@oran.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
    </div>

    <form method="get" class="hz-suzgec" role="search">
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Sira" value="@Model.Sira" />
        <input type="hidden" name="Yon" value="@Model.Yon" />
        <label class="hz-alan">
            <span>Hizmet tipi</span>
            <select id="hz-tip" name="Tip" onchange="this.form.submit()">
                <option value="">Tümü</option>
                @foreach (var t in Model.Tipler)
                {
                    <option value="@t" selected="@(Model.Tip == t)">@t</option>
                }
            </select>
        </label>
        <label class="hz-alan hz-alan-ara">
            <span>Ara</span>
            <span class="hz-ara">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="hz-ara" type="search" name="Ara" value="@Model.Ara" placeholder="Hizmet adı, Pusula ya da bakanlık kodu" />
            </span>
        </label>
        <button type="submit" class="btn btn-primary btn-sm hz-suzgec-btn">Filtrele</button>
        @if (suzgecVar)
        {
            <a asp-page="/HizmetEslestirme" asp-route-Durum="@Model.Durum" asp-route-Sira="@Model.Sira" asp-route-Yon="@Model.Yon" class="hz-temizle">Süzgeci temizle</a>
        }
        @{ var adaySecili = Model.Durum == "TibbiOlmayabilir"; }
        <a asp-page="/HizmetEslestirme" asp-route-Durum="@(adaySecili ? "Tumu" : "TibbiOlmayabilir")" asp-route-Tip="@Model.Tip" asp-route-Ara="@Model.Ara"
           class="hz-aday @(adaySecili ? "active" : "")" aria-current="@(adaySecili ? "true" : null)"
           title="Adında kafeterya, yemək, su, refakatçi gibi sözcükler geçen ve henüz gönderilmez olmayan hizmetler. Kendiliğinden işaretlemez.">
            Tıbbi olmayabilir <b>@Model.TibbiOlmayabilirSayi.ToString("N0")</b>
        </a>
    </form>
    <p class="hz-kural-not">
        @if (Model.OnEkler.Count > 0)
        {
            <text>Kural: adı <b>@string.Join(", ", Model.OnEkler)</b> ile başlayan <b>@Model.KuralSayi.ToString("N0")</b> hizmet kendiliğinden gönderilmez.</text>
        }
        else
        {
            <text>Ad kuralı tanımlı değil.</text>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-page="/Ayarlar" asp-fragment="hizmet-kurallari">Kuralı ve süzgeç sözcüklerini düzenle</a>
        }
    </p>
</section>

<form method="post" asp-page-handler="Excel">
    <input type="hidden" name="Durum" value="@Model.Durum" />
    <input type="hidden" name="Tip" value="@Model.Tip" />
    <input type="hidden" name="Ara" value="@Model.Ara" />
    <input type="hidden" name="Esles" value="@Model.Esles" />
    <input type="hidden" name="Sira" value="@Model.Sira" />
    <input type="hidden" name="Yon" value="@Model.Yon" />

    @* LISTE ARAC CUBUGU: eslesme suzgeci (sayilar ustteki filtrenin sonucundan) + Excel. *@
    <div class="card card-pad hz-arac">
        <div class="hz-sekmeler" role="group" aria-label="Eşleşme durumu">
            @foreach (var (deger, ad, sayi, css) in new[]
            {
                ("", "Tümü", Model.EslesTumu, ""),
                ("evet", "Eşleşen", Model.EslesEvet, "hz-yesil"),
                ("hayir", "Eşleşmeyen", Model.EslesHayir, "hz-kirmizi"),
                ("gonderilmez", "Gönderilmez", Model.EslesGonderilmez, "hz-gri"),
            })
            {
                var secili = (Model.Esles ?? "") == deger;
                <a asp-page="/HizmetEslestirme" asp-route-Durum="@Model.Durum" asp-route-Tip="@Model.Tip" asp-route-Ara="@Model.Ara"
                   asp-route-Esles="@(deger == "" ? null : deger)" asp-route-Sira="@Model.Sira" asp-route-Yon="@Model.Yon"
                   class="hz-sekme @css @(secili ? "active" : "")" aria-current="@(secili ? "true" : null)">
                    <span class="hz-sekme-sayi">@sayi.ToString("N0")</span> @ad
                </a>
            }
        </div>
        <span class="text-muted hz-arac-not">
            @if (Model.GosterilenSayi > HizmetEslestirmeModel.EkranSiniri)
            {
                <text>Ekranda ilk @HizmetEslestirmeModel.EkranSiniri.ToString("N0") / @Model.GosterilenSayi.ToString("N0") satır. </text>
            }
            Seçim yoksa listenin tamamı (@Model.GosterilenSayi.ToString("N0") kayıt) aktarılır.
        </span>
        <button type="submit" asp-page-handler="TopluGonderilmez" class="btn btn-outline btn-sm" style="margin-left:auto;"
                onclick="var n=document.querySelectorAll('.satir-sec:checked').length; if(!n){alert('Önce listeden satır seçin.');return false;} return confirm(n+' hizmet &quot;gönderilmez&quot; olarak işaretlenecek. Devam edilsin mi?');">
            Seçilenleri gönderilmez yap
        </button>
        <button type="submit" class="btn btn-primary btn-sm">Excel'e Aktar</button>
    </div>

    <div class="card">
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:34px;"><input type="checkbox" onclick="document.querySelectorAll('.satir-sec').forEach(c => c.checked = this.checked)" /></th>
                        <th style="width:80px;">@Baslik("id", "Pusula Id")</th>
                        <th style="width:105px;">@Baslik("kod", "Hizmet Kodu")</th>
                        <th>@Baslik("ad", "Hizmet Adı")</th>
                        <th style="width:125px;">@Baslik("tip", "Hizmet Tipi")</th>
                        <th style="width:80px; text-align:right;">@Baslik("istem", "İstem/yıl")</th>
                        <th style="width:105px;">@Baslik("azkod", "Bakanlık Kodu")</th>
                        <th>Bakanlık Karşılığı</th>
                        <th style="width:150px;">Gönderim</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Satirlar.Count == 0)
                {
                    <tr><td colspan="9" class="text-muted" style="padding:20px;">Kayıt bulunamadı.</td></tr>
                }
                @foreach (var s in Model.Satirlar)
                {
                    var kod = s.EtkinKod;
                    var az = PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel.AzAdi(kod);
                    var tr = PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel.AzAdiTr(kod);
                    <tr>
                        <td><input type="checkbox" class="satir-sec" name="secili" value="@s.HizmetId" /></td>
                        <td class="mono text-muted">@s.HizmetId</td>
                        <td><code>@s.HizmetKodu</code></td>
                        <td>@s.HizmetAdi</td>
                        <td class="text-muted" style="font-size:12px;">@s.HizmetTipi</td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums;">@s.Istem.ToString("N0")</td>
                        <td>@if (kod is not null) { <code>@kod</code> }</td>
                        <td style="font-size:13px;">
                            @if (s.Gonderilmez)
                            {
                                <span class="text-muted">Bakanlığa gönderilmiyor.</span>
                            }
                            else if (az is not null)
                            {
                                @if (tr is not null)
                                {
                                    <div>@tr</div>
                                    <div class="text-muted" style="font-size:12px; margin-top:2px;">@az</div>
                                }
                                else
                                {
                                    <div>@az</div>
                                }
                            }
                            else if (kod is not null)
                            {
                                <span style="color:var(--danger);">Bu kod bakanlık listesinde yok.</span>
                            }
                            else
                            {
                                <span class="text-muted">Eşleşme yok -- Excel'e alıp Pusula'da eşleştirin.</span>
                            }
                        </td>
                        @* KAYNAK VE ESLESTIR SUTUNLARI KALDIRILDI (2026-10-28, kullanici): kod bu ekrandan
                           girilmiyor, Pusula'daki Icbari fiyat listesinden geliyor. Burada tek karar:
                           bu hizmet bakanliga gitsin mi. "Gonderilmez" isaretli hizmet ne gonderilir ne de
                           Bekleyen Isler / Icbari kartinda eksik sayilir. *@
                        <td>
                            @if (s.Kural)
                            {
                                <span class="badge" title="Adı ad kuralındaki bir sözcükle başlıyor; kuraldan çıkarmak için Ayarlar'daki listeden silin."><span class="badge-dot"></span>gönderilmez · kural</span>
                            }
                            else if (s.Gonderilmez)
                            {
                                <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                                    <span class="badge"><span class="badge-dot"></span>gönderilmez</span>
                                    <button type="submit" form="s-@s.HizmetId" class="btn btn-outline btn-sm" title="İşareti kaldır; hizmet yeniden gönderime girer">Geri al</button>
                                </div>
                            }
                            else
                            {
                                <button type="submit" form="g-@s.HizmetId" class="btn btn-outline btn-sm" title="Bu hizmet bakanlığa gönderilmez ve eksik olarak sayılmaz">Gönderilmez</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</form>

@* Satir formlari tablonun DISINDA -- HTML'de form ic ice olamaz, form="..." ile baglaniyor. *@
@foreach (var s in Model.Satirlar)
{
    <form method="post" asp-page-handler="Gonderilmez" id="g-@s.HizmetId" hidden>
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Tip" value="@Model.Tip" />
        <input type="hidden" name="Ara" value="@Model.Ara" />
        <input type="hidden" name="Esles" value="@Model.Esles" />
        <input type="hidden" name="Sira" value="@Model.Sira" />
        <input type="hidden" name="Yon" value="@Model.Yon" />
        <input type="hidden" name="hizmetId" value="@s.HizmetId" />
    </form>
    <form method="post" asp-page-handler="Gonderilsin" id="s-@s.HizmetId" hidden>
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Tip" value="@Model.Tip" />
        <input type="hidden" name="Ara" value="@Model.Ara" />
        <input type="hidden" name="Esles" value="@Model.Esles" />
        <input type="hidden" name="Sira" value="@Model.Sira" />
        <input type="hidden" name="Yon" value="@Model.Yon" />
        <input type="hidden" name="hizmetId" value="@s.HizmetId" />
    </form>
}

<div class="card card-pad" style="margin-top:20px;">
    <p class="text-muted" style="font-size:13px; margin:0;">
        Bakanlık kodu Pusula'daki <strong>İcbari Sigorta Fiyat Listesi</strong>'nden gelir; eşleşmesi olmayan hizmetleri
        Excel'e alıp Pusula'da eşleştirin. <strong>Gönderilmez</strong>: tıbbi işlem olmayan kalemler (yatak ücreti, kafeterya,
        refakatçi). İşaretli hizmet bakanlığa gönderilmez ve Bekleyen İşler, Genel Bakış ve İcbari kartında eksik olarak sayılmaz;
        <strong>Geri al</strong> ile işaret kaldırılır. Bu tablo Pusula'ya <em>yazmaz</em>.
    </p>
</div>

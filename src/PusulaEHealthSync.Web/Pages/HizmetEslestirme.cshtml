@page
@model PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel
@using PusulaEHealthSync.Persistence
@{
    ViewData["Title"] = "Hizmet Eşleştirme";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Hizmet Eşleştirme</h1>
        <p class="page-subtitle">
            Pusula'daki tüm hizmetler ve bakanlık <code>az-procedure-codes</code> karşılıkları (6.094 kod).
            Asıl eşleştirme Pusula'da yapılır -- eşleşmeyenleri seçip Excel'e aktarın.
        </p>
    </div>
</div>

@if (Model.Saved)
{
    <div class="alert alert-success">Kaydedildi.</div>
}

<div class="card card-pad" style="margin-bottom:20px;">
    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
        <a asp-page="/HizmetEslestirme" asp-route-Durum="Tumu" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "Tumu" ? "active" : "")">
            <span class="stat-value" style="font-size:24px;">@Model.ToplamSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">Pusula'daki tüm hizmetler</span>
        </a>
        <a asp-page="/HizmetEslestirme" asp-route-Durum="Kullanimda" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "Kullanimda" ? "active" : "")">
            <span class="stat-value" style="font-size:24px;">@Model.KullanilanSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">son 1 yılda kullanılan</span>
        </a>
        <a asp-page="/HizmetEslestirme" asp-route-Durum="Pusula" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "Pusula" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--success);">@Model.PusulaSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">Pusula'dan eşleşen</span>
        </a>
        <a asp-page="/HizmetEslestirme" asp-route-Durum="Medigate" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "Medigate" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--warning);">@Model.MedigateSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">Medigate önerisi</span>
        </a>
        <a asp-page="/HizmetEslestirme" asp-route-Durum="Eksik" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "Eksik" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--danger);">@Model.EksikSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">Pusula'da eşleşme yok</span>
        </a>
        <a asp-page="/HizmetEslestirme" asp-route-Durum="KullanimdaEksik" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "KullanimdaEksik" ? "active" : "")" style="border:1px dashed var(--danger);">
            <span class="stat-value" style="font-size:24px; color:var(--danger);">@Model.EksikKullanilanSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">▶ öncelikli: kullanımda + eşleşme yok</span>
        </a>
        <a asp-page="/HizmetEslestirme" asp-route-Durum="Gonderilmez" asp-route-Tip="@Model.Tip" class="stat-link @(Model.Durum == "Gonderilmez" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--text-muted);">@Model.GonderilmezSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">gönderilmez</span>
        </a>

        <form method="get" style="margin-left:auto; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <input type="hidden" name="Durum" value="@Model.Durum" />
            <select name="Tip" class="form-control" style="width:190px;">
                <option value="">— tüm hizmet tipleri —</option>
                @foreach (var t in Model.Tipler)
                {
                    <option value="@t" selected="@(Model.Tip == t)">@t</option>
                }
            </select>
            <input type="text" name="Ara" value="@Model.Ara" placeholder="hizmet adı veya kod ara"
                   class="form-control" style="width:210px;" />
            <button type="submit" class="btn btn-outline btn-sm">Filtrele</button>
        </form>
    </div>

    @{
        var oran = Model.ToplamIstem == 0 ? 0 : 100.0 * Model.EslesenIstem / Model.ToplamIstem;
    }
    <div style="margin-top:14px;">
        <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:5px;">
            <span class="text-muted">Bakanlık kodu olan hizmetlerin yıllık istem payı</span>
            <span><strong>@oran.ToString("0.0")%</strong>
                  <span class="text-muted">(@Model.EslesenIstem.ToString("N0") / @Model.ToplamIstem.ToString("N0") istem)</span></span>
        </div>
        <div style="height:8px; background:var(--border); border-radius:4px; overflow:hidden;">
            <div style="height:100%; width:@oran.ToString("0.0")%; background:var(--success);"></div>
        </div>
    </div>
</div>

<form method="post" asp-page-handler="Excel">
    <input type="hidden" name="Durum" value="@Model.Durum" />
    <input type="hidden" name="Tip" value="@Model.Tip" />
    <input type="hidden" name="Ara" value="@Model.Ara" />

    <div class="card card-pad" style="margin-bottom:12px; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <button type="submit" class="btn btn-primary btn-sm">Seçilenleri Excel'e Aktar</button>
        <span class="text-muted" style="font-size:13px;">
            Hiçbiri seçilmezse <strong>filtrenin tamamı</strong> (@Model.GosterilenSayi kayıt) aktarılır.
            Excel'in son sütunu <strong>Pusula'ya girilen kod</strong> için boş bırakılmıştır.
        </span>
    </div>

    <div class="card">
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:34px;"><input type="checkbox" onclick="document.querySelectorAll('.satir-sec').forEach(c => c.checked = this.checked)" /></th>
                        <th style="width:105px;">Hizmet Kodu</th>
                        <th style="width:230px;">Hizmet Adı</th>
                        <th style="width:125px;">Hizmet Tipi</th>
                        <th style="width:80px; text-align:right;">İstem/yıl</th>
                        <th style="width:105px;">Bakanlık Kodu</th>
                        <th>Bakanlık Karşılığı</th>
                        <th style="width:105px;">Kaynak</th>
                        <th style="width:400px;">Eşleştir</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Satirlar.Count == 0)
                {
                    <tr><td colspan="9" class="text-muted" style="padding:20px;">Kayıt bulunamadı.</td></tr>
                }
                @foreach (var s in Model.Satirlar)
                {
                    var kod = s.EtkinKod;
                    var az = PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel.AzAdi(kod);
                    var tr = PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel.AzAdiTr(kod);
                    <tr>
                        <td><input type="checkbox" class="satir-sec" name="secili" value="@s.HizmetId" /></td>
                        <td><code>@s.HizmetKodu</code></td>
                        <td>@s.HizmetAdi</td>
                        <td class="text-muted" style="font-size:12px;">@s.HizmetTipi</td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums;">@s.Istem.ToString("N0")</td>
                        <td>@if (kod is not null) { <code>@kod</code> }</td>
                        <td style="font-size:13px;">
                            @if (s.Gonderilmez)
                            {
                                <span class="text-muted">Bakanlığa gönderilmiyor.</span>
                            }
                            else if (az is not null)
                            {
                                @if (tr is not null)
                                {
                                    <div>@tr</div>
                                    <div class="text-muted" style="font-size:12px; margin-top:2px;">@az</div>
                                }
                                else
                                {
                                    <div>@az</div>
                                }
                            }
                            else if (kod is not null)
                            {
                                <span style="color:var(--danger);">Bu kod bakanlık listesinde yok.</span>
                            }
                            else
                            {
                                <span class="text-muted">Eşleşme yok -- Excel'e alıp Pusula'da eşleştirin.</span>
                            }
                        </td>
                        <td>
                            @if (s.Gonderilmez)
                            {
                                <span class="badge"><span class="badge-dot"></span>gönderilmez</span>
                            }
                            else if (s.Rozet == HizmetMappingStore.KaynakPusula)
                            {
                                <span class="badge badge-success"><span class="badge-dot"></span>Pusula</span>
                            }
                            else if (s.Rozet == HizmetMappingStore.KaynakMedigate)
                            {
                                <span class="badge badge-warning"><span class="badge-dot"></span>Medigate</span>
                            }
                            else if (s.Rozet == HizmetMappingStore.KaynakKullanici)
                            {
                                <span class="badge badge-warning"><span class="badge-dot"></span>elle</span>
                            }
                            else
                            {
                                <span class="badge badge-danger"><span class="badge-dot"></span>yok</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; gap:5px; align-items:center; flex-wrap:wrap;">
                                @if (s.AdayListesi.Length > 0)
                                {
                                    @* Aday listesi: algoritma 3.052 secenegi birkac tanesine indiriyor,
                                       karari kullanici veriyor. Secilince ustteki kutuya yaziliyor. *@
                                    <select class="form-control" style="width:150px;"
                                            onchange="var i=document.getElementById('k-@s.HizmetId'); if(this.value){i.value=this.value;}">
                                        <option value="">— aday seç —</option>
                                        @foreach (var c in s.AdayListesi)
                                        {
                                            var cadi = PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel.AzAdiTr(c)
                                                       ?? PusulaEHealthSync.Web.Pages.HizmetEslestirmeModel.AzAdi(c);
                                            <option value="@c">@c — @(cadi is null ? "" : cadi.Length > 60 ? cadi[..60] + "…" : cadi)</option>
                                        }
                                    </select>
                                }
                                <input type="text" form="f-@s.HizmetId" id="k-@s.HizmetId" name="azKod" value="@s.AzKod"
                                       placeholder="@(s.Oneri ?? s.IcbariKodu)" class="form-control" style="width:95px;" />
                                <button type="submit" form="f-@s.HizmetId" class="btn btn-primary btn-sm">Kaydet</button>
                                @if (!s.Gonderilmez)
                                {
                                    <button type="submit" form="g-@s.HizmetId" class="btn btn-outline btn-sm">Gönderilmez</button>
                                }
                                @if (s.Kaynak == HizmetMappingStore.KaynakKullanici)
                                {
                                    <button type="submit" form="r-@s.HizmetId" class="btn btn-outline btn-sm"
                                            style="border-color:var(--danger); color:var(--danger);">Sıfırla</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</form>

@* Satir formlari tablonun DISINDA -- HTML'de form ic ice olamaz, form="..." ile baglaniyor. *@
@foreach (var s in Model.Satirlar)
{
    <form method="post" asp-page-handler="Kaydet" id="f-@s.HizmetId" hidden>
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Tip" value="@Model.Tip" />
        <input type="hidden" name="Ara" value="@Model.Ara" />
        <input type="hidden" name="hizmetId" value="@s.HizmetId" />
    </form>
    <form method="post" asp-page-handler="Gonderilmez" id="g-@s.HizmetId" hidden>
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Tip" value="@Model.Tip" />
        <input type="hidden" name="Ara" value="@Model.Ara" />
        <input type="hidden" name="hizmetId" value="@s.HizmetId" />
    </form>
    <form method="post" asp-page-handler="Sifirla" id="r-@s.HizmetId" hidden>
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <input type="hidden" name="Tip" value="@Model.Tip" />
        <input type="hidden" name="Ara" value="@Model.Ara" />
        <input type="hidden" name="hizmetId" value="@s.HizmetId" />
    </form>
}

<div class="card card-pad" style="margin-top:20px;">
    <p class="text-muted" style="font-size:13px; margin:0;">
        <strong>Pusula</strong> = eşleşme Pusula'daki İcbari Sigorta Fiyat Listesi'nden geliyor, hazır.
        <strong>Medigate</strong> = bizim önerimiz, henüz Pusula'ya işlenmedi.
        <strong>aday seç</strong> = algoritmanın bulduğu yakın kodlar -- öneri değil, aday; kararı siz verirsiniz.
        <strong>elle</strong> = bu ekrandan girildi.
        <strong>gönderilmez</strong> = tıbbi işlem değil (yatak ücreti, kafeterya, refakatçi), bakanlığa hiç gitmez.
        Bu tablo Pusula'ya <em>yazmaz</em>; asıl eşleştirme Pusula'da yapılır.
    </p>
</div>

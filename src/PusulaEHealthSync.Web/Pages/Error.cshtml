@page
@model ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Bir hata oluştu</h1>
        <p class="page-subtitle">İşlem tamamlanamadı. Aşağıdaki mesaj sorunun nedenini gösteriyor.</p>
    </div>
</div>

<div class="card card-pad" style="max-width:900px;">
    @if (Model.ExceptionMessage is not null)
    {
        <p class="section-title">Hata mesajı</p>
        <p class="card-desc" style="color:var(--danger); font-weight:500; font-size:15px;">@Model.ExceptionMessage</p>
        <p class="text-muted" style="font-size:12px; margin-top:2px;">@Model.ExceptionType</p>
    }
    else
    {
        <p class="card-desc">Beklenmeyen bir hata oluştu ama teknik detay yakalanamadı.</p>
    }

    <div style="display:flex; flex-direction:column; gap:4px; margin-top:14px;">
        @if (!string.IsNullOrEmpty(Model.ExceptionPath))
        {
            <p class="text-muted" style="font-size:12.5px; margin:0;">Sayfa: <code>@Model.ExceptionPath</code></p>
        }
        @if (Model.ShowRequestId)
        {
            <p class="text-muted" style="font-size:12.5px; margin:0;">İstek No: <code>@Model.RequestId</code></p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ExceptionDetail))
    {
        <details style="margin-top:16px;">
            <summary class="text-muted" style="cursor:pointer; font-size:12.5px;">Teknik detay (geliştiriciyle paylaşmak için)</summary>
            <div class="json-panel" style="margin-top:10px;">
                <pre class="json-block">@Model.ExceptionDetail</pre>
            </div>
        </details>
    }
</div>

<p style="margin-top:16px;"><a asp-page="/Index" class="btn btn-outline btn-sm">&larr; Protokol Listesi'ne dön</a></p>

@page
@model PusulaEHealthSync.Web.Pages.BekleyenIslerModel
@using PusulaEHealthSync.Persistence
@using PusulaEHealthSync.Web
@{
    ViewData["Title"] = "Bekleyen İşler";
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    string N(int x) => x.ToString("N0", tr);
}

@* ===== YENI DUZEN (2026-10-27) =====
   KULLANICI: "cok fazla sayi var, insan hicbir sey anlamiyor, daha ozet bir ekran olsun".
   Tasarim tuvalinde A (akis: protokol nerede bekliyor) ile C (bu protokol neden gitmedi?)
   secildi. Eski kalem/protokol kartlari ve uzun listeler en altta, katlanmis. *@

<div class="bk-sayfa">
<p class="breadcrumb"><a asp-page="/Index">Protokol Listesi</a> / Bekleyen İşler</p>
<div class="page-header">
    <div>
        <h1 class="page-title">Bekleyen İşler</h1>
        <p class="page-subtitle">Pusula'da hazır olup TRƏS'e gitmemiş olanlar · bu sayfa hiçbir şey göndermez</p>
    </div>
    <form method="post" asp-page-handler="Yenile" class="bk-arac">
        <partial name="_TarihSecici" model="Model.TarihSecici" />
        <button type="submit" class="btn btn-primary">Yeniden Hesapla</button>
    </form>
</div>

@if (Model.UyariMesaji is not null)
{
    <div class="alert alert-warning" style="margin-bottom:14px;">@Model.UyariMesaji</div>
}

@if (Model.Sonuc is null || Model.Dokum is null)
{
    <div class="empty-state">
        <p>Henüz hesaplanmadı.</p>
        <p class="text-muted">
            Seçili aralık:
            <strong>@Model.EtkinBaslangic.ToString("dd.MM.yyyy") - @Model.EtkinBitis.ToString("dd.MM.yyyy")</strong>
        </p>
        <p class="text-muted">
            Tam tarama canlı veride birkaç saniye ile birkaç dakika arası sürüyor, bu yüzden sayfa her açılışta hesaplamıyor.
            Yukarıdaki <strong>Yeniden Hesapla</strong> ile başlatabilirsiniz.
        </p>
    </div>
}
else
{
    var d = Model.Dokum;
    var kapsam = Model.Sonuc.Kapsam;
    var hazir = d.Grup("hazir");
    var hazirSayi = hazir?.Protokol ?? 0;
    var turSayisi = Model.PartiBoyutu <= 0 ? 0 : (hazirSayi + Model.PartiBoyutu - 1) / Model.PartiBoyutu;
    var bugun = DateTime.Today;
    string EnEski(SebepGrubu g) => g.EnEski is { } t ? $"{Math.Max(0, (bugun - t.Date).Days)} gün" : "—";

    <p class="bk-durum">
        Son hesaplama <strong>@(Model.SonHesaplamaUtc is null ? "-" : AzTime.ToLocal(Model.SonHesaplamaUtc.Value).ToString("dd.MM.yyyy HH:mm"))</strong>
        · <strong>@Model.EtkinBaslangic.ToString("dd.MM.yyyy") – @Model.EtkinBitis.ToString("dd.MM.yyyy")</strong>
        · otomatik gönderim @if (Model.OtomatikGonderimAcik) { <strong class="text-success">açık</strong> } else { <strong class="text-danger">kapalı</strong> }
        · @if (Model.Ortam == "Live") { <span class="badge danger"><span class="badge-dot"></span>CANLI</span> } else { <span class="badge neutral"><span class="badge-dot"></span>Test / Sandbox</span> }
    </p>

    @if (d.Kirpik)
    {
        <div class="alert alert-warning">Bu sonuç kırpılmış bir taramadan geliyor; sayılar eksik olabilir. <strong>Yeniden Hesapla</strong> ile tam tarama yapın.</div>
    }

    @* ===== OZET: TEK CUMLE + TEK CUBUK ===== *@
    <section class="card bk-ozet">
        <p class="bk-cumle">
            <strong class="num">@N(d.Taranan)</strong> protokolün <strong class="num text-success">@N(d.Tamam)</strong>'i tamamen gitti.
            <strong class="num bk-mavi">@N(d.SiradaToplam)</strong> protokol sırasını bekliyor — kendiliğinden gidecek.
            <strong class="num text-danger">@N(d.MudahaleToplam)</strong> protokolde birinin bir şey yapması gerekiyor.
        </p>
        @* Dort parca toplami = taranan (her protokol en agir asamasinda bir kez; bkz.
           BekleyenDokum). Genel Bakis'in hatti ve kirilimi ayni sayilari gosteriyor. *@
        @{
            var parcalar = new[] { (d.Tamam, "bk-r-tamam", "Tamam"), (d.SiradaToplam, "bk-r-sira", "Sırasını bekliyor"),
                                   (d.MudahaleToplam, "bk-r-takili", "Müdahale gerekiyor"), (d.KapsamDisi, "bk-r-dis", "Kapsam dışı") };
        }
        <div class="bk-cubuk" role="img" aria-label="Protokollerin dağılımı">
            @foreach (var (sayi, sinif, _) in parcalar.Where(x => x.Item1 > 0))
            {
                <span class="@sinif" style="flex:@sayi"></span>
            }
        </div>
        <ul class="bk-lejant">
            @foreach (var (sayi, sinif, ad) in parcalar)
            {
                <li><span class="bk-nokta @sinif" aria-hidden="true"></span>@ad <strong class="num">@N(sayi)</strong></li>
            }
        </ul>
        @if (d.KapsamDisi > 0)
        {
            <p class="bk-dipnot">Kapsam dışı: reçete ve iptal protokolleri, devreye alım tarihinden önce açılanlar — gönderilmezler.</p>
        }
    </section>

    @* ===== DORT ASAMA ===== *@
    var asamalar = new[]
    {
        (Asama.Hazir, "1 · Hazır", "bk-a-hazir", $"sıradaki turlarda gider" + (turSayisi > 1 ? $" (~{turSayisi} tur)" : "")),
        (Asama.Kural, "2 · Kural gereği bekliyor", "bk-a-kural", "süresi dolunca kendiliğinden gider"),
        (Asama.PusulaIsi, "3 · Pusula'da iş bekliyor", "bk-a-pusula", "onay, rapor, epikriz yazılınca gider"),
        (Asama.Veri, "4 · Veri düzeltilmeli", "bk-a-veri", "düzeltilmezse hiç gitmez"),
    };
    <div class="bk-asamalar">
        @foreach (var (a, ad, sinif, alt) in asamalar)
        {
            @if (a == Asama.Hazir)
            {
                <button type="button" class="bk-asama @sinif" onclick="bkListele('hazir')" @(hazirSayi == 0 ? "disabled" : "")>
                    <span class="bk-asama-ad">@ad</span>
                    <span class="bk-asama-sayi num">@N(d.AsamaSayisi(a))</span>
                    <span class="bk-asama-alt">@alt</span>
                </button>
            }
            else
            {
                <a class="bk-asama @sinif" href="#asama-@((int)a)">
                    <span class="bk-asama-ad">@ad</span>
                    <span class="bk-asama-sayi num">@N(d.AsamaSayisi(a))</span>
                    <span class="bk-asama-alt">@alt</span>
                </a>
            }
        }
    </div>
    <p class="bk-dipnot">Her protokol en ağır sebebiyle bir kez sayılır (Veri &gt; Pusula işi &gt; Kural &gt; Hazır); dört kart ile Tamam ve Kapsam dışı toplandığında taranan protokol sayısı çıkar. Aşağıdaki sebep tablolarında ise bir protokol, birden fazla sebebi varsa her birinde görünür.</p>

    @* ===== BU PROTOKOL NEDEN GITMEDI? (tasarim C) ===== *@
    <section class="card bk-sorgu">
        <form method="get" class="bk-sorgu-form" onsubmit="bkNeden(event)">
            <label for="bk-q" class="bk-sorgu-baslik">Bu protokol neden gitmedi?</label>
            <div class="bk-sorgu-satir">
                <input id="bk-q" name="q" type="search" autocomplete="off" placeholder="Protokol no, hasta adı ya da FIN" />
                <button type="submit" class="btn btn-primary">Sorgula</button>
            </div>
        </form>
        <div id="bk-neden" aria-live="polite"></div>
    </section>

    @* ===== ASAMA TABLOLARI (tasarim A; protokol sutunundaki cubuk tasarim C'den) ===== *@
    @foreach (var (a, ad, sinif, _) in asamalar.Where(x => x.Item1 != Asama.Hazir))
    {
        var gruplar = d.AsamaGruplari(a).ToList();
        var kural = a == Asama.Kural;
        var enCok = gruplar.Count == 0 ? 1 : Math.Max(1, gruplar.Max(g => g.Protokol));
        var (no, baslik) = (ad[..1], ad[4..]);
        <section class="bk-tablo @sinif" id="asama-@((int)a)">
            <h2 class="bk-tablo-baslik">
                <span><span class="bk-no">@no</span> · @baslik</span>
                @if (kural) { <a asp-page="/Ayarlar" class="bk-tablo-link">Ayarlar › Otomatik Gönderim</a> }
            </h2>
            @if (gruplar.Count == 0)
            {
                <p class="bk-bos">Bu aşamada bekleyen protokol yok.</p>
            }
            else
            {
                <div class="bk-kaydir">
                <table class="bk-t">
                    <thead>
                        <tr>
                            <th>@(kural ? "Kural" : "Sebep")</th>
                            <th class="bk-t-cubuk">Protokol</th>
                            @if (!kural) { <th class="num-col">Kalem</th> }
                            <th>@(kural ? "Ne zaman gider" : "Kim")</th>
                            <th>En eski</th>
                            <th><span class="sr-only">Liste</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var g in gruplar)
                    {
                        <tr>
                            <td>@g.Etiket</td>
                            <td class="bk-t-cubuk">
                                <span class="bk-mini"><span style="width:@((g.Protokol * 100.0 / enCok).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                                <span class="num">@N(g.Protokol)</span>
                            </td>
                            @if (!kural) { <td class="num-col num">@N(g.Kalem)</td> }
                            <td>@(kural ? g.NeZaman : g.Kim)</td>
                            <td class="text-muted">@EnEski(g)</td>
                            <td class="bk-eylem"><button type="button" class="bk-link" onclick="bkListele('@g.Anahtar')">Listele</button></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    }

    @* ===== ESKI AYRINTILAR -- KATLANMIS ===== *@
    <details class="card bk-ayrinti">
        <summary>Ayrıntılı sayılar ve protokol listeleri</summary>

        <div class="stat-grid" style="margin-top:14px">
            <div class="stat-card success"><div class="stat-label">Gönderilen kalem</div><div class="stat-value success">@N(kapsam.GonderilmisKalem)</div><div class="stat-foot">taranan @N(kapsam.TarananKalem) kalemin %@kapsam.GonderilmisKalemYuzde'i</div></div>
            <div class="stat-card warning"><div class="stat-label">Bekleyen kalem</div><div class="stat-value warning">@N(kapsam.BekleyenKalem)</div><div class="stat-foot">@N(Model.Sonuc.ToplamProtokolSayisi) protokolde</div></div>
            <div class="stat-card danger"><div class="stat-label">Takılan kalem</div><div class="stat-value danger">@N(kapsam.TakilanKalem)</div><div class="stat-foot">@N(Model.Sonuc.ToplamTakilanProtokolSayisi) protokolde</div></div>
            <div class="stat-card"><div class="stat-label">Kısmen gönderilmiş protokol</div><div class="stat-value">@N(kapsam.KismenGonderilmisProtokol)</div><div class="stat-foot">hiç gönderilmemiş: @N(kapsam.HicGonderilmemisProtokol)</div></div>
        </div>

        <p class="text-muted" style="margin:14px 0 0; font-size:13px;">
            <strong>Aktivite Akışı'ndaki sayılarla karşılaştırmayın:</strong> orası o tarihte yapılan denemelerin sonucunu,
            burası Pusula'da hazır olup hâlâ gitmemiş olanı gösterir.
        </p>

        @if (Model.Sonuc.Protokoller.Count > 0)
        {
            <p class="section-title" style="margin-top:22px">Bekleyen protokoller — gönderim sırasıyla (ilk @N(Math.Min(Model.Sonuc.Protokoller.Count, BekleyenIslerModel.AyrintiSatirSiniri)) / @N(Model.Sonuc.Protokoller.Count))</p>
            <div class="table-wrap">
            <table>
                <thead><tr><th>Protokol</th><th>Hasta</th><th>Tip</th><th>Bekleyen kalemler</th><th>Durum</th></tr></thead>
                <tbody>
                @{ var uygunSira = 1; }
                @foreach (var p in Model.Sonuc.Protokoller.Take(BekleyenIslerModel.AyrintiSatirSiniri))
                {
                    <tr>
                        <td class="mono">
                            <a asp-page="/Protokol" asp-route-id="@p.Protokol.ProtokolId">@p.Protokol.ProtokolId</a>
                            <div class="text-muted">@(p.Protokol.AcilisTarihi?.ToString("dd.MM.yyyy") ?? "-")</div>
                        </td>
                        <td>@p.Protokol.HastaAdiSoyadi<div class="text-muted mono">@p.Protokol.Fin</div></td>
                        <td>@(p.Protokol.GelisTipiId switch { "Y" => "Yatan", "G" => "Günübirlik", _ => "Ayaktan" })</td>
                        <td>
                            @foreach (var grup in p.Items.GroupBy(i => i.Baslik).OrderByDescending(g => g.Count()))
                            {
                                <span class="badge neutral">@grup.Key @(grup.Count() > 1 ? $"({grup.Count()})" : "")</span>
                            }
                        </td>
                        <td>
                            @if (p.Eligible)
                            {
                                var tur = Model.PartiBoyutu <= 0 ? 1 : (uygunSira + Model.PartiBoyutu - 1) / Model.PartiBoyutu;
                                <span class="badge warning"><span class="badge-dot"></span>@(tur == 1 ? "Sıradaki turda" : "Gönderim bekliyor")</span>
                                <div class="text-muted">Sırada @uygunSira. @(tur > 1 ? $"— yaklaşık {tur}. turda ({SureMetni(tur * Model.TurAraligiDakika)})" : "")</div>
                                uygunSira++;
                            }
                            else
                            {
                                <span class="badge neutral"><span class="badge-dot"></span>Henüz uygun değil</span>
                                <div class="text-muted">@p.NotEligibleReason</div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }

        @if (Model.Sonuc.TakilanProtokoller.Count > 0)
        {
            <p class="section-title" style="margin-top:22px">Takılı protokoller (ilk @N(Math.Min(Model.Sonuc.TakilanProtokoller.Count, BekleyenIslerModel.AyrintiSatirSiniri)) / @N(Model.Sonuc.TakilanProtokoller.Count))</p>
            <div class="table-wrap">
            <table>
                <thead><tr><th>Protokol</th><th>Hasta</th><th>Takılan kalemler</th><th>Sebep</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Sonuc.TakilanProtokoller.Take(BekleyenIslerModel.AyrintiSatirSiniri))
                {
                    <tr>
                        <td class="mono">
                            <a asp-page="/Protokol" asp-route-id="@p.Protokol.ProtokolId">@p.Protokol.ProtokolId</a>
                            <div class="text-muted">@(p.Protokol.AcilisTarihi?.ToString("dd.MM.yyyy") ?? "-")</div>
                        </td>
                        <td>@p.Protokol.HastaAdiSoyadi<div class="text-muted mono">@p.Protokol.Fin</div></td>
                        <td>
                            @foreach (var grup in p.Items.GroupBy(i => i.Baslik).OrderByDescending(g => g.Count()))
                            {
                                <span class="badge neutral">@grup.Key @(grup.Count() > 1 ? $"({grup.Count()})" : "")</span>
                            }
                        </td>
                        <td class="text-muted">
                            @string.Join(" · ", p.Items.Select(i => BekleyenDokum.TakiliSebebi(p, i).Etiket).Distinct())
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    </details>

    <dialog id="gb-liste" class="gb-liste-pencere" aria-labelledby="gb-liste-baslik">
        <div class="gb-liste-icerik"></div>
    </dialog>

    <script>
        // Sayfa parametreleri ayni kalsin diye handler'lar mevcut adrese eklenir.
        function bkAdres(handler, params) {
            const u = new URL(location.href);
            u.searchParams.set('handler', handler);
            for (const [k, v] of Object.entries(params)) u.searchParams.set(k, v);
            return u;
        }
        // Hata metni duz metin olarak yazilir (innerHTML degil).
        function bkMesaj(kap, etiket, sinif, metin) {
            const el = document.createElement(etiket);
            el.className = sinif;
            el.textContent = metin;
            kap.replaceChildren(el);
        }
        async function bkListele(anahtar) {
            const pencere = document.getElementById('gb-liste');
            const icerik = pencere.querySelector('.gb-liste-icerik');
            icerik.innerHTML = '<div class="gb-liste-yukleniyor">Liste hazırlanıyor…</div>';
            if (!pencere.open) pencere.showModal();
            try {
                const r = await fetch(bkAdres('Liste', { anahtar }), { headers: { 'X-Requested-With': 'fetch' } });
                if (!r.ok) throw new Error('HTTP ' + r.status);
                icerik.innerHTML = await r.text();
            } catch (e) {
                bkMesaj(icerik, 'div', 'gb-liste-yukleniyor', 'Liste alınamadı (' + e.message + ').');
            }
        }
        document.getElementById('gb-liste').addEventListener('click', e => {
            if (e.target === e.currentTarget) e.currentTarget.close();
        });
        function bkListeAra(kutu) {
            const aranan = kutu.value.trim().toLocaleLowerCase('tr');
            kutu.closest('.gb-liste-icerik').querySelectorAll('tbody tr').forEach(tr => {
                tr.hidden = aranan !== '' && !tr.textContent.toLocaleLowerCase('tr').includes(aranan);
            });
        }
        async function bkNeden(e) {
            e.preventDefault();
            const q = document.getElementById('bk-q').value.trim();
            const hedef = document.getElementById('bk-neden');
            if (!q) { hedef.innerHTML = ''; return; }
            hedef.innerHTML = '<p class="text-muted">Aranıyor…</p>';
            try {
                const r = await fetch(bkAdres('Neden', { q }), { headers: { 'X-Requested-With': 'fetch' } });
                if (!r.ok) throw new Error('HTTP ' + r.status);
                hedef.innerHTML = await r.text();
            } catch (err) {
                bkMesaj(hedef, 'p', 'text-muted', 'Sorgulanamadı (' + err.message + ').');
            }
        }
    </script>
}

</div>

@functions {
    // Dakikayi okunur sureye cevirir. 180 dakika yerine "3 saat" yazmak, zaten tahmini
    // olan bir sayiyi okunur kiliyor. 48 saati asarsa gun, cunku "73 saat" de okunmuyor.
    static string SureMetni(int dakika) => dakika switch
    {
        < 120 => $"~{dakika} dk",
        < 2880 => $"~{dakika / 60} saat",
        _ => $"~{dakika / 1440} gün",
    };
}

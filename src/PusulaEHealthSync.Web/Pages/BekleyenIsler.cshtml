@page
@model PusulaEHealthSync.Web.Pages.BekleyenIslerModel
@using PusulaEHealthSync.Persistence
@{
    ViewData["Title"] = "Bekleyen İşler";
    ViewData["Genis"] = true;   // 10+ sutunlu veri tablosu -- genislik sinirindan muaf
}

<p class="breadcrumb"><a asp-page="/Index">Protokol Listesi</a> / Bekleyen İşler</p>
<div class="page-header">
    <div>
        <h1 class="page-title">Bekleyen İşler</h1>
        <p class="page-subtitle">Pusula'da sonuçlanmış ama TRƏS'e henüz gönderilmemiş kayıtlar -- bu sayfa hiçbir şey göndermez</p>
    </div>
    <form method="post" asp-page-handler="Yenile" class="filter-bar" style="margin:0; gap:10px; align-items:flex-end;">
        <div class="field" style="margin:0;">
            <label for="baslangic">Başlangıç</label>
            <input type="date" id="baslangic" name="Baslangic" value="@Model.EtkinBaslangic.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field" style="margin:0;">
            <label for="bitis">Bitiş</label>
            <input type="date" id="bitis" name="Bitis" value="@Model.EtkinBitis.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">Yeniden Hesapla</button>
    </form>
</div>

@if (Model.UyariMesaji is not null)
{
    <div class="alert alert-warning" style="margin-bottom:14px;">@Model.UyariMesaji</div>
}

@if (Model.Sonuc is null)
{
    <div class="empty-state">
        <p>Henüz hesaplanmadı.</p>
        <p class="text-muted">
            Seçili aralık:
            <strong>@Model.EtkinBaslangic.ToString("dd.MM.yyyy") - @Model.EtkinBitis.ToString("dd.MM.yyyy")</strong>
        </p>
        <p class="text-muted">
            Tam tarama canlı veride yaklaşık 15 saniye sürüyor, bu yüzden sayfa her açılışta hesaplamıyor.
            Yukarıdaki <strong>Yeniden Hesapla</strong> ile başlatabilirsiniz; otomatik gönderim açıksa
            her turda kendiliğinden tazelenir.
        </p>
    </div>
}
else
{
    <div class="filter-bar">
        <span>
            Son hesaplama:
            <strong>@(Model.SonHesaplamaUtc is null ? "-" : AzTime.ToLocal(Model.SonHesaplamaUtc.Value).ToString("yyyy-MM-dd HH:mm"))</strong>
            &middot; <strong>@Model.EtkinBaslangic.ToString("dd.MM.yyyy") - @Model.EtkinBitis.ToString("dd.MM.yyyy")</strong> aralığı taranıyor
        </span>
        <span>
            Otomatik gönderim:
            @if (Model.OtomatikGonderimAcik)
            {
                <strong>açık</strong>
            }
            else
            {
                <strong class="text-muted">kapalı</strong>
                <text>-- Ayarlar sayfasından açabilirsiniz</text>
            }
        </span>
        <span>
            @* Otomatik gönderim CANLI ortama yazarken bunun ekranda tahmine bırakılmaması
               gerekiyor -- rozet hem kelimeyle hem renkle söylüyor. *@
            Ortam:
            @if (Model.Ortam == "Live")
            {
                <span class="badge danger"><span class="badge-dot"></span>CANLI</span>
            }
            else
            {
                <span class="badge neutral"><span class="badge-dot"></span>Test / Sandbox</span>
            }
        </span>
    </div>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-label">Bekleyen protokol</div>
            <div class="stat-value">@Model.Sonuc.ToplamProtokolSayisi</div>
        </div>
        @foreach (var kv in Model.Sonuc.OzetSayimlar.OrderByDescending(k => k.Value))
        {
            <div class="stat-card">
                <div class="stat-label">@kv.Key</div>
                <div class="stat-value">@kv.Value</div>
            </div>
        }
    </div>

    @if (Model.Sonuc.Protokoller.Count == 0)
    {
        <div class="empty-state"><p>Bekleyen iş yok -- her şey gönderilmiş görünüyor.</p></div>
    }
    else
    {
        <p class="text-muted" style="margin:16px 0 8px">
            En eski bekleyen kayıt önce olmak üzere @Model.Sonuc.Protokoller.Count protokol listeleniyor
            (toplam @Model.Sonuc.ToplamProtokolSayisi).
        </p>
        <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Protokol</th>
                    <th>Hasta</th>
                    <th>Tip</th>
                    <th>Bekleyen kalemler</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Sonuc.Protokoller)
            {
                <tr>
                    <td class="mono">
                        <a asp-page="/Protokol" asp-route-id="@p.Protokol.ProtokolId">@p.Protokol.ProtokolId</a>
                        <div class="text-muted">@(p.Protokol.AcilisTarihi?.ToString("dd.MM.yyyy") ?? "-")</div>
                    </td>
                    <td>
                        @p.Protokol.HastaAdi @p.Protokol.HastaSoyadi
                        <div class="text-muted mono">@p.Protokol.Fin</div>
                    </td>
                    <td>
                        @(p.Protokol.GelisTipiId switch { "Y" => "Yatan", "G" => "Günübirlik", _ => "Ayaktan" })
                    </td>
                    <td>
                        @foreach (var grup in p.Items.GroupBy(i => i.Baslik).OrderByDescending(g => g.Count()))
                        {
                            <span class="badge neutral">@grup.Key @(grup.Count() > 1 ? $"({grup.Count()})" : "")</span>
                        }
                    </td>
                    <td>
                        @if (p.Eligible)
                        {
                            <span class="badge warning"><span class="badge-dot"></span>Gönderim bekliyor</span>
                        }
                        else
                        {
                            <span class="badge neutral"><span class="badge-dot"></span>Henüz uygun değil</span>
                            <div class="text-muted">@p.NotEligibleReason</div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }

    @* ============ TAKILANLAR (2026-10-03) ============
       KULLANICI KARARI: "bekleyenleri ayrı bir listeye alalım. onlar için ayrıca deneme
       yapsın. bizim ana gönderim listesine sayıları hiç karışmasın."

       Buradakiler MEVCUT VERIYLE gonderilemeyen kalemler: LOINC kodu olmayan tetkik,
       sonuc degeri bos panel satiri, Icbari eslesmesi olmayan hizmet, ya da ust uste
       basarisiz olmus kayit. Yukaridaki sayilara KARISMIYORLAR -- karissalardi "bekleyen
       is" sayisi hicbir zaman azalmayan, anlamsiz bir rakam olurdu (olculdu: 30 gunde
       4.289 protokol).

       Otomatik dongu bunlari saatlik turda HIC denemiyor; gunde bir kez, gece kendi
       turunda deniyor (bkz. AutoSyncWorker.TakilanlariDeneAsync). Yani eksik giderilince
       kayit kendiliginden gider, elle is gerekmez. *@
    @if (Model.Sonuc.ToplamTakilanProtokolSayisi > 0)
    {
        <p class="section-title" style="margin-top:28px">Takılanlar</p>
        <div class="alert alert-warning" style="margin-bottom:12px">
            <strong>@Model.Sonuc.ToplamTakilanProtokolSayisi protokolde</strong>, mevcut Pusula verisiyle
            gönderilemeyecek kalem var. Yukarıdaki sayılara dahil <strong>değiller</strong>.
            Otomatik gönderim bunları saatlik turda denemez; günde bir kez, gece yeniden dener —
            eksik giderildiğinde kayıt kendiliğinden gider.
        </div>

        <div class="stat-grid">
            @foreach (var kv in Model.Sonuc.TakilanOzetSayimlar.OrderByDescending(k => k.Value))
            {
                <div class="stat-card">
                    <div class="stat-label">@kv.Key</div>
                    <div class="stat-value">@kv.Value</div>
                </div>
            }
        </div>

        <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Protokol</th>
                    <th>Hasta</th>
                    <th>Takılan kalemler</th>
                    <th>Sebep</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Sonuc.TakilanProtokoller)
            {
                <tr>
                    <td class="mono">
                        <a asp-page="/Protokol" asp-route-id="@p.Protokol.ProtokolId">@p.Protokol.ProtokolId</a>
                        <div class="text-muted">@(p.Protokol.AcilisTarihi?.ToString("dd.MM.yyyy") ?? "-")</div>
                    </td>
                    <td>
                        @p.Protokol.HastaAdi @p.Protokol.HastaSoyadi
                        <div class="text-muted mono">@p.Protokol.Fin</div>
                    </td>
                    <td>
                        @foreach (var grup in p.Items.GroupBy(i => i.Baslik).OrderByDescending(g => g.Count()))
                        {
                            <span class="badge neutral">@grup.Key @(grup.Count() > 1 ? $"({grup.Count()})" : "")</span>
                        }
                    </td>
                    <td>
                        @* En sik gorulen sebep: yirmi kalem ayni eksikten takildiysa yirmi
                           satir degil tek cumle gosterilmeli. *@
                        @{
                            var sebep = p.Items
                                .Where(i => i.SonDeneme?.Message is not null)
                                .GroupBy(i => SyncLogEntry.FriendlyError(i.SonDeneme!.Message))
                                .OrderByDescending(g => g.Count())
                                .Select(g => g.Key)
                                .FirstOrDefault();
                        }
                        <div class="text-muted">@(sebep ?? "Sebep kayıtlı değil.")</div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
}

@page
@model PusulaEHealthSync.Web.Pages.GenelBakisModel
@{
    ViewData["Title"] = "Genel Bakış";
    var o = Model.Ozet;
    var k = Model.Kapsam;
    var fromIso = Model.PeriodFromDate.ToString("yyyy-MM-dd");
    var toIso = Model.PeriodToDate.ToString("yyyy-MM-dd");
    var todayIso = Model.Today.ToString("yyyy-MM-dd");

    // BIRIM ALT SATIRI tek yerden -- ekrandaki her protokol rakami altinda ayni bicimde
    // "N kayit - M satir" gorunsun diye. Birimini soylemeyen bir sayi bu projede yanlis
    // sayidan daha cok kafa karistirdi (bkz. GenelBakis.cshtml.cs basindaki not).
    // CSS GENISLIGI KULTURDEN BAGIMSIZ (2026-10-24, kullanici: "100 olunca yesil oluyor,
    // onun disinda yok"). double'i dogrudan yazinca tr-TR "50,5" uretiyordu; tarayici
    // "width:50,5%"i gecersiz sayip atiyordu -- yalnizca tam sayi olan %100 cizilebiliyordu.
    Func<double, string> css = v => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    Func<int, int, string> birim = (kayit, satir) =>
        $"{kayit.ToString("N0")} kayıt · {satir.ToString("N0")} satır";

    // Ust seritteki bir sebep kutucugu -- eksik ve hata sebepleri AYNI bicimde
    // cizilsin diye tek yerde. Eskiden iki blok ayri ayri yazilmisti ve ikisi
    // birbirinden yavasca ayrismisti.
    Func<PusulaEHealthSync.Web.Pages.GenelBakisModel.SebepSatiri, string> sebepSayisi =
        s => s.Protokol > 0 ? $"{s.Protokol:N0}" : $"{s.Kayit:N0}";
}

@* ======================= UST: BASLIK + DONEM =======================
   2026-10-24 yeniden duzen: tasarim tuvalindeki A yonu ("Hat") + B'nin ust durum alani.
   IKI AYRI FORM, BILINCLI OLARAK. Radyo dugmeleri ile <select> ayni formda ayni
   ad ("Donem") ile dursaydi tarayici IKISINI BIRDEN gonderirdi
   ("Donem=7&Donem=ay:2026-10") ve model baglama bunlari virgulle birlestirip ikisini
   de bozardi. Ayri formlar bu belirsizligi hic dogurmuyor ve JS gerektirmiyor. *@
<div class="gb-ust">
    <div>
        <p class="gb-ust-ust">Pusula &rarr; TRƏS &middot; yalnızca canlı gönderimler</p>
        <h1 class="page-title" style="margin:0;">Genel Bakış</h1>
    </div>
    <div class="gb-bar" style="margin:0;">
        <form method="get" class="segmented" style="margin-bottom:0;">
            <input type="radio" id="dGun" name="Donem" value="0" checked="@(Model.Donem == "0")" onchange="this.form.submit()" /><label for="dGun">Bugün</label>
            <input type="radio" id="dHafta" name="Donem" value="7" checked="@(!Model.AySecili && Model.Donem != "0" && Model.Donem != "30")" onchange="this.form.submit()" /><label for="dHafta">Son 7 Gün</label>
            <input type="radio" id="dAy" name="Donem" value="30" checked="@(Model.Donem == "30")" onchange="this.form.submit()" /><label for="dAy">Son 30 Gün</label>
        </form>

        <form method="get" class="gb-ay">
            <label for="aySec">Ay seç</label>
            <select id="aySec" name="Donem" onchange="this.form.submit()">
                <option value="" selected="@(!Model.AySecili)">&mdash; ay seçilmedi &mdash;</option>
                @foreach (var a in Model.AylarListesi)
                {
                    <option value="@a.Deger" selected="@a.Secili">@a.Etiket</option>
                }
            </select>
        </form>

        <span class="gb-aralik">
            @Model.PeriodFromDate.ToString("dd.MM.yyyy") &ndash; @Model.PeriodToDate.ToString("dd.MM.yyyy")
            <span class="gb-aralik-not">@((Model.PeriodToDate.DayNumber - Model.PeriodFromDate.DayNumber + 1)) gün</span>
        </span>
    </div>
</div>

@* ======================= GONDERIM DURUMU (B'nin ust alani) =======================
   Aktivite Akisi seridiyle AYNI veri ve AYNI hukum sirasi (bkz. _AktiviteSerit):
   servis durgunsa her seyden once o soylenir. Donemden bagimsiz -- "su an". *@
@{
    var sr = Model.Serit;
    var (hukumCss, hukum) =
        sr.ServisDurgun ? ("hata", "Gönderim servisi çalışmıyor")
        : sr.Durduruluyor ? ("eksik", "Durduruluyor")
        : sr.Acik && sr.TurSuruyor ? ("ok", "Gönderim çalışıyor")
        : sr.Acik ? ("ok", "Gönderim çalışıyor · tur arası")
        : ("yok", "Otomatik gönderim kapalı");
}
<section class="gb-hukum gb-hukum--@hukumCss" aria-label="Otomatik gönderimin şu anki durumu">
    <div class="gb-hukum-ust">
        <div class="gb-hukum-sol">
            <p class="gb-hukum-etiket">Otomatik gönderim &middot; ortam @(sr.Canli ? "Canlı" : "Sandbox (Test)")</p>
            <h2 class="gb-hukum-baslik"><span class="gb-hukum-nokta" aria-hidden="true"></span>@hukum</h2>
            <p class="gb-hukum-cumle">
                @if (sr.ServisDurgun)
                {
                    <text>Servisten @(sr.NabizUtc is { } n ? AzTime.ToLocal(n).ToString("dd.MM HH:mm") + " sonrasında" : "hiç") nabız gelmedi &mdash; gönderim yapılmıyor.
                    <a asp-page="/ServisDurumu">Servis Durumu</a> sayfasından yeniden başlatılabilir.</text>
                }
                else
                {
                    @if (sr.TurSuruyor)
                    {
                        <text>Tur <span class="num">#@sr.TurNo</span> sürüyor: <span class="num">@sr.Islenen / @sr.Hedef</span> protokol işlendi. </text>
                    }
                    else if (sr.SonTurUtc is { } son)
                    {
                        <text>Son tur <span class="num">@AzTime.ToLocal(son).ToString("HH:mm")</span> itibarıyla bitti@(sr.SonTurHatali ? " ve hata verdi" : ""). </text>
                    }
                    @if (sr.Acik && !sr.TurSuruyor && sr.SonrakiTurUtc is { } sonraki)
                    {
                        <text>Sıradaki tur <span class="num">@AzTime.ToLocal(sonraki).ToString("HH:mm")</span>. </text>
                    }
                    @if (sr.Bekleyen > 0)
                    {
                        <text>Gönderime uygun <span class="num gb-hukum-vurgu">@sr.Bekleyen.ToString("N0")</span> protokol sırada. </text>
                    }
                    @if (!sr.Acik)
                    {
                        <text>Açmak için <a asp-page="/Ayarlar">Ayarlar</a>.</text>
                    }
                }
            </p>
        </div>
        <dl class="gb-hukum-sayilar">
            <div><dt>Tur aralığı</dt><dd class="num">@sr.AralikDakika<small> dk</small></dd></div>
            <div><dt>Son 12 saat</dt><dd class="num">@Model.Son12SaatProtokol.ToString("N0")<small> protokol</small></dd></div>
            <div><dt>Son nabız</dt><dd class="num">@(sr.NabizUtc is { } nb ? AzTime.ToLocal(nb).ToString(AzTime.ToLocal(nb).Date == DateTime.Today ? "HH:mm" : "dd.MM HH:mm") : "—")</dd></div>
        </dl>
    </div>

    @* SON 12 SAAT -- tur gecmisi saklanmadigi icin ritim gunlukten: saat basina dokunulan
       protokol. Hata alan protokolu olan saat kirmizi. Bos saat = o saatte gonderim yok. *@
    <div class="gb-hukum-saatler">
        <p class="gb-hukum-etiket">Son 12 saat &middot; saat başına gönderilen protokol</p>
        @* 2026-10-24 DUZELTME (kullanici: "sutunlar cizgi gibi, anlami yok"): tek bir yogun
           saat olcegi ezip digerlerini cizgiye ceviriyordu, ve tek hatali protokol butun
           cubugu kirmiziya boyuyordu. Artik: (1) sayi her cubugun USTUNDE yazili -- boy tek
           basina anlam tasimiyor; (2) gonderim olan saat en az %18 boyda; (3) cubuk iki
           parcali, yalnizca hata alan pay kirmizi. *@
        <ol class="gb-saatler" aria-label="Son 12 saatte saat başına gönderilen protokol; toplam @Model.Son12SaatProtokol">
            @foreach (var h in Model.Saatler)
            {
                // Boy PIKSEL (en fazla 56px, gonderim olan saatte en az 10px) -- sayi etiketi
                // cubugun hemen ustunde durabilsin diye yuzde degil.
                var boy = h.Protokol == 0 || Model.SaatMaks == 0 ? 0 : Math.Max(10, h.Protokol * 56.0 / Model.SaatMaks);
                var hataPay = h.Protokol == 0 ? 0 : h.HataliProtokol * 100.0 / h.Protokol;
                var inv = System.Globalization.CultureInfo.InvariantCulture;
                <li class="gb-saat-kol" title="@AzTime.ToLocal(h.SaatUtc).ToString("HH:00") · @h.Protokol protokol@(h.HataliProtokol > 0 ? " · " + h.HataliProtokol + " hata aldı" : "")">
                    <span class="gb-saat-alan">
                        @if (h.Protokol > 0)
                        {
                            <span class="gb-saat-sayi num">@h.Protokol.ToString("N0")</span>
                            <span class="gb-saat" style="height:@boy.ToString("0.#", inv)px">
                                @if (h.HataliProtokol > 0)
                                {
                                    <span class="gb-saat-hata" style="height:@Math.Max(8, hataPay).ToString("0.#", inv)%"></span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="gb-saat-bos"></span>
                        }
                    </span>
                    <span class="gb-saat-ad num">@AzTime.ToLocal(h.SaatUtc).ToString("HH")</span>
                </li>
            }
        </ol>
        <div class="gb-saat-lejant">
            <span><i class="gb-lj gb-lj--ok"></i>sorunsuz</span>
            <span><i class="gb-lj gb-lj--hata"></i>hata alan protokol</span>
            <span><i class="gb-lj gb-lj--bos"></i>gönderim yok</span>
        </div>
    </div>
</section>

@if (o.PusulaHatasi)
{
    <div class="alert-warning" style="margin-bottom:16px;">
        <b>Pusula'ya erişilemedi.</b> Protokol numaraları çözülemediği için aşağıdaki protokol
        sayıları eksik olabilir. Kayıt ve satır sayıları SyncLog'dan geldiği için etkilenmedi.
    </div>
}
@if (o.Kirpildi)
{
    <div class="alert-warning" style="margin-bottom:16px;">
        <b>Dönem çok geniş.</b> Kayıt tavanı aşıldı, aşağıdaki sayılar en yeni kayıtlarla sınırlı.
        Daha kısa bir dönem seçin.
    </div>
}

@* ======================= HAT: protokolun yolculugu (A) =======================
   KULLANICI (2026-10-13): "genel bakista gonderimi yapilan protokol 2936 iken bekleyen
   islerde 4500." Ikisi ayni hattin FARKLI DURAKLARI -- hat bunu yapisal olarak gosteriyor.
   Duraklar 2-4 Bekleyen Isler'deki taramayla AYNI nesneden (PendingWorkService.SonSonuc).
   Tarama AKTIF ortamin gunlugune bakiyor; ortam canli degilse hat gosterilmiyor. *@
@if (k is not null && k.TarananProtokol > 0 && Model.AktifOrtamCanli)
{
    var kalemiGiden = k.TamamlananProtokol + k.KismenGonderilmisProtokol;
    var taban = Math.Max(1, Model.TaramaAraligindaAcilan ?? k.TarananProtokol);
    Func<int, string> pay = v => Math.Min(100, v * 100.0 / taban).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    <section class="card gb-hat" aria-labelledby="gb-hat-baslik">
        <div class="gb-hat-bas">
            <h2 id="gb-hat-baslik" class="gb-kart-baslik">Bir protokol TRƏS'e nasıl ulaşıyor</h2>
            <p class="gb-kart-acik">
                Dört durak, dört ayrı soru. Ekrandaki her sayı bu hattın <b>bir</b> durağına ait.
                Dönemden bağımsız &mdash; son taramanın sonucu.
            </p>
        </div>
        <ol class="gb-duraklar">
            <li>
                <span class="gb-durak-ad">1 · Pusula'da açıldı</span>
                <span class="gb-durak-sayi num">@(Model.TaramaAraligindaAcilan?.ToString("N0") ?? "—")</span>
                <span class="gb-durak-cubuk"><span style="width:100%"></span></span>
                <span class="gb-durak-not">Tarama aralığında hastanede açılan protokol</span>
            </li>
            <li>
                <span class="gb-durak-ad">2 · Gönderime hazır</span>
                <span class="gb-durak-sayi num">@k.TarananProtokol.ToString("N0")</span>
                <span class="gb-durak-cubuk"><span style="width:@pay(k.TarananProtokol)%"></span></span>
                <span class="gb-durak-not">
                    Taramanın gördüğü protokol.
                    @if (Model.TaramaAraligindaAcilan is { } ac && ac > k.TarananProtokol)
                    {
                        <span class="gb-eksi-uyari">&minus;@((ac - k.TarananProtokol).ToString("N0"))</span> <text>henüz hazır değil ya da kapsam dışı (açık protokol, devreye alım öncesi, reçete).</text>
                    }
                </span>
            </li>
            <li>
                <span class="gb-durak-ad">3 · En az bir kalemi gitti</span>
                <span class="gb-durak-sayi num">@kalemiGiden.ToString("N0")</span>
                <span class="gb-durak-cubuk"><span style="width:@pay(kalemiGiden)%"></span></span>
                <span class="gb-durak-not">
                    @if (k.HicGonderilmemisProtokol > 0)
                    {
                        <a asp-page="/BekleyenIsler" class="gb-eksi-hata">&minus;@k.HicGonderilmemisProtokol.ToString("N0")</a> <text>protokolün hiçbir kalemi gitmemiş</text>
                    }
                    else { <text>Hazır olan her protokolden en az bir kalem gitti</text> }
                </span>
            </li>
            <li>
                <span class="gb-durak-ad">4 · Eksiksiz tamam</span>
                <span class="gb-durak-sayi num gb-durak-sayi--son">@k.TamamlananProtokol.ToString("N0")</span>
                <span class="gb-durak-cubuk gb-durak-cubuk--son"><span style="width:@pay(k.TamamlananProtokol)%"></span></span>
                <span class="gb-durak-not">
                    @if (k.KismenGonderilmisProtokol > 0)
                    {
                        <span class="gb-eksi-uyari">&minus;@k.KismenGonderilmisProtokol.ToString("N0")</span> <text>kısmen gitti — kalanı sırada ya da takılı (Bekleyen İşler)</text>
                    }
                    else { <text>Hazır olanın tamamı</text> }
                </span>
            </li>
        </ol>
        <p class="gb-hat-alt">
            @if (Model.KapsamBaslangic is { } kb)
            {
                <text>Tarama aralığı <span class="num">@kb.ToString("dd.MM.yyyy")</span> &ndash;
                <span class="num">@(Model.KapsamBitis is { } kbit ? kbit.AddDays(-1).ToString("dd.MM.yyyy") : "bugün")</span>,</text>
            }
            son hesaplama <span class="num">@(Model.KapsamZamaniUtc is { } kz ? AzTime.ToLocal(kz).ToString("dd.MM.yyyy HH:mm") : "-")</span>.
            Durak 2&ndash;4 <a asp-page="/BekleyenIsler">Bekleyen İşler</a> sayfasıyla birebir aynı &mdash; ikisi de aynı hesaptan okuyor.
        </p>
    </section>
}
else if (!Model.AktifOrtamCanli)
{
    <div class="alert-warning" style="margin-bottom:16px;">
        <b>Gönderim şu an Sandbox (Test) ortamında.</b> Bu sayfa yalnızca canlı gönderimleri gösterir;
        canlı ortama göre yapılmış bir tarama olmadığı için protokol hattı gizlendi.
    </div>
}

@* ======================= HATTIN KIRILIMI + GERIYE NE KALDI =======================
   2026-10-28 (KULLANICI: "alt ile ust farkli olmasin, baska bir veri versin, ornegin
   ustteki sayilarin kirilimi; vermeyecekse kaldiralim"). Sol kart eskiden DONEMDE
   DENENEN protokolleri sayiyordu (dokunulan / sorunsuz / eksik / reddedildi); bu kume
   hattin kumesi degildi ve "sorunsuz" ile "eksiksiz tamam" ayni seyi anlatir gibi gorunup
   farkli cikiyordu. Artik hattin durak 2'sini kiriyor: ayni tarama, her protokol tek
   satirda (en agir asamasi; bkz. BekleyenDokum), toplam = durak 2. Bekleyen Isler'in
   ozet cubugu ve asama kartlari ayni sayilardan. Donemde acilan protokol kutusu da
   kalkti: durak 1 ile ayni adi tasiyip farkli araliga bakiyordu. *@
<div class="gb-split gb-esit">
    <section class="card card-pad">
        <p class="gb-kart-ust-etiket">Durak 2 &rarr; 4 kırılımı &middot; dönemden bağımsız</p>
        <h2 class="gb-kart-baslik">Hazır protokoller ne durumda</h2>
        @{
            var asm = Model.AsamaSayilari;
        }
        @if (k is null || asm is null)
        {
            <p class="text-muted">Kırılım bir sonraki taramadan sonra görünür.</p>
        }
        else
        {
            int A(string ad) => asm.GetValueOrDefault(ad);
            var dis = Math.Max(0, k.TarananProtokol - k.TamamlananProtokol - asm.Values.Sum());
            var satirlar = new (string Ad, string Alt, int Sayi, string Renk, string Link)[]
            {
                ("Eksiksiz tamam", "her kalemi gitti", k.TamamlananProtokol, "var(--success)", "/BekleyenIsler"),
                ("Sırada", "sıradaki turlarda gider", A("Hazir"), "var(--primary)", "/BekleyenIsler"),
                ("Kural gereği bekliyor", "süresi dolunca kendiliğinden", A("Kural"), "#64748B", "/BekleyenIsler#asama-1"),
                ("Pusula'da iş bekliyor", "onay, rapor, epikriz", A("PusulaIsi"), "var(--warning)", "/BekleyenIsler#asama-2"),
                ("Veri düzeltilmeli", "düzeltilmezse hiç gitmez", A("Veri"), "var(--danger)", "/BekleyenIsler#asama-3"),
                ("Kapsam dışı", "reçete, iptal, devreye alım öncesi", dis, "var(--border-strong)", "/BekleyenIsler"),
            };
            var taban = Math.Max(1, k.TarananProtokol);
            <p class="gb-kart-acik">
                Durak 2'deki <b class="num">@k.TarananProtokol.ToString("N0")</b> protokolün her biri <b>bir kez</b>, en ağır sebebiyle sayılır;
                satırların toplamı durak 2'ye eşittir. <a asp-page="/BekleyenIsler">Bekleyen İşler</a> ile aynı sayılar.
            </p>
            <div class="gb-kalan">
                @foreach (var s in satirlar)
                {
                    <a href="@s.Link" class="gb-kalan-satir">
                        <span>@s.Ad<span class="gb-kalan-alt">@s.Alt</span></span>
                        <span class="gb-kalan-cubuk"><span style="width:@((s.Sayi * 100.0 / taban).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background:@s.Renk;"></span></span>
                        <span class="num gb-kalan-sayi">@s.Sayi.ToString("N0")</span>
                    </a>
                }
            </div>
        }
    </section>

    <section class="card card-pad">
        <p class="gb-kart-ust-etiket">Durak 2'de bekleyen &middot; dönemden bağımsız</p>
        <h2 class="gb-kart-baslik">Geriye ne kaldı</h2>
        <p class="gb-kart-acik">
            Pusula'da hazır olup TRƏS'e hâlâ gitmemiş kalemler. Ölçü <b>kalem</b>, protokol değil.
        </p>
        @if (Model.BekleyenTurler.Count == 0)
        {
            <p class="text-muted">@(k is null ? "Henüz tarama yapılmadı." : "Bekleyen kalem yok.")</p>
        }
        else
        {
            var enCok = Model.BekleyenTurler[0].Value;
            <div class="gb-kalan">
                @foreach (var kv in Model.BekleyenTurler)
                {
                    <a asp-page="/BekleyenIsler" class="gb-kalan-satir">
                        <span>@kv.Key</span>
                        <span class="gb-kalan-cubuk"><span style="width:@((kv.Value * 100.0 / enCok).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                        <span class="num gb-kalan-sayi">@kv.Value.ToString("N0")</span>
                    </a>
                }
            </div>
        }
        @if (k is { TakilanKalem: > 0 })
        {
            <p class="gb-kart-dip">
                <span class="num" style="color:var(--danger);">@k.TakilanKalem.ToString("N0")</span> kalem ayrıca <b>takılı</b> &mdash;
                mevcut veriyle gönderilemiyor, tekrar denemek işe yaramaz.
            </p>
        }
    </section>
</div>


@* KULLANICI (2026-10-08): "otomatik gonderimi sanki surekli yapmiyor gibi?"
   Haklydi: olculdu, 14 gunun yalnizca 7'sinde gonderim vardi. Ama ekranda bunu
   soyleyen hicbir sey yoktu -- trend grafigi sifire inip cikiyordu ve bu "o gun is
   yoktu" gibi okunuyordu. Artik dogrudan yaziyor. *@
@if (o.PencereGun > 0 && o.DoluGun < o.PencereGun)
{
    <div class="alert-warning" style="margin-bottom:16px;">
        <b>Seçili pencerenin @(o.PencereGun - o.DoluGun) gününde hiç canlı gönderim yok.</b>
        Gönderim @o.PencereGun günün @o.DoluGun tanesinde çalışmış@(o.SonGonderimGunu is { } sg ? "; en son " + sg.ToString("dd.MM.yyyy") : "").
        Canlıya geçiş 23.10.2026 &mdash; ondan önceki günler bu sayfada boş görünür.
    </div>
}

@* ======================= TREND -- TAM GENISLIK =======================
   2026-10-13'e kadar dar sutundaydi ve yanindaki 12 satirlik tur listesi iki kat
   uzun oldugundan serit egri duruyordu. Zaman serisi genislikten kazanir; tur
   listesi ise asagida SIKISTIRILMIS satirlarla duruyor. *@
<div class="card card-pad" style="margin-bottom:18px;">
    <div class="gb-kart-ust">
        <div>
            <p class="section-title" style="margin-bottom:4px;">Günlük Gönderim Trendi</p>
            <p class="card-desc" style="margin:0;">
                Pencerenin her gününde kaç <b>protokole</b> dokunuldu. Kesikli çizgi o gün
                sorunlu kalan (eksik ya da hatalı) protokolleri gösteriyor.
            </p>
        </div>
        @* HASTANE HACMI buraya tasindi. Ayri bir serit olarak dururken sayilari sagda
           yalniz kaliyor, ustteki gonderim kartlariyla karistiriliyordu. Trendin
           yanindayken baglami belli: "o gun kac protokol acildi, kacina dokunduk". *@
        <div class="gb-hacim">
            <a asp-page="/Index" asp-route-From="@fromIso" asp-route-To="@toIso" class="gb-fig" target="_blank" rel="noopener">
                <span class="gb-fig-label">Dönemde açılan protokol</span>
                <span class="gb-fig-value">@o.AcilanProtokol.ToString("N0")</span>
                <span class="gb-fig-sub">Pusula'da açılan &mdash; gönderilenle aynı küme değil</span>
            </a>
            @if (o.BugunDonemde)
            {
                <a asp-page="/Index" asp-route-From="@todayIso" asp-route-To="@todayIso" class="gb-fig" target="_blank" rel="noopener">
                    <span class="gb-fig-label">Bugün açılan</span>
                    <span class="gb-fig-value">
                        @o.AcilanBugun.ToString("N0")
                        @if (o.AcilanTabanVar)
                        {
                            <span style="font-size:13px;" class="@(o.AcilanDegisimYuzde >= 0 ? "up" : "down")">@(o.AcilanDegisimYuzde >= 0 ? "▲" : "▼") %@Math.Abs(o.AcilanDegisimYuzde).ToString("0.#")</span>
                        }
                    </span>
                    <span class="gb-fig-sub">düne göre</span>
                </a>
            }
            else
            {
                <div class="gb-fig">
                    <span class="gb-fig-label">Günlük ortalama</span>
                    <span class="gb-fig-value">@o.AcilanGunlukOrtalama.ToString("0.#")</span>
                    <span class="gb-fig-sub">dönem geçmişte &mdash; "bugün" bu aralıkta değil</span>
                </div>
            }
        </div>
    </div>

    <div class="trend-legend" style="margin-top:14px;">
        <span class="legend-item"><span class="legend-dot" style="background:var(--success);"></span>Dokunulan protokol</span>
        <span class="legend-item"><span class="legend-dot" style="background:var(--danger);"></span>Sorunlu kalan</span>
    </div>
    @if (o.Trend.Count < 2)
    {
        <p class="text-muted" style="padding:40px 0; text-align:center;">Grafik için yeterli veri yok.</p>
    }
    else
    {
        <svg width="100%" height="220" viewBox="0 0 720 220" preserveAspectRatio="none" style="overflow:visible;">
            <defs>
                <linearGradient id="successGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--success)" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="var(--success)" stop-opacity="0" />
                </linearGradient>
            </defs>
            <line x1="8" x2="712" y1="10" y2="10" stroke="var(--border)" stroke-width="1" />
            <line x1="8" x2="712" y1="75.3" y2="75.3" stroke="var(--border)" stroke-width="1" />
            <line x1="8" x2="712" y1="140.7" y2="140.7" stroke="var(--border)" stroke-width="1" />
            <line x1="8" x2="712" y1="196" y2="196" stroke="var(--border)" stroke-width="1" />
            <path d="@Model.TrendAreaPath" fill="url(#successGrad)" stroke="none" />
            <path d="@Model.TrendTamamPath" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
            <path d="@Model.TrendSorunluPath" fill="none" stroke="var(--danger)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="4 3" />
            <circle cx="@Model.TrendLastX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" cy="@Model.TrendLastY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" r="4" fill="var(--success)" />
            @foreach (var lbl in Model.TrendLabels)
            {
                @Html.Raw($"<text x=\"{lbl.X.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"214\" fill=\"var(--text-faint)\" font-size=\"10\" text-anchor=\"{lbl.Anchor}\">{System.Net.WebUtility.HtmlEncode(lbl.Text)}</text>")
            }
        </svg>
        <p class="stat-foot" style="margin-top:10px;">
            En yoğun gün @Model.TrendMaks.ToString("N0") protokol &middot;
            @o.DoluGun / @o.PencereGun günde gönderim var
        </p>
    }
</div>

@* ======================= ICBARI SIGORTA -- TRENDIN ALTINDA, PROTOKOL ODAKLI (2026-10-26) =======================
   KULLANICI: "icbari barini hasta listesi olarak degil rakamlara odaklanalim, tiklayinca
   filtre edilmis sayfaya gidelim -- asil para kaynagi burasi." Sonra: "gunluk gonderim
   trendinin altina al; ana gozuken veriler protokol bazli olsun, altinda veri sayilari."
   Hesap IcbariKapsamService'te; her rakam Icbari Islemler sayfasinin AYNI kumeden
   suzulmus halini aciyor. Ana sayi PROTOKOL, alt satir ISLEM. *@
@{
    var ic = o.Icbari;
    string pYuzde(int n) => "%" + ic.ProtokolYuzde(n).ToString("0.0");
    string gen(int n) => (ic.Toplam.Protokol == 0 ? 0 : n * 100.0 / ic.Toplam.Protokol).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
<section class="card card-pad accent-violet gb-icbari" style="margin-bottom:18px;" aria-labelledby="gb-icbari-baslik">
    <p class="gb-kart-ust-etiket" style="color:var(--violet);">İcbari sigorta &middot; faturaya konu işlemler &middot; @Model.PeriodFromDate.ToString("dd.MM") &ndash; @Model.PeriodToDate.ToString("dd.MM.yyyy")</p>
    <h2 id="gb-icbari-baslik" class="gb-kart-baslik">İcbari Sigorta Gönderim Kapsamı</h2>
    <p class="gb-kart-acik">
        Dönemde açılan ve Pusula'da seçili kurumu <b>İcbari Tibbi Sığorta</b> olan protokoller; altında icbari kodlu işlem sayısı.
        Bir protokol, tüm icbari işlemleri TRƏS'e gidince <b>gönderildi</b> sayılır. Rakamlara tıklayınca
        protokol listesi o filtreyle açılır; oradan gönderebilirsiniz.
    </p>
    @if (ic.Toplam.Protokol == 0)
    {
        <p class="text-muted" style="margin-top:14px;">Seçili dönemde icbari sigorta ile eşleşen işlem yok.</p>
    }
    else
    {
        <div class="gb-icbari-ana">
            <a asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" class="gb-icbari-hucre" target="_blank" rel="noopener">
                <span class="gb-icbari-sayi num">@ic.Toplam.Protokol.ToString("N0")</span>
                <span class="gb-icbari-ad">icbari protokol</span>
                <span class="gb-icbari-alt">@ic.Toplam.Islem.ToString("N0") işlem · @ic.HizmetCesidi.ToString("N0") hizmet çeşidi</span>
            </a>
            <a asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="gitti" class="gb-icbari-hucre" target="_blank" rel="noopener">
                <span class="gb-icbari-sayi num" style="color:var(--akis-ok);">@ic.Gitti.Protokol.ToString("N0")</span>
                <span class="gb-icbari-ad">tamamı gönderildi · @pYuzde(ic.Gitti.Protokol)</span>
                <span class="gb-icbari-alt">@ic.Gitti.Islem.ToString("N0") işlem gönderildi (%@ic.IslemYuzde(ic.Gitti.Islem).ToString("0.0"))</span>
            </a>
            <a asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="gitmedi" class="gb-icbari-hucre" target="_blank" rel="noopener">
                <span class="gb-icbari-sayi num" style="color:var(--akis-hata);">@ic.Gitmedi.Protokol.ToString("N0")</span>
                <span class="gb-icbari-ad">tamamı gitmeyen protokol · @pYuzde(ic.Gitmedi.Protokol)</span>
                <span class="gb-icbari-alt">@ic.Gitmedi.Islem.ToString("N0") işlem TRƏS'te yok</span>
            </a>
        </div>

        <div class="gb-icbari-serit" role="img" aria-label="Protokoller: gönderildi @pYuzde(ic.Gitti.Protokol), henüz denenmedi @pYuzde(ic.Denenmedi.Protokol), eksik verili @pYuzde(ic.Eksik.Protokol), hatalı @pYuzde(ic.Hatali.Protokol)">
            <span class="bd-seg success" style="width:@gen(ic.Gitti.Protokol)%"></span>
            <span class="bd-seg gb-seg-bekliyor" style="width:@gen(ic.Denenmedi.Protokol)%"></span>
            <span class="bd-seg warning" style="width:@gen(ic.Eksik.Protokol)%"></span>
            <span class="bd-seg danger" style="width:@gen(ic.Hatali.Protokol)%"></span>
        </div>
        <div class="gb-icbari-kirilim">
            @foreach (var (anahtar, ad, sayi, renk, aciklama) in new[]
            {
                ("denenmedi", "Henüz denenmedi", ic.Denenmedi, "var(--text-faint)", "çoğu kural gereği bekliyor — sebebi aşağıda"),
                ("eksik", "Eksik verili", ic.Eksik, "var(--akis-eksik)", "Pusula'da veri/tanım eksik"),
                ("hatali", "Hatalı", ic.Hatali, "var(--akis-hata)", "TRƏS reddetti"),
            })
            {
                <a asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="@anahtar" class="gb-icbari-kucuk" target="_blank" rel="noopener">
                    <span class="gb-icbari-kare" style="background:@renk;" aria-hidden="true"></span>
                    <span>
                        <span class="num" style="font-weight:700; font-size:18px;">@sayi.Protokol.ToString("N0")</span>
                        <span class="text-muted" style="font-size:12px;"> protokol · @pYuzde(sayi.Protokol)</span>
                        <span class="gb-icbari-ad" style="display:block;">@ad</span>
                        <span class="gb-icbari-alt">@sayi.Islem.ToString("N0") işlem · @aciklama</span>
                    </span>
                </a>
            }
        </div>

        <div class="gb-split" style="margin:20px 0 0;">
            <div>
                <p class="section-title" style="margin-bottom:8px;">Gönderilmeme sebepleri</p>
                <p class="text-muted" style="font-size:12px; margin:-4px 0 6px;">Her satır o hatanın kaç protokolü ve kaç icbari işlemi etkilediğini gösterir. Bir protokolde birden fazla hata varsa her birinde sayılır.</p>
                @{ var enCokSebep = ic.Sebepler.Count == 0 ? 1 : ic.Sebepler.Max(x => x.Protokol); }
                @foreach (var sb in ic.Sebepler.Take(8))
                {
                    <a asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso"
                       asp-route-Durum="@PusulaEHealthSync.Reporting.IcbariKapsamService.DurumAnahtari(sb.Durum)" asp-route-Sebep="@sb.Sebep"
                       class="gb-kalan-satir" target="_blank" rel="noopener">
                        <span>@sb.Sebep</span>
                        <span class="gb-kalan-cubuk"><span style="width:@((sb.Protokol * 100.0 / enCokSebep).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background:@(sb.Durum switch { PusulaEHealthSync.Reporting.IcbariKapsamService.Durum.Hatali => "var(--akis-hata)", PusulaEHealthSync.Reporting.IcbariKapsamService.Durum.Eksik => "var(--akis-eksik)", _ => "var(--text-faint)" });"></span></span>
                        <span class="gb-kalan-sayi gb-sayi-iki"><span><b class="num">@sb.Protokol.ToString("N0")</b> protokol</span><span class="text-muted">@(sb.Islem == 0 ? "icbari işlemleri gitti, takılan başka kayıt" : $"{sb.Islem:N0} icbari işlem gitmedi")</span></span>
                    </a>
                }
            </div>
            <div>
                <p class="section-title" style="margin-bottom:8px;">En çok gönderilemeyen hizmetler</p>
                <p class="text-muted" style="font-size:12px; margin:-4px 0 6px;">Bu hizmetin TRƏS'e gitmediği protokol ve işlem sayısı; üzerine gelince hizmetin toplamı görünür.</p>
                @{ var enCokHizmet = ic.Hizmetler.Count == 0 ? 1 : ic.Hizmetler.Max(x => x.ProtokolGitmedi); }
                @foreach (var h in ic.Hizmetler)
                {
                    <a asp-page="/IcbariIslemler" asp-route-From="@fromIso" asp-route-To="@toIso" asp-route-Durum="gitmedi" asp-route-Hizmet="@h.Hizmet"
                       class="gb-kalan-satir" target="_blank" rel="noopener" title="@h.Toplam işlemin @h.Gitti tanesi gönderildi (%@h.GittiYuzde.ToString("0.0"))">
                        <span class="gb-icbari-hizmet">@h.Hizmet</span>
                        <span class="gb-kalan-cubuk"><span style="width:@((h.ProtokolGitmedi * 100.0 / enCokHizmet).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background:var(--akis-hata);"></span></span>
                        <span class="gb-kalan-sayi gb-sayi-iki"><span><b class="num">@h.ProtokolGitmedi.ToString("N0")</b> protokol</span><span class="text-muted">@h.Gitmedi.ToString("N0") işlem gitmedi</span></span>
                    </a>
                }
            </div>
        </div>
    }
</section>

@* ======================= TUR + BOLUM -- ESIT IKI SUTUN =======================
   Her iki liste de SIKISTIRILMIS satir kullaniyor (ad | cubuk | oran tek satirda).
   Eskiden her satir uc katli bir blokdu; on iki tur = ~700px'lik bir sutun ve
   yanindaki bolum karti yarisi kadar. Artik ikisi de ayni yukseklikte duruyor. *@
<div class="gb-split gb-esit">
    <div class="card card-pad">
        <p class="section-title">Kayıt Türüne Göre Durum</p>
        <p class="card-desc">
            Her türde kaç protokol sorunsuz tamamlandı. Çubuk protokol oranını gösteriyor;
            protokole bağlanamayan türlerde (doktor) kayıt oranı gösterilir ve satırda belirtilir.
        </p>
        @if (o.Turler.Count == 0)
        {
            <p class="text-muted">Seçili dönemde kayıt yok.</p>
        }
        else
        {
            @:<div class="gb-kaydir">
            foreach (var t in o.Turler)
            {
                <a asp-page="/Aktivite" asp-route-Ortam="Live" asp-route-Olcut="gonderim" asp-route-ResourceType="@t.ResourceType" asp-route-From="@fromIso" asp-route-To="@toIso" class="gb-satir" target="_blank" rel="noopener">
                    <span class="gb-satir-ad">
                        @t.Etiket
                        <span class="gb-satir-alt">@(t.Protokolsuz ? $"{t.Kayit:N0} kayıt · protokole bağlanmıyor" : $"{t.Protokol:N0} protokol · {birim(t.Kayit, t.Satir)}")</span>
                    </span>
                    <span class="bd-bar">
                        <span class="bd-seg success" style="width:@css(t.BarToplam == 0 ? 0 : t.BarTamam * 100.0 / t.BarToplam)%"></span>
                        <span class="bd-seg warning" style="width:@css(t.BarToplam == 0 ? 0 : t.BarEksik * 100.0 / t.BarToplam)%"></span>
                        <span class="bd-seg danger" style="width:@css(t.BarToplam == 0 ? 0 : t.BarHatali * 100.0 / t.BarToplam)%"></span>
                    </span>
                    <span class="gb-satir-sag">
                        <span class="gb-satir-pct">%@t.TamamYuzde.ToString("0.0")</span>
                        <span class="gb-satir-alt">sorunsuz</span>
                    </span>
                </a>
            }
            @:</div>
        }
    </div>

    @* BOLUM -- GONDERILEN PROTOKOLLERIN BOLUMU.
       ESKI HAL BASKA BIR SORUYU CEVAPLIYORDU: donemde ACILAN protokolleri bolume gore
       sayiyordu, yani hastane is hacmini. Bu bir GONDERIM panosu; burada ilgilendigimiz
       sey gonderimi yapilan protokollerin hangi bolumlerde sorun cikardigi. *@
    <div class="card card-pad">
        <p class="section-title">Bölüme Göre Gönderim Durumu</p>
        <p class="card-desc">Dönemde gönderimi yapılan protokoller, bölümüne ve sonucuna göre. Tüm bölümler; liste kart içinde kayar.</p>
        @if (o.Bolumler.Count == 0)
        {
            <p class="text-muted">Seçili dönemde gönderim yok.</p>
        }
        else
        {
            @:<div class="gb-kaydir">
            foreach (var b in o.Bolumler)
            {
                <div class="gb-satir" style="cursor:default;">
                    <span class="gb-satir-ad">
                        @b.Ad
                        <span class="gb-satir-alt">
                            @b.Protokol.ToString("N0") protokol
                            @if (b.Eksik > 0) { <span style="color:var(--warning);">· @b.Eksik eksik</span> }
                            @if (b.Hatali > 0) { <span style="color:var(--danger);">· @b.Hatali hatalı</span> }
                        </span>
                    </span>
                    <span class="bd-bar">
                        <span class="bd-seg success" style="width:@css(b.Protokol == 0 ? 0 : b.Tamam * 100.0 / b.Protokol)%"></span>
                        <span class="bd-seg warning" style="width:@css(b.Protokol == 0 ? 0 : b.Eksik * 100.0 / b.Protokol)%"></span>
                        <span class="bd-seg danger" style="width:@css(b.Protokol == 0 ? 0 : b.Hatali * 100.0 / b.Protokol)%"></span>
                    </span>
                    <span class="gb-satir-sag">
                        <span class="gb-satir-pct">@b.Tamam.ToString("N0")</span>
                        <span class="gb-satir-alt">sorunsuz</span>
                    </span>
                </div>
            }
            @:</div>
        }
    </div>
</div>

@* ======================= EPIKRIZ -- DOKTOR BAZINDA (2026-10-24) =======================
   KULLANICI: "epikriz eksik olanlarin doktor bazli oranlamasi ... doktorlara da baski
   yapilabilir." Hesap ve payda tanimi: GenelBakisModel.EpikrizDoktorSatiri. Ekranda en
   cok sorunlu 12 doktor; tamami Excel'de (sag ust kosedeki ok, uzerine gelince belirir). *@
<section class="card card-pad gb-indirilebilir" style="margin-bottom:18px;" aria-labelledby="gb-epikriz-baslik">
    <a asp-page-handler="EpikrizExcel" asp-route-Donem="@Model.Donem" class="gb-indir"
       title="Excel olarak indir" aria-label="Doktor bazlı epikriz tablosunu Excel olarak indir">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12"/><path d="m6 11 6 6 6-6"/><path d="M5 20h14"/></svg>
    </a>
    <p class="gb-kart-ust-etiket">Epikriz &middot; doktor bazında &middot; @Model.PeriodFromDate.ToString("dd.MM") &ndash; @Model.PeriodToDate.ToString("dd.MM.yyyy")</p>
    <h2 id="gb-epikriz-baslik" class="gb-kart-baslik">Epikrizi eksik kalan protokoller, sorumlu doktora göre</h2>
    <p class="gb-kart-acik">
        Dönemde epikrizi gönderilmeye çalışılan protokoller; doktor, protokolün sorumlu doktoru.
        <b>Eksik</b> çoğunlukla epikriz metninin boş olması &mdash; doktor yazınca kendiliğinden gider.
        Tüm doktorlar; başlığa tıklayarak sıralayın, sağdaki kutuyla arayın.
    </p>
    @if (o.EpikrizDoktorlari.Count > 0)
    {
        <input type="search" id="gb-epikriz-ara" class="gb-tablo-ara" placeholder="Doktor veya bölüm ara"
               aria-label="Doktor veya bölüm ara" oninput="gbTabloAra(this, 'gb-epikriz-tablo')" />
    }
    @if (o.EpikrizDoktorlari.Count == 0)
    {
        <p class="text-muted" style="margin-top:14px;">Seçili dönemde epikriz gönderimi yok.</p>
    }
    else
    {
        @* TUM DOKTORLAR, KART ICINDE KAYAN (2026-10-26, kullanici istegi). Siralama ve arama
           tarayicida (bkz. gbTabloSirala/gbTabloAra): veri zaten sayfada, sunucuya gidip
           gelmeye gerek yok. data-v siralama degeri -- ekrandaki "–" ve binlik ayiraci
           siralamayi bozmasin diye ham sayi. *@
        <div class="gb-kaydir gb-kaydir--tablo" style="margin-top:14px;">
            <table class="gb-epikriz" id="gb-epikriz-tablo">
                <thead>
                    <tr>
                        <th scope="col" class="gb-sirala" onclick="gbTabloSirala(this)" data-tur="metin">Doktor</th>
                        <th scope="col" class="gb-sirala" onclick="gbTabloSirala(this)" data-tur="metin">Bölüm</th>
                        <th scope="col" class="sag gb-sirala" onclick="gbTabloSirala(this)">Protokol</th>
                        <th scope="col" class="sag gb-sirala" onclick="gbTabloSirala(this)">Gönderildi</th>
                        <th scope="col" class="sag gb-sirala" onclick="gbTabloSirala(this)">Eksik</th>
                        <th scope="col" class="sag gb-sirala" onclick="gbTabloSirala(this)">Hatalı</th>
                        <th scope="col" class="gb-sirala" onclick="gbTabloSirala(this)" style="width:26%;">Başarı</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in o.EpikrizDoktorlari)
                    {
                        <tr>
                            <td style="font-weight:600;" data-v="@d.Doktor">@d.Doktor</td>
                            <td class="text-muted" data-v="@d.Bolum">@d.Bolum</td>
                            <td class="num sag" data-v="@d.Protokol">@d.Protokol.ToString("N0")</td>
                            <td class="num sag" data-v="@d.Gonderildi" style="color:var(--akis-ok);">@d.Gonderildi.ToString("N0")</td>
                            <td class="num sag" data-v="@d.Eksik" style="color:var(--akis-eksik);">@(d.Eksik > 0 ? d.Eksik.ToString("N0") : "–")</td>
                            <td class="num sag" data-v="@d.Hatali" style="color:var(--akis-hata);">@(d.Hatali > 0 ? d.Hatali.ToString("N0") : "–")</td>
                            <td data-v="@d.BasariYuzde.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                <span class="gb-epikriz-oran">
                                    <span class="gb-kalan-cubuk"><span style="width:@d.BasariYuzde.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%; background:@(d.BasariYuzde >= 90 ? "var(--akis-ok)" : d.BasariYuzde >= 60 ? "var(--akis-eksik)" : "var(--akis-hata)");"></span></span>
                                    <span class="num">%@d.BasariYuzde.ToString("0.0")</span>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="gb-kart-dip">@o.EpikrizDoktorlari.Count doktor &middot; sorunlu protokol numaraları Excel dosyasında (sağ üstteki ok).</p>
    }
</section>

@* ======================= SEBEPLER -- ESIT IKI SUTUN =======================
   ESKI HAL HAM MESAJA GORE GRUPLUYORDU. Mesaj panel adini ve tarihini de tasidigi icin
   ayni sebep onlarca satira boluniyordu -- "Idrar Mikroskopisi (01.08.2026)",
   "(03.08.2026)", "(04.08.2026)" ... her biri 10 kayitla ayri bir kutucuk. Ekranda alti
   kutucuk gorunuyordu ve altisi da AYNI sebebi anlatiyordu. Artik
   SyncLogEntry.ErrorCategory ile KATEGORI bazinda, ve sayilar SATIR degil KAYIT.
   (Olculdu: son 7 gunde 808 hata satiri = 46 hatali kayit, 17,6 kat fark.)

   IKISI YAN YANA: ayni gorsel dili paylasiyorlar ve ikisi de tam genislikteyken
   sayfa gereksiz yere uzuyordu. *@
<div class="gb-split gb-esit">
    <div class="card card-pad accent-warning">
        <p class="section-title">Eksik Veri Sebepleri</p>
        <p class="card-desc">
            Bunlar <b>hata değil</b> &mdash; gönderilmek için gereken veri Pusula'da olmadığı için
            hiç denenmemiş kayıtlar. Tanım/veri tamamlandığında kendiliğinden gönderilirler.
        </p>
        @if (o.EksikSebepleri.Count == 0)
        {
            <p class="text-muted">Seçili dönemde eksik verili kayıt yok.</p>
        }
        else
        {
            @:<div class="gb-kaydir">
            foreach (var s in o.EksikSebepleri)
            {
                <div class="gb-sebep warning" role="button" tabindex="0" data-durum="eksik" data-kategori="@s.Kategori"
                     onclick="gbSebepListele(this)" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); gbSebepListele(this); }">
                    <span class="gb-sebep-sayi">@sebepSayisi(s)<span>@(s.Protokol > 0 ? "protokol" : "kayıt")</span></span>
                    <span class="gb-sebep-metin">
                        <span class="gb-sebep-ad">@s.Kategori</span>
                        <span class="gb-sebep-desc">@s.Aciklama</span>
                        <span class="gb-sebep-turler">
                            @foreach (var tr in s.Turler)
                            {
                                <span class="gb-sebep-tur"><span class="badge @PusulaEHealthSync.Persistence.SyncLogEntry.ResourceTypeCssClass(tr.ResourceType)">@tr.Etiket</span> <span class="num">@tr.Kayit.ToString("N0")</span></span>
                            }
                        </span>
                        <span class="gb-sebep-alt">@birim(s.Kayit, s.Satir)</span>
                        <span class="gb-sebep-eylem" onclick="event.stopPropagation()">
                            <button type="button" class="btn btn-outline btn-sm" onclick="gbSebepListele(this.closest('.gb-sebep'))">Listele</button>
                            <a asp-page="/Aktivite" asp-route-Ortam="Live" asp-route-Olcut="gonderim" asp-route-Status="Skipped" asp-route-Kategori="@s.Kategori" asp-route-From="@fromIso" asp-route-To="@toIso"
                               class="btn btn-outline btn-sm" target="_blank" rel="noopener">Aktivite'de aç ↗</a>
                        </span>
                    </span>
                </div>
            }
            @:</div>
        }
    </div>

    <div class="card card-pad accent-danger">
        <p class="section-title">Hata Sebepleri</p>
        <p class="card-desc">
            TRƏS'in reddettiği gönderimler tek tek değil, <b>sebebine</b> göre gruplanmış.
            Düzeltilmeden tekrar denemek işe yaramaz.
        </p>
        @if (o.HataSebepleri.Count == 0)
        {
            <p class="text-muted">Seçili dönemde hata yok.</p>
        }
        else
        {
            @:<div class="gb-kaydir">
            foreach (var s in o.HataSebepleri)
            {
                <div class="gb-sebep danger" role="button" tabindex="0" data-durum="hata" data-kategori="@s.Kategori"
                     onclick="gbSebepListele(this)" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); gbSebepListele(this); }">
                    <span class="gb-sebep-sayi">@sebepSayisi(s)<span>@(s.Protokol > 0 ? "protokol" : "kayıt")</span></span>
                    <span class="gb-sebep-metin">
                        <span class="gb-sebep-ad">@s.Kategori</span>
                        <span class="gb-sebep-desc">@s.Aciklama</span>
                        <span class="gb-sebep-turler">
                            @foreach (var tr in s.Turler)
                            {
                                <span class="gb-sebep-tur"><span class="badge @PusulaEHealthSync.Persistence.SyncLogEntry.ResourceTypeCssClass(tr.ResourceType)">@tr.Etiket</span> <span class="num">@tr.Kayit.ToString("N0")</span></span>
                            }
                        </span>
                        <span class="gb-sebep-alt">@birim(s.Kayit, s.Satir)</span>
                        <span class="gb-sebep-eylem" onclick="event.stopPropagation()">
                            <button type="button" class="btn btn-outline btn-sm" onclick="gbSebepListele(this.closest('.gb-sebep'))">Listele</button>
                            <a asp-page="/Aktivite" asp-route-Ortam="Live" asp-route-Olcut="gonderim" asp-route-Status="Failed" asp-route-Kategori="@s.Kategori" asp-route-From="@fromIso" asp-route-To="@toIso"
                               class="btn btn-outline btn-sm" target="_blank" rel="noopener">Aktivite'de aç ↗</a>
                        </span>
                    </span>
                </div>
            }
            @:</div>
        }
    </div>
</div>

@* SON HATALAR TAM GENISLIK: ham TRƏS mesajlari uzun, dar sutunda satir satir
   kirpiliyordu ve hatanin ne oldugu okunamiyordu. *@
<div class="card card-pad accent-danger" style="margin-bottom:18px;">
    <p class="section-title">Son Hatalar</p>
    <p class="card-desc">
        Dönemde TRƏS'in reddettiği gönderimler &mdash; aynı protokolün aynı sebeple
        tekrarlanan denemeleri tek satırda.
    </p>
    @if (o.SonHatalar.Count == 0)
    {
        <p class="text-muted">Seçili dönemde hata yok.</p>
    }
    else
    {
        foreach (var e in o.SonHatalar)
        {
            <a asp-page="/Detail" asp-route-id="@e.SonId" class="err-row" target="_blank" rel="noopener">
                <span class="err-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg></span>
                <span class="err-main">
                    <span class="err-title">
                        @e.HastaAdi &middot; @e.TurEtiketi
                        @if (e.ProtokolId is { } pid)
                        {
                            <span class="err-count-badge">Protokol @pid</span>
                        }
                        @if (e.Kayit > 1)
                        {
                            <span class="err-count-badge">@e.Kayit kayıt</span>
                        }
                    </span>
                    <div class="err-sub">@e.AnlasilirMesaj</div>
                    @if (e.AnlasilirMesaj != e.HamMesaj)
                    {
                        <div class="err-raw">@e.HamMesaj</div>
                    }
                </span>
                <span class="err-time">@e.Gun.ToString("dd.MM")</span>
            </a>
        }
    }
</div>

<dialog id="gb-liste" class="gb-liste-pencere" aria-labelledby="gb-liste-baslik">
    <div class="gb-liste-icerik"></div>
</dialog>

<script>
    // SEBEP LISTESI (2026-10-26) -- satira ya da "Listele"ye tiklayinca pencere acilir,
    // icerik sunucudan gelir (ayni onbellekli ozet). Kapatmak: Esc, Kapat ya da disari tik.
    async function gbSebepListele(satir) {
        const pencere = document.getElementById('gb-liste');
        const icerik = pencere.querySelector('.gb-liste-icerik');
        icerik.innerHTML = '<div class="gb-liste-yukleniyor">Liste hazırlanıyor…</div>';
        delete icerik.dataset.taraf;
        if (!pencere.open) pencere.showModal();
        const q = new URLSearchParams(location.search);
        q.set('handler', 'SebepListesi');
        q.set('durum', satir.dataset.durum);
        q.set('kategori', satir.dataset.kategori);
        try {
            const yanit = await fetch('?' + q.toString(), { headers: { 'X-Requested-With': 'fetch' } });
            if (!yanit.ok) throw new Error(yanit.status);
            icerik.innerHTML = await yanit.text();
        } catch (e) {
            icerik.innerHTML = '<div class="gb-liste-yukleniyor">Liste alınamadı (' + e.message + '). Sayfayı yenileyip tekrar deneyin.</div>';
        }
    }
    document.getElementById('gb-liste').addEventListener('click', e => {
        if (e.target === e.currentTarget) e.currentTarget.close();
    });
    function gbListeGorunum(dugme, ad) {
        const kok = dugme.closest('.gb-liste-icerik');
        kok.querySelectorAll('.gb-seg-btn').forEach(b => { b.classList.toggle('active', b === dugme); b.setAttribute('aria-selected', b === dugme); });
        kok.querySelectorAll('.gb-liste-govde').forEach(g => g.hidden = g.dataset.gorunum !== ad);
    }
    // Arama ve Hasta/Doktor secimi BIRLIKTE uygulanir: satir ikisine de uymali.
    function gbListeSuz(kok) {
        const aranan = (kok.querySelector('.gb-liste-arac .gb-tablo-ara')?.value ?? '').trim().toLocaleLowerCase('tr');
        const taraf = kok.dataset.taraf ?? '';
        kok.querySelectorAll('.gb-liste-govde tbody tr').forEach(tr => {
            tr.hidden = (aranan !== '' && !tr.textContent.toLocaleLowerCase('tr').includes(aranan))
                     || (taraf !== '' && tr.dataset.taraf !== taraf);
        });
    }
    function gbListeAra(kutu) { gbListeSuz(kutu.closest('.gb-liste-icerik')); }
    function gbListeTaraf(dugme, taraf) {
        const kok = dugme.closest('.gb-liste-icerik');
        kok.dataset.taraf = taraf;
        dugme.parentElement.querySelectorAll('.gb-seg-btn').forEach(b => {
            b.classList.toggle('active', b === dugme);
            b.setAttribute('aria-pressed', b === dugme);
        });
        gbListeSuz(kok);
    }

    // TABLO SIRALAMA / ARAMA (2026-10-26) -- veri sayfada, sunucuya gidilmiyor.
    // Ayni basliga ikinci tik yonu cevirir. Sayi sutunlari buyukten kucuge baslar.
    function gbTabloSirala(th) {
        const tablo = th.closest('table'), govde = tablo.tBodies[0];
        const sira = Array.from(th.parentNode.children).indexOf(th);
        const metin = th.dataset.tur === 'metin';
        const artan = th.dataset.yon ? th.dataset.yon !== 'artan' : metin;
        tablo.querySelectorAll('th').forEach(h => { delete h.dataset.yon; h.removeAttribute('aria-sort'); });
        th.dataset.yon = artan ? 'artan' : 'azalan';
        th.setAttribute('aria-sort', artan ? 'ascending' : 'descending');
        const deger = tr => tr.children[sira].dataset.v ?? tr.children[sira].textContent;
        const satirlar = Array.from(govde.rows).sort((a, b) => {
            const x = deger(a), y = deger(b);
            const f = metin ? x.localeCompare(y, 'tr') : parseFloat(x) - parseFloat(y);
            return artan ? f : -f;
        });
        satirlar.forEach(tr => govde.appendChild(tr));
    }
    function gbTabloAra(kutu, tabloId) {
        const aranan = kutu.value.trim().toLocaleLowerCase('tr');
        document.querySelectorAll('#' + tabloId + ' tbody tr').forEach(tr => {
            tr.hidden = aranan !== '' && !tr.textContent.toLocaleLowerCase('tr').includes(aranan);
        });
    }
</script>

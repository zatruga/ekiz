@page
@model PusulaEHealthSync.Web.Pages.GenelBakisModel
@{
    ViewData["Title"] = "Genel Bakış";
    var todayIso = Model.Today.ToString("yyyy-MM-dd");
    var periodFromIso = Model.PeriodFromDate.ToString("yyyy-MM-dd");
    var periodToIso = Model.PeriodToDate.ToString("yyyy-MM-dd");
}

<div class="page-header">
    <div>
        <h1 class="page-title">Genel Bakış</h1>
        <p class="page-subtitle">Sistemin gönderim sağlığına tek bakışta genel bakış</p>
    </div>
    <form method="get" class="segmented">
        <input type="radio" id="dGun" name="Donem" value="0" checked="@(Model.Donem == "0")" onchange="this.form.submit()" /><label for="dGun">Bugün</label>
        <input type="radio" id="dHafta" name="Donem" value="7" checked="@(Model.Donem != "0" && Model.Donem != "30")" onchange="this.form.submit()" /><label for="dHafta">Son 7 Gün</label>
        <input type="radio" id="dAy" name="Donem" value="30" checked="@(Model.Donem == "30")" onchange="this.form.submit()" /><label for="dAy">Son 30 Gün</label>
    </form>
</div>

<div class="kpi-grid">
    <a asp-page="/Index" asp-route-From="@todayIso" asp-route-To="@todayIso" class="kpi-card" target="_blank" rel="noopener">
        <div class="kpi-top">
            <span class="kpi-label">Bugün Açılan Protokol</span>
            <span class="kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg></span>
        </div>
        <span class="kpi-value">@Model.TodayProtocolCount</span>
        @if (Model.TodayProtocolHasBaseline)
        {
            <span class="kpi-sub"><span class="@(Model.TodayProtocolChangePct >= 0 ? "up" : "down")">@(Model.TodayProtocolChangePct >= 0 ? "▲" : "▼") %@Math.Abs(Model.TodayProtocolChangePct).ToString("0.#")</span> dünden bugüne</span>
        }
        else
        {
            <span class="kpi-sub">dünle karşılaştırma yok</span>
        }
    </a>

    <a asp-page="/Aktivite" asp-route-ResourceType="Encounter" asp-route-Status="Success" asp-route-From="@todayIso" asp-route-To="@todayIso" class="kpi-card success" target="_blank" rel="noopener">
        <div class="kpi-top">
            <span class="kpi-label">Bugün Gönderilen</span>
            <span class="kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg></span>
        </div>
        <span class="kpi-value success">@Model.TodaySentCount</span>
        <span class="kpi-sub">@Model.TodayProtocolCount protokolün %@Model.TodaySentPct.ToString("0")'i</span>
    </a>

    <a asp-page="/Aktivite" asp-route-From="@periodFromIso" asp-route-To="@periodToIso" class="kpi-card" target="_blank" rel="noopener">
        <div class="kpi-top">
            <span class="kpi-label">Genel Başarı Oranı</span>
            <span class="kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
        </div>
        <span class="kpi-value success">@Model.OverallSuccessRatePct.ToString("0.0")<span style="font-size:18px;">%</span></span>
        @if (Model.SuccessRateHasBaseline)
        {
            <span class="kpi-sub"><span class="@(Model.SuccessRateDeltaPct >= 0 ? "up" : "down")">@(Model.SuccessRateDeltaPct >= 0 ? "▲" : "▼") %@Math.Abs(Model.SuccessRateDeltaPct).ToString("0.#")</span> önceki döneme göre</span>
        }
        else
        {
            <span class="kpi-sub">önceki dönemde veri yok</span>
        }
        <svg class="kpi-ring" width="46" height="46" viewBox="0 0 46 46" aria-hidden="true">
            <circle cx="23" cy="23" r="19" fill="none" stroke="var(--surface-hover)" stroke-width="5" />
            <circle cx="23" cy="23" r="19" fill="none" stroke="var(--success)" stroke-width="5" stroke-linecap="round"
                    stroke-dasharray="119.4" stroke-dashoffset="@Model.SuccessRateRingDashOffset.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" transform="rotate(-90 23 23)" />
        </svg>
    </a>

    <a asp-page="/Aktivite" asp-route-Status="Failed" asp-route-From="@periodFromIso" asp-route-To="@periodToIso" class="kpi-card warning" target="_blank" rel="noopener">
        <div class="kpi-top">
            <span class="kpi-label">Hatalı / Bekleyen</span>
            <span class="kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg></span>
        </div>
        <span class="kpi-value warning">@(Model.FailedCount + Model.PendingCount)</span>
        <span class="kpi-sub">@Model.FailedCount hatalı &middot; @Model.PendingCount bekleyen</span>
    </a>
</div>

<div class="dash-grid">
    <div class="card card-pad">
        <p class="section-title">Gönderim Trendi</p>
        <p class="card-desc">Son 14 günün günlük başarılı / hatalı gönderim sayıları</p>
        <div class="trend-legend">
            <span class="legend-item"><span class="legend-dot" style="background:var(--success);"></span>Başarılı</span>
            <span class="legend-item"><span class="legend-dot" style="background:var(--danger);"></span>Hatalı</span>
        </div>
        @if (Model.Trend.Count < 2)
        {
            <p class="text-muted" style="padding:40px 0; text-align:center;">Grafik için yeterli veri yok.</p>
        }
        else
        {
            <svg width="100%" height="220" viewBox="0 0 720 220" preserveAspectRatio="none" style="overflow:visible;">
                <defs>
                    <linearGradient id="successGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="var(--success)" stop-opacity="0.35" />
                        <stop offset="100%" stop-color="var(--success)" stop-opacity="0" />
                    </linearGradient>
                </defs>
                <line x1="8" x2="712" y1="10" y2="10" stroke="var(--border)" stroke-width="1" />
                <line x1="8" x2="712" y1="75.3" y2="75.3" stroke="var(--border)" stroke-width="1" />
                <line x1="8" x2="712" y1="140.7" y2="140.7" stroke="var(--border)" stroke-width="1" />
                <line x1="8" x2="712" y1="196" y2="196" stroke="var(--border)" stroke-width="1" />
                <path d="@Model.TrendAreaPath" fill="url(#successGrad)" stroke="none" />
                <path d="@Model.TrendSuccessPath" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
                <path d="@Model.TrendFailedPath" fill="none" stroke="var(--danger)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="4 3" />
                <circle cx="@Model.TrendLastX.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" cy="@Model.TrendLastY.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" r="4" fill="var(--success)" />
                @foreach (var lbl in Model.TrendLabels)
                {
                    @Html.Raw($"<text x=\"{lbl.X.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"214\" fill=\"var(--text-faint)\" font-size=\"10\" text-anchor=\"{lbl.Anchor}\">{System.Net.WebUtility.HtmlEncode(lbl.Text)}</text>")
                }
            </svg>
        }
    </div>

    <div class="card card-pad">
        <p class="section-title">Kaynak Türüne Göre Durum</p>
        <p class="card-desc">Seçili dönemde her kaynak tipi için başarı dağılımı</p>
        @if (Model.Breakdown.Count == 0)
        {
            <p class="text-muted">Seçili dönemde kayıt yok.</p>
        }
        else
        {
            foreach (var row in Model.Breakdown)
            {
                <a asp-page="/Aktivite" asp-route-ResourceType="@row.ResourceType" asp-route-From="@periodFromIso" asp-route-To="@periodToIso" class="bd-row" target="_blank" rel="noopener">
                    <div class="bd-head"><span class="bd-name">@row.Label</span><span class="bd-total">@row.Total</span></div>
                    <div class="bd-bar">
                        <div class="bd-seg success" style="width:@(row.Total == 0 ? 0 : row.Success * 100.0 / row.Total)%"></div>
                        <div class="bd-seg warning" style="width:@(row.Total == 0 ? 0 : row.Warning * 100.0 / row.Total)%"></div>
                        <div class="bd-seg danger" style="width:@(row.Total == 0 ? 0 : row.Danger * 100.0 / row.Total)%"></div>
                    </div>
                    <div class="bd-pct">%@row.SuccessPct.ToString("0.0") başarılı</div>
                </a>
            }
        }
    </div>
</div>

<div class="bottom-grid">
    <div class="card card-pad accent-danger">
        <p class="section-title">Son Hatalar</p>
        <p class="card-desc">Seçili dönemde en son başarısız olan gönderimler</p>
        @if (Model.RecentErrors.Count == 0)
        {
            <p class="text-muted">Seçili dönemde hata yok.</p>
        }
        else
        {
            foreach (var e in Model.RecentErrors)
            {
                <a asp-page="/Detail" asp-route-id="@e.LastEntryId" class="err-row" target="_blank" rel="noopener">
                    <span class="err-badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg></span>
                    <span class="err-main">
                        <span class="err-title">
                            @e.PatientFullName &middot; @e.ResourceTypeLabel
                            @if (e.Count > 1)
                            {
                                <span class="err-count-badge">&times;@e.Count</span>
                            }
                        </span>
                        <div class="err-sub">@e.FriendlyMessage</div>
                        @if (e.FriendlyMessage != e.RawMessage)
                        {
                            <div class="err-raw">@e.RawMessage</div>
                        }
                    </span>
                    <span class="err-time">@PusulaEHealthSync.Web.Pages.GenelBakisModel.RelativeTime(e.LastSeenUtc)</span>
                </a>
            }
        }
    </div>

    <div class="card card-pad">
        <p class="section-title">Bölüme Göre Gönderim Hacmi</p>
        <p class="card-desc">Seçili dönemde en çok protokolü olan bölümler</p>
        @if (Model.DeptVolume.Count == 0)
        {
            <p class="text-muted">Seçili dönemde kayıt yok.</p>
        }
        else
        {
            foreach (var d in Model.DeptVolume)
            {
                <div class="dept-row">
                    <span class="dept-name">@d.Name</span>
                    <span class="dept-bar-track"><span class="dept-bar-fill" style="width:@d.Pct%"></span></span>
                    <span class="dept-pct">@d.Count</span>
                </div>
            }
        }
    </div>
</div>

<div class="card card-pad accent-warning" style="margin-bottom:18px;">
    <p class="section-title">Hazır Olmayan Kayıtlar</p>
    <p class="card-desc">Bunlar HATA değil -- Pusula tarafında henüz tamamlanmadığı için gönderilemeyen kayıtlar. Tamamlandıklarında otomatik gönderilecekler.</p>
    @if (Model.NotReadyGroups.Count == 0)
    {
        <p class="text-muted">Seçili dönemde bekleyen kayıt yok.</p>
    }
    else
    {
        <div class="ready-grid">
            @foreach (var r in Model.NotReadyGroups)
            {
                <a asp-page="/Aktivite" asp-route-Status="Skipped" asp-route-ResourceType="Composition" asp-route-From="@periodFromIso" asp-route-To="@periodToIso" class="ready-tile" target="_blank" rel="noopener">
                    <div class="ready-count">@r.Count</div>
                    <div class="ready-name">@r.Reason</div>
                </a>
            }
        </div>
    }
</div>

<div class="card card-pad accent-danger" style="margin-bottom:18px;">
    <p class="section-title">Hata Kategorileri</p>
    <p class="card-desc">Başarısız gönderimler tek tek değil, SEBEBİNE göre gruplanmış.</p>
    @if (Model.ErrorCategories.Count == 0)
    {
        <p class="text-muted">Seçili dönemde hata yok.</p>
    }
    else
    {
        <div class="cat-grid">
            @foreach (var c in Model.ErrorCategories)
            {
                <a asp-page="/Aktivite" asp-route-Status="Failed" asp-route-From="@periodFromIso" asp-route-To="@periodToIso" class="cat-tile" target="_blank" rel="noopener">
                    <div class="cat-count">@c.Count</div>
                    <div class="cat-name">@c.Label</div>
                    <div class="cat-desc">@c.Description</div>
                </a>
            }
        </div>
    }
</div>

<div class="card card-pad accent-violet">
    <p class="section-title" style="color:var(--violet);">İcbari Sigorta Gönderim Kapsamı</p>
    <p class="card-desc">
        İcbari Sigorta Fiyat Listesi ile eşleşen (faturaya konu) hizmetlerden hangileri e-Health'e gönderildi, hangileri gönderilemedi.
        Tutar/kayıp ciro bilgisi burada gösterilmiyor -- Pusula'daki fiyat/tarife alanı henüz doğrulanmadı.
    </p>
    <div class="icbari-kpis">
        <div class="icbari-kpi">
            <span class="icbari-kpi-label">İcbari eşleşen işlem (seçili dönem)</span>
            <span class="icbari-kpi-value">@Model.IcbariMatchedCount</span>
        </div>
        <div class="icbari-kpi">
            <span class="icbari-kpi-label">Başarıyla gönderilen</span>
            <span class="icbari-kpi-value" style="color:var(--success);">@Model.IcbariSentCount <span style="font-size:15px; color:var(--text-faint);">(%@Model.IcbariSentPct.ToString("0.0"))</span></span>
        </div>
        <div class="icbari-kpi">
            <span class="icbari-kpi-label">Gönderilmeyen</span>
            <span class="icbari-kpi-value" style="color:var(--danger);">@(Model.IcbariMatchedCount - Model.IcbariSentCount)</span>
        </div>
    </div>
    @if (Model.IcbariUnsent.Count == 0)
    {
        <p class="text-muted">@(Model.IcbariMatchedCount == 0 ? "Seçili dönemde icbari sigorta ile eşleşen işlem yok." : "Eşleşen tüm işlemler gönderilmiş.")</p>
    }
    else
    {
        <div class="icbari-table-wrap">
            <table class="icbari-table">
                <thead><tr><th>Hasta / Protokol</th><th>Hizmet</th><th>Sebep</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.IcbariUnsent)
                    {
                        <tr class="clickable" onclick="window.open('@Url.Page("/Protokol", new { id = r.ProtokolId })', '_blank')">
                            <td><div style="font-weight:600;">@r.PatientName</div><div style="color:var(--text-faint); font-size:11.5px; margin-top:2px;">Protokol @r.ProtokolId</div></td>
                            <td>@r.ServiceName</td>
                            <td class="reason">@r.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@page
@model PusulaEHealthSync.Web.Pages.LabLoincEslestirmeModel
@using PusulaEHealthSync.Persistence
@{
    ViewData["Title"] = "Lab LOINC Eşleştirme";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Lab LOINC Eşleştirme</h1>
        <p class="page-subtitle">
            LOINC karşılığı olmayan test kodları burada eşleştirilir. Pusula salt okunur olduğu için
            eşleştirme bu uygulamada tutulur, gönderim anında uygulanır.
        </p>
    </div>
</div>

@if (Model.Saved)
{
    <div class="alert alert-success">Kaydedildi.</div>
}

<div class="card card-pad" style="margin-bottom:20px;">
    <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
        <a asp-page="/LabLoincEslestirme" asp-route-Durum="Tumu" class="stat-link @(Model.Durum == "Tumu" ? "active" : "")">
            <span class="stat-value" style="font-size:24px;">@Model.ToplamSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">tümü</span>
        </a>
        <a asp-page="/LabLoincEslestirme" asp-route-Durum="Laboratuvar" class="stat-link @(Model.Durum == "Laboratuvar" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--success);">@Model.LabSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">lab onayladı</span>
        </a>
        <a asp-page="/LabLoincEslestirme" asp-route-Durum="Oneri" class="stat-link @(Model.Durum == "Oneri" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--warning);">@Model.OneriSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">öneri — onay bekliyor</span>
        </a>
        <a asp-page="/LabLoincEslestirme" asp-route-Durum="Belirsiz" class="stat-link @(Model.Durum == "Belirsiz" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--warning);">@Model.BelirsizSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">belirsiz — karar gerekiyor</span>
        </a>
        <a asp-page="/LabLoincEslestirme" asp-route-Durum="Bos" class="stat-link @(Model.Durum == "Bos" ? "active" : "")">
            <span class="stat-value" style="font-size:24px; color:var(--danger);">@Model.BosSayi</span>
            <span class="text-muted" style="font-size:13px; display:block;">kod girilmeli</span>
        </a>

        <form method="get" style="margin-left:auto; display:flex; gap:8px; align-items:center;">
            <input type="hidden" name="Durum" value="@Model.Durum" />
            <input type="text" name="Ara" value="@Model.Ara" placeholder="kod veya test adı ara"
                   class="form-control" style="width:240px;" />
            <button type="submit" class="btn btn-outline btn-sm">Ara</button>
        </form>
    </div>

    @{
        var oran = Model.ToplamIstem == 0 ? 0 : 100.0 * Model.KapaliIstem / Model.ToplamIstem;
    }
    <div style="margin-top:14px;">
        <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:5px;">
            <span class="text-muted">Kodu atanmış testlerin yıllık istem payı</span>
            <span><strong>@oran.ToString("0.0")%</strong>
                  <span class="text-muted">(@Model.KapaliIstem.ToString("N0") / @Model.ToplamIstem.ToString("N0") istem)</span></span>
        </div>
        <div style="height:8px; background:var(--border); border-radius:4px; overflow:hidden;">
            <div style="height:100%; width:@oran.ToString("0.0")%; background:var(--success);"></div>
        </div>
        <p class="text-muted" style="font-size:12px; margin:6px 0 0;">
            Satır sayısı yerine istem hacmi gösteriliyor -- listedeki kayıtların çoğu yılda birkaç kez isteniyor,
            birkaçı on binlerce kez. Yukarıdan başlamak en hızlı ilerlemeyi sağlar.
        </p>
    </div>
</div>

<div class="card card-pad" style="margin-bottom:20px;">
    <form method="post" asp-page-handler="Ekle" style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
        <input type="hidden" name="Durum" value="@Model.Durum" />
        <div>
            <label class="text-muted" style="font-size:12px; display:block;">Pusula test kodu</label>
            <input type="text" name="yeniPusulaKodu" class="form-control" style="width:180px;" required />
        </div>
        <div>
            <label class="text-muted" style="font-size:12px; display:block;">LOINC kodu</label>
            <input type="text" name="yeniLoincKodu" class="form-control" style="width:140px;" placeholder="2744-1" />
        </div>
        <div>
            <label class="text-muted" style="font-size:12px; display:block;">Test adı (isteğe bağlı)</label>
            <input type="text" name="yeniTestAdi" class="form-control" style="width:280px;" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Ekle</button>
    </form>
</div>

<div class="card">
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:140px;">Pusula Kodu</th>
                    <th style="width:230px;">Test Adı</th>
                    <th style="width:90px; text-align:right;">İstem/yıl</th>
                    <th>LOINC Karşılığı</th>
                    <th style="width:140px;">Durum</th>
                    <th style="width:320px;">LOINC kodu</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Satirlar.Count == 0)
            {
                <tr><td colspan="6" class="text-muted" style="padding:20px;">Kayıt bulunamadı.</td></tr>
            }
            @foreach (var s in Model.Satirlar)
            {
                var tr = PusulaEHealthSync.Web.Pages.LabLoincEslestirmeModel.LoincAdiTr(s.LoincKodu);
                var aciklama = s.Aciklama;
                var lab = s.Kaynak == LabTestLoincStore.KaynakLaboratuvar;
                <tr>
                    <td><code>@s.PusulaKodu</code></td>
                    <td>@s.TestAdi</td>
                    <td style="text-align:right; font-variant-numeric:tabular-nums;">@s.Istem.ToString("N0")</td>
                    <td style="font-size:13px;">
                        @if (aciklama is not null)
                        {
                            @* Kod girilmis ve DOGRULANMIS -- Turkce varsa ustte, resmi ad altta *@
                            @if (tr is not null)
                            {
                                <div>@tr</div>
                                <div class="text-muted" style="font-size:12px; margin-top:2px;">@aciklama</div>
                            }
                            else
                            {
                                <div>@aciklama</div>
                            }
                        }
                        else if (!s.Bekliyor)
                        {
                            @* Kod var ama aciklamasi alinamadi -- ya kod yanlis ya internet yoktu *@
                            <span style="color:var(--warning);">
                                <code>@s.LoincKodu</code> doğrulanamadı -- kodu kontrol edin
                                (internet yoksa kaydedince tekrar denenir).
                            </span>
                        }
                        else if (s.BelirsizTaban is { } taban)
                        {
                            <span style="color:var(--warning);">
                                Bu kod <code>@taban</code> LOINC'unun varyantı mı, yoksa kendi kodunuz mu?
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Karşılık önerilemedi -- kodu siz girmelisiniz.</span>
                        }
                    </td>
                    <td>
                        @if (lab)
                        {
                            <span class="badge badge-success"><span class="badge-dot"></span>lab onayladı</span>
                        }
                        else if (!s.Bekliyor)
                        {
                            <span class="badge badge-warning"><span class="badge-dot"></span>öneri</span>
                        }
                        else if (s.GrupAdi == "belirsiz")
                        {
                            <span class="badge badge-warning"><span class="badge-dot"></span>belirsiz</span>
                        }
                        else
                        {
                            <span class="badge badge-danger"><span class="badge-dot"></span>boş</span>
                        }
                    </td>
                    <td>
                        <div style="display:flex; gap:6px; align-items:center;">
                            <form method="post" asp-page-handler="Kaydet" style="display:flex; gap:6px;">
                                <input type="hidden" name="Durum" value="@Model.Durum" />
                                <input type="hidden" name="Ara" value="@Model.Ara" />
                                <input type="hidden" name="pusulaKodu" value="@s.PusulaKodu" />
                                <input type="hidden" name="testAdi" value="@s.TestAdi" />
                                <input type="text" name="loincKodu" value="@s.LoincKodu"
                                       placeholder="@(s.BelirsizTaban ?? "2744-1")"
                                       class="form-control" style="width:120px;" />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    @(lab ? "Kaydet" : "Onayla")
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Sil">
                                <input type="hidden" name="Durum" value="@Model.Durum" />
                                <input type="hidden" name="Ara" value="@Model.Ara" />
                                <input type="hidden" name="pusulaKodu" value="@s.PusulaKodu" />
                                <button type="submit" class="btn btn-outline btn-sm"
                                        style="border-color:var(--danger); color:var(--danger);"
                                        onclick="return confirm('Bu satır listeden silinecek. Emin misiniz?')">Sil</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card card-pad" style="margin-top:20px;">
    <p class="text-muted" style="font-size:13px; margin:0;">
        <strong>öneri</strong> = kod tarafımızdan önerildi ve HL7 terminoloji sunucusunda (LOINC 2.82) doğrulandı;
        eşleştirmenin kendisi laboratuvar onayı bekliyor.
        <strong>laboratuvar</strong> = bu sayfadan düzenlendi, onaylanmış sayılır.
        Bu tablo Pusula'ya <em>yazmaz</em>; yalnızca e-Sağlık gönderiminde uygulanır.
    </p>
</div>

@page
@model PusulaEHealthSync.Web.Pages.AyarlarModel
@{
    ViewData["Title"] = "Ayarlar";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Ayarlar</h1>
        <p class="page-subtitle">Ortam, otomatik gönderim, tekrar deneme ve bildirim kuralları</p>
    </div>
</div>

<div class="settings-shell">
    <partial name="Shared/_SettingsNav" model="@("ortam")" />

    <div>
        <!-- 1. ORTAM · SİSTEM AYARLARI -->
        <section class="settings-panel active" id="panel-ortam">
            <div class="settings-grid">

                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Kaynak Veritabanı Bağlantısı</p>
                    <p class="card-desc">
                        Hastane bilgi sisteminin (şu an Pusula) veritabanı bağlantı bilgisi. Boş bırakılırsa
                        mevcut sunucu yapılandırması (appsettings/user-secrets) kullanılmaya devam eder --
                        burada bir şey girmeden mevcut davranış bozulmaz.
                    </p>
                    <form method="post" asp-page-handler="Veritabani" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field-row-2">
                            <div class="field"><label for="dbServer">Sunucu adresi (IP)</label>
                                <input type="text" id="dbServer" asp-for="PusulaDbServer" placeholder="10.10.201.50" /></div>
                            <div class="field"><label for="dbName">Veritabanı adı</label>
                                <input type="text" id="dbName" asp-for="PusulaDbName" placeholder="Pusula" /></div>
                        </div>
                        <div class="field-row-2">
                            <div class="field"><label for="dbUser">Kullanıcı adı</label>
                                <input type="text" id="dbUser" asp-for="PusulaDbUser" autocomplete="off" /></div>
                            <div class="field"><label for="dbPassword">Şifre @(Model.PusulaDbPasswordIsSet ? "(tanımlı -- değiştirmek için yeniden girin)" : "(tanımlı değil)")</label>
                                <input type="password" id="dbPassword" asp-for="PusulaDbPassword" autocomplete="new-password" placeholder="değiştirmek için girin, boş bırakılırsa mevcut şifre saklı kalır" /></div>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Veritabanı Bağlantısını Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "veritabani")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Ortam &middot; Sistem Adresleri</p>
                    <p class="card-desc">
                        Sistem şu an hangi TRƏS ortamına gönderim yapacak. Alanlar boş bırakılırsa Test ortamı için
                        mevcut sunucu yapılandırması (appsettings/user-secrets) kullanılmaya devam eder -- burada bir şey
                        girmeden mevcut davranış bozulmaz.
                    </p>
                    <form method="post" asp-page-handler="Ortam" style="display:flex; flex-direction:column; flex:1;">
                        <label class="field-sub-label">Aktif ortam</label>
                        <div class="segmented">
                            <input type="radio" id="envTest" name="EHealthEnvironment" value="Test" checked="@(Model.EHealthEnvironment != "Live")" />
                            <label for="envTest">Test / Sandbox</label>
                            <input type="radio" id="envLive" name="EHealthEnvironment" value="Live" checked="@(Model.EHealthEnvironment == "Live")" />
                            <label for="envLive">Canlı (Production)</label>
                        </div>

                        <div class="field-row-2">
                            <div>
                                <p class="field-sub-label">Test / Sandbox</p>
                                <div class="field"><label for="testBaseUrl">Adres (BaseUrl)</label>
                                    <input type="text" id="testBaseUrl" asp-for="TestBaseUrl" placeholder="https://ehr-sandbox.e-health.gov.az" /></div>
                                <div class="field"><label for="testUserName">Kullanıcı adı</label>
                                    <input type="text" id="testUserName" asp-for="TestUserName" autocomplete="off" /></div>
                                <div class="field"><label for="testPassword">Şifre @(Model.TestPasswordIsSet ? "(tanımlı -- değiştirmek için yeniden girin)" : "(tanımlı değil)")</label>
                                    <input type="password" id="testPassword" asp-for="TestPassword" autocomplete="new-password" placeholder="değiştirmek için girin, boş bırakılırsa mevcut şifre saklı kalır" /></div>
                                <div class="field"><label for="testProviderId">healthcareProviderId</label>
                                    <input type="text" id="testProviderId" asp-for="TestProviderId" /></div>
                            </div>
                            <div>
                                <p class="field-sub-label">Canlı (Production)</p>
                                <div class="field"><label for="liveBaseUrl">Adres (BaseUrl)</label>
                                    <input type="text" id="liveBaseUrl" asp-for="LiveBaseUrl" placeholder="https://ehr.e-health.gov.az" /></div>
                                <div class="field"><label for="liveUserName">Kullanıcı adı</label>
                                    <input type="text" id="liveUserName" asp-for="LiveUserName" autocomplete="off" /></div>
                                <div class="field"><label for="livePassword">Şifre @(Model.LivePasswordIsSet ? "(tanımlı -- değiştirmek için yeniden girin)" : "(tanımlı değil)")</label>
                                    <input type="password" id="livePassword" asp-for="LivePassword" autocomplete="new-password" placeholder="değiştirmek için girin, boş bırakılırsa mevcut şifre saklı kalır" /></div>
                                <div class="field"><label for="liveProviderId">healthcareProviderId</label>
                                    <input type="text" id="liveProviderId" asp-for="LiveProviderId" /></div>
                            </div>
                        </div>

                        @if (Model.EHealthEnvironment == "Live" && string.IsNullOrWhiteSpace(Model.LiveBaseUrl))
                        {
                            <div class="alert alert-danger">Aktif ortam "Canlı" seçili ama Canlı adres henüz girilmemiş -- gönderimler adres girilene kadar hata verir.</div>
                        }

                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Ortamı Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "ortam")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card span-2" style="flex-direction:row; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
                    <div>
                        <p class="section-title" style="margin-bottom:4px;">Kullanıcı Yönetimi &amp; Yetkilendirme</p>
                        <p class="text-muted" style="font-size:13px; margin:0;">Panele giriş yapabilecek kullanıcıları ve rollerini (Yönetici / Operatör / İzleyici) yönetin.</p>
                    </div>
                    <a asp-page="/Kullanicilar" class="btn btn-outline">Kullanıcıları Yönet →</a>
                </div>

            </div>
        </section>

        <!-- 2. OTOMATİK GÖNDERİM AYARLARI -->
        <section class="settings-panel" id="panel-oto">
            <div class="settings-grid">
                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Otomatik Gönderim</p>

                    @* ==== DURUM KUTUSU + BAŞLAT/DURDUR (2026-10-03) ====
                       KULLANICI ISTEGI: "ayarlar kısmında otomatik gönderimde altına otomatik
                       gönderimi başlat seçeneği olmalı."

                       Başlat/Durdur AYRI BİR FORM: döngüyü çalıştırmak, bir sayıyı değiştirmekle
                       aynı jest olmamalı. Onay metni ortamı ve parti boyutunu açıkça yazıyor --
                       canlı ortamda çalıştırılan bir döngünün ne yapacağı tahmine bırakılamaz.

                       Durum kutusu SON TUR bilgisini gösteriyor: "açık" yazan bir anahtar
                       döngünün gerçekten çalıştığını kanıtlamaz. Bu projede tam bu tuzak bir kez
                       yaşandı -- Ayarlar'daki otomatik gönderim anahtarlarını bir ay boyunca
                       hiçbir şey okumuyordu ve ekranda her şey normal görünüyordu. *@
                    <div class="oto-durum @(Model.OtomatikCalisiyor ? "oto-durum--acik" : "")">
                        <div class="oto-durum-ust">
                            <span class="oto-durum-rozet">
                                <span class="badge-dot"></span>
                                @(Model.OtomatikCalisiyor ? "Çalışıyor" : "Durduruldu")
                            </span>
                            @if (Model.Ortam == "Live")
                            {
                                <span class="badge danger"><span class="badge-dot"></span>CANLI ortam</span>
                            }
                            else
                            {
                                <span class="badge neutral"><span class="badge-dot"></span>Test / Sandbox</span>
                            }
                            @if (Model.OtomatikCalisiyor)
                            {
                                <span class="oto-durum-bilgi">Her @Model.AutoSendIntervalMinutes dakikada bir, en fazla @Model.AutoSendBatchSize protokol</span>
                            }
                        </div>

                        <div class="oto-durum-son">
                            @if (Model.SonTurUtc is null)
                            {
                                <text>Henüz hiç tur çalışmadı.</text>
                            }
                            else
                            {
                                <text>Son tur: <strong>@AzTime.ToLocal(Model.SonTurUtc.Value).ToString("dd.MM.yyyy HH:mm")</strong></text>
                                @if (!string.IsNullOrWhiteSpace(Model.SonTurOzet))
                                {
                                    <text> &mdash; @Model.SonTurOzet</text>
                                }
                            }
                        </div>

                        @* Başlat ve Durdur AYRI handler: tek handler + gizli "baslat" alanı
                           kullansaydık ve o alan bağlanmazsa düğme sessizce yanlış çalışırdı. *@
                        <form method="post" asp-page-handler="@(Model.OtomatikCalisiyor ? "Durdur" : "Baslat")" onsubmit="pusulaLockSubmit(this)">
                            @if (Model.OtomatikCalisiyor)
                            {
                                <button type="submit" class="btn btn-outline" style="border-color:var(--danger); color:var(--danger);"
                                        onclick="return confirm('Otomatik gönderim DURDURULACAK.\n\nTur ortasındaysa hem gönderim hem de TRƏS\'ten silme işlemi hemen durur. Bekleyen kayıtlar birikmeye devam eder; elle gönderim etkilenmez.\n\nEmin misiniz?')">
                                    Otomatik Gönderimi Durdur
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-bulk"
                                        onclick="return confirm('@(Model.Ortam == "Live" ? "DİKKAT: CANLI ORTAM.\\n\\n" : "")Otomatik gönderim BAŞLATILACAK.\n\n1) Her @Model.AutoSendIntervalMinutes dakikada bir, en fazla @Model.AutoSendBatchSize protokol @(Model.Ortam == "Live" ? "CANLI" : "Test/Sandbox") ortamına GÖNDERİLECEK. Kapanalı @Model.MinProtokolYasiGun günden az olan protokoller gönderilmez.\n\n2) Aynı turda iptal senkronu da çalışır: Pusula tarafında silinmiş veya iptal edilmiş kayıtlar TRƏS üzerinden SİLİNİR. Uzun süredir çalışmadıysa ilk turda toplu silme olabilir.\n\n3) Her gece saat @Model.TakilanDenemeSaati civarında takılan kayıtlar bir kez daha denenir.\n\nEmin misiniz?')">
                                    Otomatik Gönderimi Başlat
                                </button>
                            }
                        </form>
                    </div>

                    <p class="card-desc" style="margin-top:14px;">
                        Döngü her turda: gönderim bekleyen protokolleri hesaplar, parti boyutu kadarını gönderir,
                        Pusula'da iptal edilmişleri TRƏS'ten siler.
                        <span class="field-hint">Takılan kayıtlar (LOINC kodu olmayan tetkik, sonuç değeri olmayan satır gibi
                        mevcut veriyle gönderilemeyecek olanlar) bu turda denenmez &mdash; onların günde bir kez çalışan
                        kendi turu var.</span>
                    </p>

                    <form method="post" asp-page-handler="Genel" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field-row-2">
                            <div class="field"><label for="autoInterval">Kaç dakikada bir çalışsın?</label>
                                <input type="number" id="autoInterval" asp-for="AutoSendIntervalMinutes" min="5" max="1440" /></div>
                            <div class="field"><label for="autoBatch">Bir turda en fazla kaç protokol?</label>
                                @* TAVAN 500'DEN 5000'E CIKARILDI (2026-10-09, kullanici istegi:
                                   "tur mur koymasak, 01.10'dan itibaren tum veriyi gondersek").
                                   Birikmis veriyi tek turda kapatmak icin 500 yetmiyordu; devreye
                                   alim sonrasi 1.367 uygun protokol vardi. Gereksiz tekrar
                                   gonderim durduruldugu icin (2026-10-08) tur basina is da ciddi
                                   olcude azaldi, buyuk parti artik makul. *@
                                <input type="number" id="autoBatch" asp-for="AutoSendBatchSize" min="1" max="5000" />
                                <span class="field-hint">
                                    Birikmiş veriyi tek seferde kapatmak için yüksek tutun (ör. 2000).
                                    Uzun süren bir tur gece işlerini (takılanlar, gün sonu maili) geciktirir;
                                    &ldquo;Durdur&rdquo; tur ortasında da geçerlidir.
                                </span></div>
                        </div>
                        <div class="field-row-2">
                            @* DEVRE KESICI 2026-10-09'DA EKRANA GELDI. Koda gomuluyken,
                               bakanlik tarafinda uzun suren bir kesinti yasandiginda esigi
                               gecici olarak yukseltmenin yolu yoktu. *@
                            <div class="field">
                                <label for="devreKesici">Üst üste kaç bağlantı hatasında tur bırakılsın?</label>
                                <input type="number" id="devreKesici" asp-for="DevreKesiciSiniri" min="1" max="100" />
                                <span class="field-hint">
                                    Yalnızca <b>bağlantı/kimlik</b> hataları sayılır; bakanlığın reddettiği bir kayıt (ör. geçersiz ICD kodu)
                                    buna dahil değildir. TRƏS ulaşılamazken turun saatlerce zaman aşımında beklemesini önler.
                                </span>
                                <span asp-validation-for="DevreKesiciSiniri" style="display:block; margin-top:6px; font-size:12.5px; color:var(--danger);"></span>
                            </div>
                        </div>
                        <div class="field-row-2">
                            <div class="field">
                                <label for="minYas">Kapandıktan kaç gün sonra gönderilsin?</label>
                                <input type="number" id="minYas" asp-for="MinProtokolYasiGun" min="0" max="30" />
                                <span class="field-hint">1 = aynı gün gönderilmez. Protokol kapandığı gün geciken sonuç düşebilir, epikriz düzeltilebilir.</span>
                            </div>
                            <div class="field">
                                <label for="takilanSaat">Takılanlar hangi saatte denensin?</label>
                                <input type="number" id="takilanSaat" asp-for="TakilanDenemeSaati" min="0" max="23" />
                                <span class="field-hint">Günde bir kez. Eksik giderilmişse (LOINC kodu verilmiş, sonuç girilmiş) kayıt kendiliğinden gider.</span>
                            </div>
                        </div>
                        <div class="field-row-2">
                            <div class="field">
                                <label for="floorDate">Devreye alım tarihi &mdash; bundan önce açılan protokoller gönderilmesin</label>
                                <input type="date" id="floorDate" asp-for="SendFloorDate" />
                                <span class="field-hint">Boş bırakılırsa sınır yok. Sistem devreye girmeden önceki
                                arşivin bakanlığa gitmesini engeller.
                                <strong>Ölçüt protokolün açılışı</strong> &mdash; kapanışı bu tarihten sonraya sarksa
                                bile gönderilmez, çünkü epizot devreye alımdan önce başlamıştır. Devreye alım gününü
                                aşan uzun yatışlar da bu nedenle kapsam dışında kalır.
                                <strong>Elle gönderimi etkilemez</strong>: Protokol Listesi'nden eski bir protokolü
                                bilerek seçip gönderebilirsiniz.</span>
                            </div>
                            <div class="field">
                                <label for="takilanSure">Takılanlar turu en fazla kaç dakika sürsün?</label>
                                <input type="number" id="takilanSure" asp-for="TakilanSureDakika" min="5" max="300" />
                                <span class="field-hint">En uzun süredir denenmeyenden başlar, süre dolunca durur; ertesi gece
                                sıra kalanlara geçer. <strong>Sayı yerine süre</strong> çünkü takılan listesi binlerce protokol
                                olabiliyor ve her biri tam zincir gönderimi demek &mdash; süre, turun mesai saatine taşmasını
                                engelleyen tek güvenilir sınır.</span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "genel")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- 3. GÖNDERİM PARAMETRELERİ -->
        <section class="settings-panel" id="panel-param">
            @* MASONRY: bu bolumdeki kartlarin boylari cok farkli (Tarama Araligi uzun,
               Hata Sonrasi Tekrar Deneme kisa). CSS Grid'de satirlar hizali oldugu icin
               kisa kartin ALTINDA delik kaliyordu -- kart yuksekligini serbest birakmak
               bosluğu yok etmedi, yalnizca kartin icinden altina tasidi. Sutun akisinda
               (CSS columns) kartlar bosluk birakmadan diziliyor. *@
            <div class="settings-grid settings-grid--masonry">

                <div class="card card-pad settings-card">
                    <p class="section-title">Hata Sonrası Tekrar Deneme</p>
                    <p class="card-desc">
                        Bir gönderim hatalı olduğunda (ör. TRƏS geçici olarak yanıt vermiyorsa) sistem
                        ne kadar sürede ve kaç kez tekrar denesin.
                        <span class="field-hint">Deneme hakkı dolan kayıt kaybolmaz &mdash;
                        <strong>Takılanlar</strong> listesine geçer ve orada her gece bir kez daha denenir.
                        Eksik giderildiğinde (LOINC kodu verildi, sonuç girildi) kendiliğinden gönderilir.</span>
                    </p>
                    <form method="post" asp-page-handler="Tekrar" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field-row-2">
                            <div class="field"><label for="retryInterval">Kaç dakika sonra tekrar dene?</label>
                                <input type="number" id="retryInterval" asp-for="RetryIntervalMinutes" min="1" max="1440" />
                                <span class="field-hint">Az önce denenip hata almış bir protokol bu süre dolmadan
                                tekrar denenmez. Otomatik gönderim aralığından kısa bir değer fark yaratmaz.</span></div>
                            <div class="field"><label for="retryMax">En fazla kaç kez dene?</label>
                                <input type="number" id="retryMax" asp-for="RetryMaxAttempts" min="1" max="50" />
                                <span class="field-hint">Üst üste bu kadar hata alan kayıt Takılanlar listesine geçer.</span></div>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "tekrar")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card">
                    <p class="section-title">Tarama Aralığı</p>
                    <p class="card-desc">
                        Bekleyen işler hesaplanırken Pusula'da <b>ne kadar geriye</b> bakılacağını belirler.
                        Otomatik gönderim döngüsü ve iptal senkronu da aynı aralığı kullanır.
                        Aralık ne kadar genişse tarama o kadar uzun sürer ve hastane veritabanına o kadar yük biner
                        &mdash; ölçüldü: 60 günlük pencere <span class="mono">850.327</span> aday satır tarıyor.
                    </p>
                    <form method="post" asp-page-handler="Tarama" style="display:flex; flex-direction:column; flex:1;">
                        <div class="toggle-row">
                            <input type="radio" id="scanPreset" asp-for="PendingScanMode" value="Preset" />
                            <label for="scanPreset">Hazır aralık kullan</label>
                        </div>
                        <div class="field" style="max-width:260px; margin-left:26px;">
                            <select asp-for="PendingScanPresetDays">
                                @foreach (var a in AyarlarModel.TaramaHazirAraliklar)
                                {
                                    <option value="@a.Gun">@a.Ad (@a.Gun gün)</option>
                                }
                            </select>
                            <span asp-validation-for="PendingScanPresetDays" style="display:block; margin-top:6px; font-size:12.5px; color:var(--danger);"></span>
                        </div>

                        <div class="toggle-row" style="margin-top:14px;">
                            <input type="radio" id="scanDate" asp-for="PendingScanMode" value="Date" />
                            <label for="scanDate">Belirli bir tarihten itibaren</label>
                        </div>
                        <div class="field" style="max-width:260px; margin-left:26px;">
                            <input type="date" asp-for="PendingScanFromDate" />
                            <span asp-validation-for="PendingScanFromDate" style="display:block; margin-top:6px; font-size:12.5px; color:var(--danger);"></span>
                        </div>

                        <p class="card-desc" style="margin-top:14px;">
                            Şu anki ayarla <b>@Model.PendingScanEffectiveFrom.ToString("dd.MM.yyyy")</b>
                            tarihinden itibaren taranıyor.
                        </p>

                        <hr style="border:0; border-top:1px solid var(--border); margin:16px 0 14px;" />

                        <div class="toggle-row">
                            <input type="checkbox" id="scanIncremental" asp-for="PendingScanIncrementalEnabled" />
                            <label for="scanIncremental">Artımlı tarama (önerilir)</label>
                        </div>
                        <p class="card-desc" style="margin-left:26px;">
                            Açıkken saatlik döngü yukarıdaki pencerenin tamamını değil, <b>son taramadan bu yana</b>
                            tamamlananları sorar. Hâlâ gönderilememiş bir kalem varsa pencere kendiliğinden
                            o tarihe kadar genişler &mdash; yani takılan hiçbir kayıt listeden düşmez.
                            Yukarıdaki pencere <b>üst sınır</b> olarak kalır.
                            Kapalıyken eski davranış (her turda tam pencere) geçerlidir.
                        </p>
                        <div class="field" style="max-width:260px; margin-left:26px;">
                            <label for="sweepHour">Gecelik tam süpürme saati</label>
                            <input type="number" id="sweepHour" asp-for="PendingScanFullSweepHour" min="0" max="23" />
                            <span class="card-desc" style="display:block; margin-top:6px;">
                                Günde bir kez tam pencere taranır &mdash; geriye dönük düzeltmeler
                                (onay tarihi sonradan değiştirilen kayıtlar) bu turda yakalanır.
                            </span>
                            <span asp-validation-for="PendingScanFullSweepHour" style="display:block; margin-top:6px; font-size:12.5px; color:var(--danger);"></span>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "tarama")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card">
                    <p class="section-title">Kapanmamış Protokoller</p>
                    <p class="card-desc">
                        Varsayılan kural: bir protokol kapanana kadar (<span class="mono">KapanisTarihi</span> dolana kadar)
                        Müayinə gönderilmez. Aşağıdaki gün sayısı aşıldığında, henüz kapanmamış olsa bile gönderime
                        <b>uygun</b> sayılır.
                    </p>
                    <form method="post" asp-page-handler="Protokol" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field-row-2">
                            <div class="field">
                                <label for="days">Ayaktan: kaç gün sonra gönderime uygun say?</label>
                                <input type="number" id="days" asp-for="OpenProtokolSendAfterDays" min="0" max="365" />
                                <span class="field-hint">Ayaktan protokollerde kapanış çoğu zaman hiç yapılmıyor; bu süre dolunca yine de gönderilir.</span>
                                <span asp-validation-for="OpenProtokolSendAfterDays" style="display:block; margin-top:6px; font-size:12.5px; color:var(--danger);"></span>
                            </div>
                            @* YATAN TAVANI 2026-10-09'DA EKRANA GELDI. Deger koda gomuluydu
                               (90 gun), yani degistirmenin yolu yoktu. Olculdu (01.10-09.10):
                               97 yatan protokolun taburcusu hic girilmemis -- bu tavan tam da
                               onlari kurtaran kural, ve suresi hastaneye gore degisebilir. *@
                            <div class="field">
                                <label for="yatanTavan">Yatan: taburcu girilmezse kaç gün sonra gönder?</label>
                                <input type="number" id="yatanTavan" asp-for="YatanMaxOpenDays" min="1" max="3650" />
                                <span class="field-hint">Yatanda kural &ldquo;taburcu olunca gönder&rdquo;. Taburcu hiç girilmezse protokol sonsuza dek beklerdi; bu süre o kayıtları kurtarır.</span>
                                <span asp-validation-for="YatanMaxOpenDays" style="display:block; margin-top:6px; font-size:12.5px; color:var(--danger);"></span>
                            </div>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "protokol")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card">
                    <p class="section-title">Epikriz (Composition) Kuralları</p>
                    <p class="card-desc">
                        Epikriz gönderimini burada tamamen kapatabilir, ya da Pusula'da henüz
                        <b>kilitlenmemiş</b> (hekim tarafından tamamlanmamış) epikrizlerin gönderilmesini
                        engelleyebilirsiniz.
                    </p>
                    <form method="post" asp-page-handler="Epikriz" style="display:flex; flex-direction:column; flex:1;">
                        <div class="toggle-row">
                            <input type="checkbox" id="epikrizSendEnabled" asp-for="EpikrizSendEnabled" />
                            <label for="epikrizSendEnabled">Epikriz (Composition) gönderimini etkinleştir</label>
                        </div>
                        <div class="toggle-row">
                            <input type="checkbox" id="epikrizOnlySigned" asp-for="EpikrizOnlySigned" />
                            <label for="epikrizOnlySigned">Sadece Pusula'da kilitlenmiş (tamamlanmış) epikrizleri gönder</label>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "epikriz")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card">
                    <p class="section-title">Kayıt Türü Anahtarları</p>
                    @* ACIKLAMA DUZELTILDI (2026-10-09): eski metin hepsinin Encounter
                       cascade'inden gittigini soyluyordu, ama laboratuvar ve vital
                       ProtocolFullSyncService'ten gidiyor. Daha onemlisi o iki tur
                       listede HIC YOKTU -- yani gonderimini kapatmanin yolu da yoktu. *@
                    <p class="card-desc">
                        Bir protokol gönderilirken altındaki kayıtlar da birlikte gider; burada hangi
                        türlerin gideceğini seçersiniz. Kapatılan tür hem otomatik döngüde hem de
                        &ldquo;Tümünü Gönder&rdquo;de atlanır &mdash; Protokol Detay'daki <em>tek tek</em>
                        gönderim düğmeleri yine çalışır.
                    </p>
                    <p class="card-desc">
                        Müayinə (Encounter) ve Hasta (Patient) burada yok, çünkü onlar zincirin temeli:
                        ikisi gönderilmeden altındaki hiçbir kayıt gönderilemez. Epikrizin kendi ayrı
                        kartı var (imzalı/imzasız seçeneği olduğu için).
                    </p>
                    <form method="post" asp-page-handler="TaniIslem" style="display:flex; flex-direction:column; flex:1;">
                        <div class="toggle-row">
                            <input type="checkbox" id="conditionSendEnabled" asp-for="ConditionSendEnabled" />
                            <label for="conditionSendEnabled">Tanı (Condition) otomatik gönderimini etkinleştir</label>
                        </div>
                        <div class="toggle-row">
                            <input type="checkbox" id="procedureSendEnabled" asp-for="ProcedureSendEnabled" />
                            <label for="procedureSendEnabled">İşlem (Procedure) otomatik gönderimini etkinleştir</label>
                        </div>
                        @* Bu ikisi kod tarafinda aylardir okunuyordu ama ekranda karsiligi
                           yoktu -- yani gonderimi kapatan bir dugme vardi, kullanici
                           goremiyordu (ayar denetimi, 2026-10-08). *@
                        <div class="toggle-row">
                            <input type="checkbox" id="radiologyReportSendEnabled" asp-for="RadiologyReportSendEnabled" />
                            <label for="radiologyReportSendEnabled">Radyoloji raporu (DiagnosticReport) otomatik gönderimini etkinleştir</label>
                        </div>
                        <div class="toggle-row">
                            <input type="checkbox" id="pathologyReportSendEnabled" asp-for="PathologyReportSendEnabled" />
                            <label for="pathologyReportSendEnabled">Patoloji raporu (DiagnosticReport + zinciri) otomatik gönderimini etkinleştir</label>
                        </div>
                        @* LABORATUVAR VE VITAL 2026-10-09'DA EKLENDI. Ikisi de aylardir
                           gonderiliyordu ama ekranda anahtari yoktu. Laboratuvar hacmin en
                           buyuk kalemi (haftada ~42.000 kayit) -- bir sorun ciktiginda tek
                           basina durdurulabilmesi gereken ilk sey o. *@
                        <div class="toggle-row">
                            <input type="checkbox" id="labSendEnabled" asp-for="LabSendEnabled" />
                            <label for="labSendEnabled">Laboratuvar sonucu (Observation) otomatik gönderimini etkinleştir</label>
                        </div>
                        <div class="toggle-row">
                            <input type="checkbox" id="vitalSignsSendEnabled" asp-for="VitalSignsSendEnabled" />
                            <label for="vitalSignsSendEnabled">Vital bulgular (Observation &mdash; ateş, nabız, tansiyon) otomatik gönderimini etkinleştir</label>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "tanislem")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                @* "Lab Kurallari -- Hazir degil" karti 2026-10-09'da KALDIRILDI.
                   "Lab sonucu gonderimi icin mapper henuz yazilmadi" diyordu; oysa
                   laboratuvar aylardir gonderiliyor (haftada ~42.000 kayit) ve artik
                   Kayit Turu Anahtarlari kartinda kendi acma/kapama anahtari var.
                   Yanlis bilgi veren bir yer tutucu, hic olmayan bir karttan kotu. *@

            </div>
        </section>

        <!-- 4. MAİL BİLGİLENDİRME -->
        <section class="settings-panel" id="panel-mail">
            <div class="settings-grid">
                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Gün Sonu Maili</p>
                    <p class="card-desc">
                        Her sabah belirlenen saatte <strong>bir önceki günün</strong> gönderim bilançosunu aşağıdaki
                        alıcılara e-posta ile gönderir: kaç protokol denendi, kaçı başarılı, kaçı hatalı, ve
                        gönderilemeyen kayıtların Türkçe sebebiyle listesi.
                        <span class="field-hint">Sorun olmayan günlerde de gelir &mdash; mail gelmediği gün sistemin
                        çalışmadığı anlaşılır. Raporda hasta adı ve FİN bilgisi bilinçli olarak yer almaz, yalnızca
                        protokol numarası yazar.</span>
                    </p>
                    <form method="post" asp-page-handler="Mail" style="display:flex; flex-direction:column; flex:1;">
                        <div class="toggle-row">
                            <input type="checkbox" id="mailEnabled" asp-for="MailEnabled" />
                            <label for="mailEnabled">Gün sonu mailini gönder</label>
                        </div>

                        <div class="field-row-2">
                            <div class="field-row-21">
                                <div class="field"><label for="smtpHost">SMTP sunucu adresi</label>
                                    <input type="text" id="smtpHost" asp-for="MailSmtpHost" /></div>
                                <div class="field"><label for="smtpPort">Port</label>
                                    <input type="number" id="smtpPort" asp-for="MailSmtpPort" min="1" max="65535" /></div>
                            </div>
                            <div class="field-row-2">
                                <div class="field"><label for="mailUser">Kullanıcı adı <span class="field-hint">(opsiyonel)</span></label>
                                    <input type="text" id="mailUser" asp-for="MailUsername" autocomplete="off" /></div>
                                <div class="field"><label for="mailPass">Şifre</label>
                                    <input type="password" id="mailPass" asp-for="MailPassword" autocomplete="new-password" /></div>
                            </div>
                        </div>

                        <div class="toggle-row" style="max-width:220px;">
                            <input type="checkbox" id="mailTls" asp-for="MailUseTls" />
                            <label for="mailTls">TLS/SSL kullan</label>
                        </div>

                        <div class="field-row-21">
                            <div class="field"><label for="mailFrom">Gönderen adres (From)</label>
                                <input type="email" id="mailFrom" asp-for="MailFromAddress" /></div>
                            <div class="field"><label for="mailHour">Gönderim saati (0-23)</label>
                                <input type="number" id="mailHour" asp-for="MailSendHour" min="0" max="23" />
                                <span class="field-hint">Bu saatte dünün raporu gider. 7 = sabah işe gelindiğinde
                                gelen kutusunda hazır.</span></div>
                            @* Tavan 2026-10-09'da ekrana geldi; koda gomuluydu (300). *@
                            <div class="field"><label for="mailTavan">Mailde en fazla kaç hatalı kalem listelensin?</label>
                                <input type="number" id="mailTavan" asp-for="MailHataliKalemTavani" min="1" max="5000" />
                                <span class="field-hint">Toplam sayı her zaman yazılır; bu yalnızca listenin uzunluğunu sınırlar,
                                mailin okunamaz hale gelmemesi için.</span></div>
                        </div>

                        <div class="field">
                            <label for="mailRecipients">Alıcılar <span class="field-hint">(virgül veya yeni satırla ayırın)</span></label>
                            <textarea id="mailRecipients" asp-for="MailRecipients" rows="2" placeholder="ornek1@livhospital.com, ornek2@livhospital.com"></textarea>
                        </div>

                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "mail")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>

                    @* ==== ON IZLEME + TEST GONDERIMI (2026-10-05) ====
                       SMTP yapilandirmasinin dogru olup olmadigini sabah 07:00'de ogrenmek
                       kotu bir tasarim: yanlissa o gunun raporu kaybedilmis olur ve kimse
                       fark etmez. Iki ayri dugme cunku iki ayri soruya cevap veriyorlar:
                         "Rapor nasil gorunuyor?"  -> On izleme (mail GONDERMEZ)
                         "SMTP calisiyor mu?"      -> Test maili (gercek gonderim)
                       Test maili AYRI BIR FORM: ustteki formla ayni Kaydet dugmesine
                       baglansaydi, bir ayari degistirip kaydetmek istedigimizde mail de
                       giderdi. *@
                    <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--border);">
                        <p class="card-desc" style="margin-bottom:10px;">
                            <strong>Göndermeden önce kontrol edin.</strong> Ön izleme raporu tarayıcıda açar, mail
                            göndermez. Test maili, kayıtlı alıcılara gerçek bir mail atar &mdash; SMTP ayarlarının
                            çalıştığını kanıtlamanın tek yolu.
                        </p>
                        <div class="card-actions">
                            <a class="btn btn-outline" asp-page="/GunSonuRaporu" target="_blank" rel="noopener">
                                Dünün raporunu ön izle
                            </a>
                            <form method="post" asp-page-handler="TestMaili" style="display:inline;"
                                  onsubmit="pusulaLockSubmit(this)">
                                <button type="submit" class="btn btn-outline"
                                        onclick="return confirm('Kayıtlı alıcılara GERÇEK bir test maili gönderilecek.

İçerik dünün gün sonu raporu olacak.

Emin misiniz?')">
                                    Test maili gönder
                                </button>
                            </form>
                            @if (Model.MailTestSonucu is { } ts)
                            {
                                <span class="rchip @(Model.MailTestBasarili ? "success" : "danger")">@ts</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@{
    // Kaydedilen bolume gore ilgili sekme sunucu tarafinda da acik gelsin -- POST/redirect
    // sonrasi JS'in ayrica isi olmasin diye basit bir data-attribute ile isaretliyoruz.
    var savedTab = Model.SavedSection switch
    {
        "veritabani" or "ortam" => "ortam",
        "genel" => "oto",
        "tekrar" or "protokol" or "epikriz" or "tanislem" => "param",
        "mail" => "mail",
        _ => null,
    };
}
@if (savedTab is not null)
{
    <script>document.addEventListener('DOMContentLoaded', function () { pusulaSettingsNavClick('@savedTab'); });</script>
}

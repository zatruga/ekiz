@page
@model PusulaEHealthSync.Web.Pages.AyarlarModel
@{
    ViewData["Title"] = "Ayarlar";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Ayarlar</h1>
        <p class="page-subtitle">Ortam, otomatik gönderim, tekrar deneme ve bildirim kuralları</p>
    </div>
</div>

@* SESSIZ RED ARTIK YOK (2026-10-09).
   Kullanici parti boyutuna 2000 yazdi, kaydetti, sayfayi yenileyince eski deger geri
   gelmisti. Sebep: sunucu tarafi dogrulama degeri reddetmis, handler erken donmus --
   ama o alanin asp-validation-for span'i olmadigi icin EKRANDA hicbir sey yazmamisti.
   Kaydetmedigini soylemeyen bir "Kaydet" dugmesi, bozuk bir dugmeden kotudur.
   Bu seritte formdaki TUM dogrulama hatalari listeleniyor, alan alan span eklemeye
   bagli kalmadan. *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert-warning" style="margin-bottom:16px;">
        <b>Kaydedilmedi.</b> Girilen değerlerden biri kabul edilmedi:
        <div asp-validation-summary="All" style="margin-top:6px;"></div>
    </div>
}

<div class="settings-shell">
    <partial name="Shared/_SettingsNav" model="@("ortam")" />

    <div>
        <!-- 1. ORTAM · SİSTEM AYARLARI -->
        <section class="settings-panel active" id="panel-ortam">
            <div class="settings-grid">

                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Kaynak Veritabanı Bağlantısı</p>
                    <p class="card-desc">
                        Hastane bilgi sisteminin (şu an Pusula) veritabanı bağlantı bilgisi. Boş bırakılırsa
                        mevcut sunucu yapılandırması (appsettings/user-secrets) kullanılmaya devam eder --
                        burada bir şey girmeden mevcut davranış bozulmaz.
                    </p>
                    <form method="post" asp-page-handler="Veritabani" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field-row-2">
                            <div class="field"><label for="dbServer">Sunucu adresi (IP)</label>
                                <input type="text" id="dbServer" asp-for="PusulaDbServer" placeholder="10.10.201.50" /></div>
                            <div class="field"><label for="dbName">Veritabanı adı</label>
                                <input type="text" id="dbName" asp-for="PusulaDbName" placeholder="Pusula" /></div>
                        </div>
                        <div class="field-row-2">
                            <div class="field"><label for="dbUser">Kullanıcı adı</label>
                                <input type="text" id="dbUser" asp-for="PusulaDbUser" autocomplete="off" /></div>
                            <div class="field"><label for="dbPassword">Şifre @(Model.PusulaDbPasswordIsSet ? "(tanımlı -- değiştirmek için yeniden girin)" : "(tanımlı değil)")</label>
                                <input type="password" id="dbPassword" asp-for="PusulaDbPassword" autocomplete="new-password" placeholder="değiştirmek için girin, boş bırakılırsa mevcut şifre saklı kalır" /></div>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Veritabanı Bağlantısını Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "veritabani")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Ortam &middot; Sistem Adresleri</p>
                    <p class="card-desc">
                        Sistem şu an hangi TRƏS ortamına gönderim yapacak. Alanlar boş bırakılırsa Test ortamı için
                        mevcut sunucu yapılandırması (appsettings/user-secrets) kullanılmaya devam eder -- burada bir şey
                        girmeden mevcut davranış bozulmaz.
                    </p>
                    <form method="post" asp-page-handler="Ortam" style="display:flex; flex-direction:column; flex:1;">
                        <label class="field-sub-label">Aktif ortam</label>
                        <div class="segmented">
                            <input type="radio" id="envTest" name="EHealthEnvironment" value="Test" checked="@(Model.EHealthEnvironment != "Live")" />
                            <label for="envTest">Test / Sandbox</label>
                            <input type="radio" id="envLive" name="EHealthEnvironment" value="Live" checked="@(Model.EHealthEnvironment == "Live")" />
                            <label for="envLive">Canlı (Production)</label>
                        </div>

                        <div class="field-row-2">
                            <div>
                                <p class="field-sub-label">Test / Sandbox</p>
                                <div class="field"><label for="testBaseUrl">Adres (BaseUrl)</label>
                                    <input type="text" id="testBaseUrl" asp-for="TestBaseUrl" placeholder="https://ehr-sandbox.e-health.gov.az" /></div>
                                <div class="field"><label for="testUserName">Kullanıcı adı</label>
                                    <input type="text" id="testUserName" asp-for="TestUserName" autocomplete="off" /></div>
                                <div class="field"><label for="testPassword">Şifre @(Model.TestPasswordIsSet ? "(tanımlı -- değiştirmek için yeniden girin)" : "(tanımlı değil)")</label>
                                    <input type="password" id="testPassword" asp-for="TestPassword" autocomplete="new-password" placeholder="değiştirmek için girin, boş bırakılırsa mevcut şifre saklı kalır" /></div>
                                <div class="field"><label for="testProviderId">healthcareProviderId</label>
                                    <input type="text" id="testProviderId" asp-for="TestProviderId" /></div>
                            </div>
                            <div>
                                <p class="field-sub-label">Canlı (Production)</p>
                                <div class="field"><label for="liveBaseUrl">Adres (BaseUrl)</label>
                                    <input type="text" id="liveBaseUrl" asp-for="LiveBaseUrl" placeholder="https://ehr.e-health.gov.az" /></div>
                                <div class="field"><label for="liveUserName">Kullanıcı adı</label>
                                    <input type="text" id="liveUserName" asp-for="LiveUserName" autocomplete="off" /></div>
                                <div class="field"><label for="livePassword">Şifre @(Model.LivePasswordIsSet ? "(tanımlı -- değiştirmek için yeniden girin)" : "(tanımlı değil)")</label>
                                    <input type="password" id="livePassword" asp-for="LivePassword" autocomplete="new-password" placeholder="değiştirmek için girin, boş bırakılırsa mevcut şifre saklı kalır" /></div>
                                <div class="field"><label for="liveProviderId">healthcareProviderId</label>
                                    <input type="text" id="liveProviderId" asp-for="LiveProviderId" /></div>
                            </div>
                        </div>

                        @if (Model.EHealthEnvironment == "Live" && string.IsNullOrWhiteSpace(Model.LiveBaseUrl))
                        {
                            <div class="alert alert-danger">Aktif ortam "Canlı" seçili ama Canlı adres henüz girilmemiş -- gönderimler adres girilene kadar hata verir.</div>
                        }

                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Ortamı Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "ortam")
                            {
                                <span class="rchip success">Kaydedildi</span>
                            }
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card span-2" style="flex-direction:row; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
                    <div>
                        <p class="section-title" style="margin-bottom:4px;">Kullanıcı Yönetimi &amp; Yetkilendirme</p>
                        <p class="text-muted" style="font-size:13px; margin:0;">Panele giriş yapabilecek kullanıcıları ve rollerini (Yönetici / Operatör / İzleyici) yönetin.</p>
                    </div>
                    <a asp-page="/Kullanicilar" class="btn btn-outline">Kullanıcıları Yönet →</a>
                </div>

            </div>
        </section>

        <!-- 2. OTOMATİK GÖNDERİM -->
        @* ==== SORUYA GORE GRUPLU (2026-10-26) ====
           KULLANICI: "otomatik gonderim ayarlari da gonderim parametre alani da birbirine
           karismis, sacma sapan gosteriyor -- duzenleyip acikli sekilde duzenleyelim".
           Her kart TEK bir soruyu cevapliyor ve kendi Kaydet'i var (bkz. AyarlarModel,
           OnPostZamanlama/Kapsam/Takilan). En ustteki ozet, kayitli degerlerden HESAPLANAN
           duz cumle: ayarlarin birlikte ne anlama geldigini tek yerde soyler. *@
        @{
            var minYas = Model.MinProtokolYasiGun;
            var acikGun = Model.OpenProtokolSendAfterDays;
            string GunSonra(int n) => n == 0 ? "hemen (sıradaki turda)" : n == 1 ? "ertesi gün" : $"{n} gün sonra";
            DateTime? taban = DateTime.TryParseExact(Model.SendFloorDate, "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var tb) ? tb : null;

            // Kurum basina bolum / doktor kurali -- ozet satiri, tablo hucreleri, duzenleyici sutunlari
            // (bkz. GonderimKurali).
            var kt = Model.KuralTablosu;
            string DigerMetni(PusulaEHealthSync.Sync.KuralSatiri d) => d.Gonderme ? "hiç gönderilmez"
                : d.Serbest ? "hepsi gönderilir" : "bölüm / doktor kuralıyla gönderilir";

            void KuralHucreleri(PusulaEHealthSync.Sync.KuralSatiri sr)
            {
                if (sr.Gonderme)
                {
                    <td><span class="rchip danger">Hiç gönderilmez</span></td><td class="kural-bos">—</td><td class="kural-bos">—</td>
                }
                else
                {
                    <td><span class="rchip success">Gönderilir</span></td>
                    <td>@AyarlarModel.KuralMetni(sr.BolumModu, sr.Bolumler, Model.BolumAdlari, "Bölüm")</td>
                    <td>@AyarlarModel.KuralMetni(sr.DoktorModu, sr.Doktorlar, Model.DoktorAdlari, "Doktor")</td>
                }
            }

            void KuralSutunu(string baslik, string modAdi, string mod, string listeAdi, List<int> secili,
                             List<AyarlarModel.KuralSecenek> secenekler)
            {
                var m = PusulaEHealthSync.Sync.GonderimKurali.Mod(mod);
                <fieldset class="ayar-grup kural-sutun">
                    <legend>@baslik</legend>
                    <div class="kural-mod" role="radiogroup" aria-label="@baslik kuralı">
                        <label><input type="radio" name="@modAdi" value="Tumu" checked="@(m == PusulaEHealthSync.Sync.KuralModu.Tumu)" /> Tümü</label>
                        <label><input type="radio" name="@modAdi" value="Yalniz" checked="@(m == PusulaEHealthSync.Sync.KuralModu.Yalniz)" /> Yalnız işaretliler</label>
                        <label><input type="radio" name="@modAdi" value="Haric" checked="@(m == PusulaEHealthSync.Sync.KuralModu.Haric)" /> İşaretliler hariç</label>
                    </div>
                    <input type="search" class="ayar-bolum-ara" placeholder="@baslik ara" aria-label="@baslik ara"
                           oninput="var q=this.value.toLocaleLowerCase('tr');this.nextElementSibling.querySelectorAll('label').forEach(function(l){l.hidden=q&&l.textContent.toLocaleLowerCase('tr').indexOf(q)<0;})" />
                    <div class="ayar-bolum-liste kural-liste">
                        @foreach (var o in secenekler)
                        {
                            <label class="ayar-bolum"><input type="checkbox" name="@listeAdi" value="@o.Id" checked="@secili.Contains(o.Id)" />
                                <span class="kural-ad">@o.Ad</span><span class="kural-adet">@(o.Adet > 0 ? o.Adet.ToString("N0") : "—")</span></label>
                        }
                        @if (secenekler.Count == 0) { <span class="field-hint">Liste boş.</span> }
                    </div>
                    <p class="field-hint" style="margin-top:4px;">@(m == PusulaEHealthSync.Sync.KuralModu.Tumu ? "Sınır yok — işaretler dikkate alınmaz." : $"{secili.Count} işaretli.")</p>
                </fieldset>
            }
        }
        <section class="settings-panel" id="panel-oto">
            <div class="settings-grid">

                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Otomatik Gönderim</p>
                    @* Baslat/Durdur AYRI form: canli veri yazan donguyu baslatmak bir sayiyi
                       degistirmekle ayni jest olmamali. Durum kutusu SON TUR bilgisini
                       gosteriyor -- "acik" yazan bir anahtar dongunun calistigini kanitlamaz. *@
                    <div class="oto-durum @(Model.OtomatikCalisiyor ? "oto-durum--acik" : "")">
                        <div class="oto-durum-ust">
                            <span class="oto-durum-rozet">
                                <span class="badge-dot"></span>
                                @(Model.OtomatikCalisiyor ? "Çalışıyor" : "Durduruldu")
                            </span>
                            @if (Model.Ortam == "Live")
                            {
                                <span class="badge danger"><span class="badge-dot"></span>CANLI ortam</span>
                            }
                            else
                            {
                                <span class="badge neutral"><span class="badge-dot"></span>Test / Sandbox</span>
                            }
                        </div>
                        <div class="oto-durum-son">
                            @if (Model.SonTurUtc is null)
                            {
                                <text>Henüz hiç tur çalışmadı.</text>
                            }
                            else
                            {
                                <text>Son tur: <strong>@AzTime.ToLocal(Model.SonTurUtc.Value).ToString("dd.MM.yyyy HH:mm")</strong></text>
                                @if (!string.IsNullOrWhiteSpace(Model.SonTurOzet))
                                {
                                    <text> &mdash; @Model.SonTurOzet</text>
                                }
                            }
                        </div>
                        <form method="post" asp-page-handler="@(Model.OtomatikCalisiyor ? "Durdur" : "Baslat")" onsubmit="pusulaLockSubmit(this)">
                            @if (Model.OtomatikCalisiyor)
                            {
                                <button type="submit" class="btn btn-outline" style="border-color:var(--danger); color:var(--danger);"
                                        onclick="return confirm('Otomatik gönderim DURDURULACAK.\n\nTur ortasındaysa hem gönderim hem de TRƏS\'ten silme işlemi hemen durur. Bekleyen kayıtlar birikmeye devam eder; elle gönderim etkilenmez.\n\nEmin misiniz?')">
                                    Otomatik Gönderimi Durdur
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-bulk"
                                        onclick="return confirm('@(Model.Ortam == "Live" ? "DİKKAT: CANLI ORTAM.\\n\\n" : "")Otomatik gönderim BAŞLATILACAK.\n\n1) Her @Model.AutoSendIntervalMinutes dakikada bir, en fazla @Model.AutoSendBatchSize protokol @(Model.Ortam == "Live" ? "CANLI" : "Test/Sandbox") ortamına GÖNDERİLECEK.\n\n2) Aynı turda iptal senkronu da çalışır: Pusula tarafında silinmiş veya iptal edilmiş kayıtlar TRƏS üzerinden SİLİNİR.\n\n3) Her gece saat @Model.TakilanDenemeSaati:00 civarında takılan kayıtlar bir kez daha denenir.\n\nEmin misiniz?')">
                                    Otomatik Gönderimi Başlat
                                </button>
                            }
                        </form>
                    </div>

                    <p class="ayar-ozet-baslik">Şu anki ayarlarla sistem şöyle çalışıyor</p>
                    <ol class="ayar-ozet">
                        <li>
                            <span class="ayar-ozet-no">1</span>
                            <span><b>Her @Model.AutoSendIntervalMinutes dakikada bir</b> tur çalışır; gönderime uygun protokollerden
                            en fazla <b>@Model.AutoSendBatchSize</b> tanesini, icbari işlemi olanlar önce olmak üzere gönderir.
                            Pusula'da silinen kayıtlar aynı turda TRƏS'ten de silinir.</span>
                        </li>
                        <li>
                            <span class="ayar-ozet-no">2</span>
                            <span><b>Ayaktan / günübirlik protokol</b> kapandıktan <b>@GunSonra(minYas)</b> gönderilir.
                            Hiç kapanmazsa açıldığı günden <b>@GunSonra(acikGun + minYas)</b> gönderilir.</span>
                        </li>
                        <li>
                            <span class="ayar-ozet-no">3</span>
                            @if (Model.AutoSendYatanEnabled)
                            {
                                <span><b>Yatan hasta protokolü</b> taburcudan <b>@GunSonra(minYas)</b> gönderilir. Taburcu hiç girilmezse
                                açılıştan <b>@Model.YatanMaxOpenDays gün</b> sonra gönderilir.</span>
                            }
                            else
                            {
                                <span><b>Yatan hasta protokolleri otomatik gönderilmez</b>; arşiv bunları <b>Yatan Hastalar</b> ekranından elle gönderir.</span>
                            }
                        </li>
                        <li>
                            <span class="ayar-ozet-no">4</span>
                            <span>@if (taban is { } t) { <text><b>@t.ToString("dd.MM.yyyy")</b> tarihinden önce açılan protokoller otomatik gönderilmez.</text> } else { <text>Devreye alım tarihi tanımlı değil: tarama aralığındaki tüm protokoller gönderilebilir.</text> }</span>
                        </li>
                        <li>
                            <span class="ayar-ozet-no">5</span>
                            <span>Hata alan kayıt <b>@Model.RetryIntervalMinutes dakika</b> sonra yeniden denenir; <b>@Model.RetryMaxAttempts</b> kez
                            üst üste hata alırsa <b>Takılanlar</b>'a geçer. Takılanlar her gece <b>@(Model.TakilanDenemeSaati.ToString("00")):00</b>'da
                            en fazla <b>@Model.TakilanSureDakika dakika</b> boyunca bir kez daha denenir.</span>
                        </li>
                        <li>
                            <span class="ayar-ozet-no">6</span>
                            <span>@if (!kt.Etkin) { <text>Kurum, bölüm ve doktor sınırı yok: kurallara uyan her protokol gönderilir.</text> } else { <text>@if (kt.Satirlar.Count > 0) { <b>@kt.Satirlar.Count kurum</b><text> için ayrı bölüm / doktor kuralı var; </text> }diğer kurumlar <b>@DigerMetni(kt.Diger)</b>. Kural dışı kalanlar elle gönderilir.</text> }</span>
                        </li>
                    </ol>
                    @if (minYas == 0 && acikGun == 0)
                    {
                        <div class="alert alert-warning" style="margin-top:12px;">
                            <b>Dikkat:</b> iki bekleme süresi de 0. Kapanmamış ayaktan protokoller açıldıkları anda gönderilir;
                            hasta henüz muayenedeyken TRƏS'e yarım veri gider, sonradan gelen her sonuç için güncelleme gönderilir.
                        </div>
                    }
                </div>

                @* ---- KART 1: TUR ZAMANLAMASI ---- *@
                <div class="card card-pad settings-card">
                    <p class="section-title">Tur zamanlaması</p>
                    <p class="card-desc">Döngünün ne sıklıkta ve bir turda ne kadar iş yapacağı.</p>
                    <form method="post" asp-page-handler="Zamanlama" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field">
                            <label for="autoInterval">Tur aralığı (dakika)</label>
                            <input type="number" id="autoInterval" asp-for="AutoSendIntervalMinutes" min="5" max="1440" />
                            <span class="field-hint">Bir tur bittikten sonra bu kadar beklenir, sonra yeni tur başlar.</span>
                            <span asp-validation-for="AutoSendIntervalMinutes" class="field-hata"></span>
                        </div>
                        <div class="field">
                            <label for="autoBatch">Bir turda en fazla kaç protokol</label>
                            <input type="number" id="autoBatch" asp-for="AutoSendBatchSize" min="1" max="5000" />
                            <span class="field-hint">Birikmiş iş varsa yüksek tutun (ör. 2000). Ölçülen hız saatte ~1.400 protokol.
                            &ldquo;Durdur&rdquo; tur ortasında da geçerlidir.</span>
                            <span asp-validation-for="AutoSendBatchSize" class="field-hata"></span>
                        </div>
                        <div class="field">
                            <label for="devreKesici">Üst üste kaç bağlantı hatasında tur bırakılsın</label>
                            <input type="number" id="devreKesici" asp-for="DevreKesiciSiniri" min="1" max="100" />
                            <span class="field-hint">Yalnızca <b>bağlantı/kimlik</b> hataları sayılır; TRƏS ulaşılamazken turun saatlerce
                            zaman aşımında beklemesini önler. Bakanlığın reddettiği tek bir kayıt sayılmaz.</span>
                            <span asp-validation-for="DevreKesiciSiniri" class="field-hata"></span>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "zamanlama") { <span class="rchip success">Kaydedildi</span> }
                        </div>
                    </form>
                </div>

                @* ---- KART 2: HANGI PROTOKOL NE ZAMAN ---- *@
                <div class="card card-pad settings-card">
                    <p class="section-title">Hangi protokol, ne zaman gönderilir</p>
                    <p class="card-desc">Bir protokolün otomatik gönderime <b>uygun</b> sayılma kuralları. Elle gönderimi etkilemez.</p>
                    <form method="post" asp-page-handler="Kapsam" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field">
                            <label for="minYas">Kapandıktan kaç gün sonra gönderilsin</label>
                            <input type="number" id="minYas" asp-for="MinProtokolYasiGun" min="0" max="30" />
                            <span class="field-hint">Takvim günü: <b>1</b> = aynı gün gönderilmez, ertesi gün gider (geciken sonuç ve epikriz
                            düzeltmesi için). <b>0</b> = kapandıktan sonraki ilk turda.</span>
                            <span asp-validation-for="MinProtokolYasiGun" class="field-hata"></span>
                        </div>
                        <div class="field">
                            <label for="days">Ayaktan protokol hiç kapanmazsa, açıldıktan kaç gün sonra</label>
                            <input type="number" id="days" asp-for="OpenProtokolSendAfterDays" min="0" max="365" />
                            <span class="field-hint">Ayaktan protokollerin bir kısmı Pusula'da hiç kapatılmıyor; bu süre dolunca kapanmış
                            gibi işlem görür (üstteki bekleme de eklenir).</span>
                            <span asp-validation-for="OpenProtokolSendAfterDays" class="field-hata"></span>
                        </div>
                        <div class="toggle-row" style="margin-top:4px;">
                            <input type="checkbox" id="autoYatan" asp-for="AutoSendYatanEnabled" />
                            <label for="autoYatan">Yatan hasta protokollerini otomatik gönder</label>
                        </div>
                        <span class="field-hint" style="display:block; margin:-4px 0 12px;">Kapalıysa yatanları arşiv <b>Yatan Hastalar</b>
                        ekranından elle gönderir. Açıksa ölçüt taburcu tarihidir.</span>
                        <div class="field">
                            <label for="yatanTavan">Yatan: taburcu girilmezse açılıştan kaç gün sonra</label>
                            <input type="number" id="yatanTavan" asp-for="YatanMaxOpenDays" min="1" max="3650" />
                            <span class="field-hint">Taburcusu hiç girilmeyen yatışların sonsuza dek beklemesini önler.</span>
                            <span asp-validation-for="YatanMaxOpenDays" class="field-hata"></span>
                        </div>
                        <div class="field">
                            <label for="floorDate">Devreye alım tarihi (bundan önce açılanlar gönderilmez)</label>
                            <input type="date" id="floorDate" asp-for="SendFloorDate" />
                            <span class="field-hint">Ölçüt protokolün <b>açılış</b> tarihi. Boş = sınır yok. Eski bir protokolü
                            Protokol Listesi'nden bilerek elle gönderebilirsiniz.</span>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "kapsam") { <span class="rchip success">Kaydedildi</span> }
                        </div>
                    </form>
                </div>

                @* ---- KART 2b: KIM GONDERILIR (KURUM BASINA BOLUM / DOKTOR) ---- *@
                <div class="card card-pad settings-card span-2" id="gonderim-kurallari">
                    <p class="section-title">Hangi kurum, bölüm ve doktor gönderilir</p>
                    <p class="card-desc">Her kurum için ayrı bölüm ve doktor kuralı tanımlanabilir. Protokolün kurumunun satırı varsa
                    o satır, yoksa <b>Diğer kurumlar</b> satırı uygulanır; bölüm ve doktor kuralı birlikte geçerlidir. Kural dışı kalan
                    protokol Bekleyen İşler'de <b>Kural</b> aşamasında görünür ve <b>elle gönderilebilir</b>.</p>
                    @if (Model.KuralListesiOkunamadi)
                    {
                        <div class="alert alert-warning" style="margin-bottom:10px;">Pusula'ya ulaşılamadı — adlar ve listeler eksik olabilir.</div>
                    }
                    @if (Model.KuralHatasi is { } kh)
                    {
                        <div class="alert alert-danger" style="margin-bottom:10px;">@kh</div>
                    }
                    <div class="kural-tablo-kap">
                        <table class="table kural-tablo">
                            <thead><tr><th>Kurum</th><th>Gönderim</th><th>Bölüm</th><th>Doktor</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var sr in Model.KuralTablosu.Satirlar.OrderBy(x => Model.KurumAdi(x.KurumId!.Value), StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"), true)))
                                {
                                    var sid = sr.KurumId!.Value;
                                    <tr class="@(Model.KuralDuzenle == sid.ToString() ? "kural-secili" : "")">
                                        <td><b>@Model.KurumAdi(sid)</b></td>
                                        @{ KuralHucreleri(sr); }
                                        <td class="kural-islem">
                                            <a class="btn btn-outline btn-sm" href="?kural=@sid#gonderim-kurallari">Düzenle</a>
                                            <form method="post" asp-page-handler="KuralSil" asp-route-kurumId="@sid" style="display:inline;"
                                                  onsubmit="return confirm('@Model.KurumAdi(sid).Replace("'", "") kuralı silinecek; bu kurumun protokollerine Diğer kurumlar kuralı uygulanır. Emin misiniz?')">
                                                <button type="submit" class="btn btn-outline btn-sm">Sil</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                <tr class="kural-diger @(Model.DuzenDiger ? "kural-secili" : "")">
                                    <td><b>Diğer kurumlar</b><span class="kural-not">tabloda satırı olmayan tüm kurumlar@(Model.KuralTablosu.Satirlar.Count == 0 ? ", kurumsuz dahil" : "")</span></td>
                                    @{ KuralHucreleri(Model.KuralTablosu.Diger); }
                                    <td class="kural-islem"><a class="btn btn-outline btn-sm" href="?kural=diger#gonderim-kurallari">Düzenle</a></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    @if (Model.KuralDuzenle is null)
                    {
                        <div class="card-actions">
                            <a class="btn btn-primary" href="?kural=yeni#gonderim-kurallari">+ Kurum kuralı ekle</a>
                            @if (Model.Saved && Model.SavedSection == "kural") { <span class="rchip success">Kaydedildi</span> }
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="KuralKaydet" class="kural-duzen">
                            <input type="hidden" name="kural" value="@Model.KuralDuzenle" />
                            <p class="ayar-alt-baslik kural-duzen-baslik">@(Model.DuzenYeni ? "Yeni kurum kuralı" : Model.DuzenDiger ? "Diğer kurumlar kuralı" : $"{Model.KurumAdi(Model.DuzenKurumId ?? 0)} kuralı")</p>
                            <div class="kural-grid">
                                <fieldset class="ayar-grup kural-sutun">
                                    <legend>Kurum</legend>
                                    @if (Model.DuzenYeni)
                                    {
                                        <input type="search" class="ayar-bolum-ara" placeholder="Kurum ara" aria-label="Kurum ara"
                                               oninput="var q=this.value.toLocaleLowerCase('tr');this.nextElementSibling.querySelectorAll('label').forEach(function(l){l.hidden=q&&l.textContent.toLocaleLowerCase('tr').indexOf(q)<0;})" />
                                        <div class="ayar-bolum-liste kural-liste kural-liste--kisa">
                                            @foreach (var o in Model.KurumSecenekleri)
                                            {
                                                <label class="ayar-bolum"><input type="radio" name="DuzenKurumId" value="@o.Id" checked="@(Model.DuzenKurumId == o.Id)" />
                                                    <span class="kural-ad">@o.Ad</span><span class="kural-adet">@(o.Adet > 0 ? o.Adet.ToString("N0") : "—")</span></label>
                                            }
                                            @if (Model.KurumSecenekleri.Count == 0) { <span class="field-hint">Kuralı olmayan kurum kalmadı.</span> }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="kural-kurum-ad">@(Model.DuzenDiger ? "Tabloda satırı olmayan tüm kurumlar" : Model.KurumAdi(Model.DuzenKurumId ?? 0))</p>
                                    }
                                    <span class="ayar-alt-baslik" style="margin-top:10px;">Gönderim</span>
                                    <div class="kural-mod kural-mod--dikey" role="radiogroup" aria-label="Gönderim">
                                        <label><input type="radio" name="DuzenGonderme" value="false" checked="@(!Model.DuzenGonderme)" /> Gönder — bölüm ve doktor kuralına göre</label>
                                        <label><input type="radio" name="DuzenGonderme" value="true" checked="@Model.DuzenGonderme" /> Hiç otomatik gönderme</label>
                                    </div>
                                    <p class="field-hint">"Hiç otomatik gönderme" seçilirse bölüm ve doktor işaretleri dikkate alınmaz.</p>
                                </fieldset>
                                @{ KuralSutunu("Bölüm", "DuzenBolumModu", Model.DuzenBolumModu, "DuzenBolumler", Model.DuzenBolumler, Model.BolumKuralSecenekleri); }
                                @{ KuralSutunu("Doktor", "DuzenDoktorModu", Model.DuzenDoktorModu, "DuzenDoktorlar", Model.DuzenDoktorlar, Model.DoktorSecenekleri); }
                            </div>
                            <div class="card-actions">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                                <a class="btn btn-outline" href="?kural=#gonderim-kurallari">Vazgeç</a>
                            </div>
                        </form>
                    }
                </div>

                @* ---- KART 3: HATALAR VE TAKILANLAR ---- *@
                <div class="card card-pad settings-card span-2">
                    <p class="section-title">Hatalar ve takılanlar</p>
                    <p class="card-desc">Gönderimi hata alan kayıt önce gün içinde yeniden denenir; deneme hakkı dolunca
                    <b>Takılanlar</b>'a geçer ve her gece bir kez daha denenir. Eksik giderildiyse (LOINC kodu verildi, sonuç girildi)
                    kayıt kendiliğinden gider.</p>
                    <form method="post" asp-page-handler="Takilan" style="display:flex; flex-direction:column; flex:1;">
                        <div class="ayar-iki-grup">
                            <fieldset class="ayar-grup">
                                <legend>Gün içinde</legend>
                                <div class="field">
                                    <label for="retryInterval">Hata sonrası kaç dakika beklensin</label>
                                    <input type="number" id="retryInterval" asp-for="RetryIntervalMinutes" min="1" max="1440" />
                                    <span class="field-hint">Tur aralığından kısa bir değer fark yaratmaz.</span>
                                    <span asp-validation-for="RetryIntervalMinutes" class="field-hata"></span>
                                </div>
                                <div class="field">
                                    <label for="retryMax">Kaç kez denensin</label>
                                    <input type="number" id="retryMax" asp-for="RetryMaxAttempts" min="1" max="50" />
                                    <span class="field-hint">Üst üste bu kadar hata alan kayıt Takılanlar'a geçer.</span>
                                    <span asp-validation-for="RetryMaxAttempts" class="field-hata"></span>
                                </div>
                            </fieldset>
                            <fieldset class="ayar-grup">
                                <legend>Gece turu (takılanlar)</legend>
                                <div class="field">
                                    <label for="takilanSaat">Saat kaçta başlasın (0–23)</label>
                                    <input type="number" id="takilanSaat" asp-for="TakilanDenemeSaati" min="0" max="23" />
                                    <span class="field-hint">Günde bir kez.</span>
                                    <span asp-validation-for="TakilanDenemeSaati" class="field-hata"></span>
                                </div>
                                <div class="field">
                                    <label for="takilanSure">En fazla kaç dakika sürsün</label>
                                    <input type="number" id="takilanSure" asp-for="TakilanSureDakika" min="5" max="300" />
                                    <span class="field-hint">En uzun süredir denenmeyenden başlar; süre dolunca durur, kalanlar ertesi geceye kalır.</span>
                                    <span asp-validation-for="TakilanSureDakika" class="field-hata"></span>
                                </div>
                            </fieldset>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "takilan") { <span class="rchip success">Kaydedildi</span> }
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- 3. GÖNDERİM PARAMETRELERİ -->
        <section class="settings-panel" id="panel-param">
            <div class="settings-grid">

                @* ---- GONDERILECEK KAYIT TURLERI (Epikriz kurallari dahil, tek form) ---- *@
                <div class="card card-pad settings-card">
                    <p class="section-title">Gönderilecek kayıt türleri</p>
                    <p class="card-desc">Bir protokol gönderilirken altındaki kayıtlar da birlikte gider. Kapatılan tür otomatik
                    gönderimde ve &ldquo;Tümünü Gönder&rdquo;de atlanır; Protokol Detay'daki tek tek gönderim düğmeleri yine çalışır.
                    <span class="field-hint">Hasta ve Müayinə burada yok: zincirin temeli onlar, ikisi gitmeden hiçbir kayıt gidemez.</span></p>
                    <form method="post" asp-page-handler="Icerik" style="display:flex; flex-direction:column; flex:1;">
                        <fieldset class="ayar-grup">
                            <legend>Muayene kayıtları</legend>
                            <div class="toggle-row"><input type="checkbox" id="conditionSendEnabled" asp-for="ConditionSendEnabled" />
                                <label for="conditionSendEnabled">Tanı <span class="ayar-teknik">Condition</span></label></div>
                            <div class="toggle-row"><input type="checkbox" id="procedureSendEnabled" asp-for="ProcedureSendEnabled" />
                                <label for="procedureSendEnabled">İşlem (icbari) <span class="ayar-teknik">Procedure</span></label></div>
                            <div class="toggle-row"><input type="checkbox" id="vitalSignsSendEnabled" asp-for="VitalSignsSendEnabled" />
                                <label for="vitalSignsSendEnabled">Vital bulgular: ateş, nabız, tansiyon <span class="ayar-teknik">Observation</span></label></div>
                        </fieldset>
                        <fieldset class="ayar-grup">
                            <legend>Tetkik sonuçları</legend>
                            <div class="toggle-row"><input type="checkbox" id="labSendEnabled" asp-for="LabSendEnabled" />
                                <label for="labSendEnabled">Laboratuvar sonucu <span class="ayar-teknik">Observation</span></label></div>
                            <div class="toggle-row"><input type="checkbox" id="radiologyReportSendEnabled" asp-for="RadiologyReportSendEnabled" />
                                <label for="radiologyReportSendEnabled">Radyoloji raporu <span class="ayar-teknik">DiagnosticReport</span></label></div>
                            <div class="toggle-row"><input type="checkbox" id="pathologyReportSendEnabled" asp-for="PathologyReportSendEnabled" />
                                <label for="pathologyReportSendEnabled">Patoloji raporu ve bulguları <span class="ayar-teknik">DiagnosticReport + zinciri</span></label></div>
                        </fieldset>
                        <fieldset class="ayar-grup">
                            <legend>Epikriz</legend>
                            <div class="toggle-row"><input type="checkbox" id="epikrizSendEnabled" asp-for="EpikrizSendEnabled" />
                                <label for="epikrizSendEnabled">Epikriz <span class="ayar-teknik">Composition</span></label></div>
                            <div class="toggle-row"><input type="checkbox" id="epikrizOnlySigned" asp-for="EpikrizOnlySigned" />
                                <label for="epikrizOnlySigned">Yalnızca Pusula'da kilitlenmiş (hekimin tamamladığı) epikrizler</label></div>
                            <div class="field" style="margin-top:10px;">
                                <span class="ayar-alt-baslik">Epikriz beklenmeyen bölümler</span>
                                <p class="field-hint" style="margin:2px 0 6px;">İşaretli bölümlerin protokollerinde boş epikriz <b>eksik sayılmaz</b> (yalnızca tetkik için açılan protokoller). Liste son 90 günde protokol açılmış bölümlerden; işaretliler en üstte.</p>
                                @if (Model.BolumListesiOkunamadi)
                                {
                                    <p class="field-hint" style="color:var(--danger);">Pusula'ya ulaşılamadı — yalnızca şu an seçili bölümler gösteriliyor.</p>
                                }
                                <input type="search" class="ayar-bolum-ara" placeholder="Bölüm ara" aria-label="Bölüm ara"
                                       oninput="var q=this.value.toLocaleLowerCase('tr');this.nextElementSibling.querySelectorAll('label').forEach(function(l){l.hidden=q&&l.textContent.toLocaleLowerCase('tr').indexOf(q)<0;})" />
                                <div class="ayar-bolum-liste">
                                    @foreach (var b in Model.BolumSecenekleri)
                                    {
                                        <label class="ayar-bolum"><input type="checkbox" name="EpikrizMuafBolumler" value="@b"
                                               checked="@Model.EpikrizMuafBolumler.Contains(b, StringComparer.CurrentCultureIgnoreCase)" /> @b</label>
                                    }
                                </div>
                                <p class="field-hint" style="margin-top:4px;">Seçili: <b>@(Model.EpikrizMuafBolumler.Count == 0 ? "yok" : string.Join(", ", Model.EpikrizMuafBolumler))</b></p>
                            </div>
                        </fieldset>
                        <fieldset class="ayar-grup" id="hizmet-kurallari">
                            <legend>Hizmetler (işlem)</legend>
                            <div class="field">
                                <label for="hizmetOnEk" class="ayar-alt-baslik">Kendiliğinden gönderilmeyecek hizmetler</label>
                                <input type="text" id="hizmetOnEk" asp-for="HizmetGonderilmezOnEkler" placeholder="Kafeterya" />
                                <p class="field-hint">Adı bu sözcüklerle <b>başlayan</b> hizmetler bakanlığa gönderilmez ve hiçbir raporda eksik sayılmaz. Birden fazlaysa <code>;</code> ile ayırın. Boş bırakılırsa kural kapanır.</p>
                            </div>
                            <div class="field">
                                <label for="hizmetSozcuk" class="ayar-alt-baslik">"Tıbbi olmayabilir" süzgecinin sözcükleri</label>
                                <textarea id="hizmetSozcuk" asp-for="HizmetTibbiOlmayanSozcukler" rows="2"></textarea>
                                <p class="field-hint">Hizmet Eşleştirme'deki süzgeç, adında bu sözcüklerden biri <b>tam sözcük olarak</b> geçen hizmetleri listeler (ör. "su", "suspenziya"yı yakalamaz). Süzgeç işaretleme yapmaz; karar sizin.</p>
                            </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "icerik") { <span class="rchip success">Kaydedildi</span> }
                        </div>
                    </form>
                </div>

                @* ---- TARAMA ARALIGI (teknik) ---- *@
                <div class="card card-pad settings-card">
                    <p class="section-title">Tarama aralığı <span class="ayar-teknik">teknik</span></p>
                    <p class="card-desc">
                        Bekleyen işler hesaplanırken Pusula'da <b>ne kadar geriye</b> bakılacağı. Otomatik gönderim ve iptal senkronu
                        bu aralığın dışındaki protokolleri görmez. Aralık genişledikçe tarama uzar ve Pusula'ya yük biner
                        (60 günlük pencere <span class="mono">850.327</span> aday satır tarıyor).
                    </p>
                    <form method="post" asp-page-handler="Tarama" style="display:flex; flex-direction:column; flex:1;">
                        <div class="toggle-row">
                            <input type="radio" id="scanPreset" asp-for="PendingScanMode" value="Preset" />
                            <label for="scanPreset">Hazır aralık</label>
                        </div>
                        <div class="field" style="max-width:260px; margin-left:26px;">
                            <select asp-for="PendingScanPresetDays">
                                @foreach (var a in AyarlarModel.TaramaHazirAraliklar)
                                {
                                    <option value="@a.Gun">@a.Ad (@a.Gun gün)</option>
                                }
                            </select>
                            <span asp-validation-for="PendingScanPresetDays" class="field-hata"></span>
                        </div>
                        <div class="toggle-row" style="margin-top:10px;">
                            <input type="radio" id="scanDate" asp-for="PendingScanMode" value="Date" />
                            <label for="scanDate">Belirli bir tarihten itibaren</label>
                        </div>
                        <div class="field" style="max-width:260px; margin-left:26px;">
                            <input type="date" asp-for="PendingScanFromDate" />
                            <span asp-validation-for="PendingScanFromDate" class="field-hata"></span>
                        </div>
                        <p class="card-desc" style="margin-top:6px;">Şu an <b>@Model.PendingScanEffectiveFrom.ToString("dd.MM.yyyy")</b> tarihinden itibaren taranıyor.</p>

                        <fieldset class="ayar-grup" style="margin-top:8px;">
                            <legend>Artımlı tarama</legend>
                            <div class="toggle-row">
                                <input type="checkbox" id="scanIncremental" asp-for="PendingScanIncrementalEnabled" />
                                <label for="scanIncremental">Açık (önerilir)</label>
                            </div>
                            <span class="field-hint" style="display:block; margin:-4px 0 10px;">Her turda tüm pencere yerine yalnızca
                            <b>son taramadan bu yana</b> tamamlananlar sorulur; gönderilememiş kalem varsa pencere kendiliğinden genişler.</span>
                            <div class="field" style="max-width:260px;">
                                <label for="sweepHour">Gecelik tam tarama saati (0–23)</label>
                                <input type="number" id="sweepHour" asp-for="PendingScanFullSweepHour" min="0" max="23" />
                                <span class="field-hint">Günde bir kez tam pencere taranır; geriye dönük düzeltmeler bu turda yakalanır.</span>
                                <span asp-validation-for="PendingScanFullSweepHour" class="field-hata"></span>
                            </div>
                        </fieldset>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                            @if (Model.Saved && Model.SavedSection == "tarama") { <span class="rchip success">Kaydedildi</span> }
                        </div>
                    </form>
                </div>
            </div>
        </section>

        <!-- 4. MAİL BİLGİLENDİRME -->
        @* ==== E-POSTA (2026-10-23 yeniden duzenlendi) ====
           KULLANICI: "her bilgi maili icin tanimlama yapilacak bir alan olmali; mail icerigi ve
           gonderilecek kisileri secim yapmam gerekli" + "zamanlama ayarlari da olmali" +
           "mail gonderimini gercekten test etmedik".
           Uc katman, her biri kendi formu ve Kaydet'iyle: SMTP -> KISILER -> TURLER.
           Her kartin sonucu (kaydedildi / test sonucu / hata) KENDI altinda gorunur. *@
        @{
            void Sonuc(string yer)
            {
                if (Model.MailSonucYeri == yer && Model.MailSonucMetni is { } m)
                {
                    <div class="alert @(Model.MailSonucBasarili ? "alert-success" : "alert-danger")" style="margin:12px 0 0;">@m</div>
                }
            }
        }
        <section class="settings-panel" id="panel-mail">
            <div class="settings-grid">

                @* ---- 1) SMTP ---- *@
                <div class="card card-pad settings-card">
                    <p class="section-title">1 · SMTP bağlantısı</p>
                    <p class="card-desc">Bütün e-postalar bu sunucu üzerinden gider. Kaydettikten sonra sağdaki
                        <strong>bağlantı testi</strong> ile gerçekten çalıştığını doğrulayın.</p>
                    <form method="post" asp-page-handler="Mail" style="display:flex; flex-direction:column; flex:1;">
                        <div class="field-row-21">
                            <div class="field"><label for="smtpHost">SMTP sunucu adresi</label>
                                <input type="text" id="smtpHost" asp-for="MailSmtpHost" /></div>
                            <div class="field"><label for="smtpPort">Port</label>
                                <input type="number" id="smtpPort" asp-for="MailSmtpPort" min="1" max="65535" /></div>
                        </div>
                        <div class="field-row-2">
                            <div class="field"><label for="mailUser">Kullanıcı adı <span class="field-hint">(opsiyonel)</span></label>
                                <input type="text" id="mailUser" asp-for="MailUsername" autocomplete="off" /></div>
                            <div class="field"><label for="mailPass">Şifre</label>
                                <input type="password" id="mailPass" asp-for="MailPassword" autocomplete="new-password" /></div>
                        </div>
                        <div class="field-row-2">
                            <div class="field"><label for="mailFrom">Gönderen adres (From)</label>
                                <input type="email" id="mailFrom" asp-for="MailFromAddress" /></div>
                            <div class="toggle-row" style="align-self:end;">
                                <input type="checkbox" id="mailTls" asp-for="MailUseTls" />
                                <label for="mailTls">TLS/SSL kullan</label>
                            </div>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>

                <div class="card card-pad settings-card">
                    <p class="section-title">SMTP bağlantı testi</p>
                    <p class="card-desc">Seçtiğiniz adrese <strong>gerçek</strong> bir deneme e-postası gönderir. Gitmezse
                        SMTP sunucusunun verdiği hata aynen burada görünür. Önce SMTP ayarlarını kaydedin.</p>
                    <form method="post" asp-page-handler="SmtpTest" onsubmit="pusulaLockSubmit(this)"
                          style="display:flex; flex-direction:column; flex:1;">
                        <div class="field">
                            <label for="smtpTestAdres">Alıcı</label>
                            <input type="email" id="smtpTestAdres" name="adres" list="mailKisiListesi"
                                   placeholder="kişilerden seçin ya da adres yazın" />
                            <datalist id="mailKisiListesi">
                                @foreach (var k in Model.MailKisileri)
                                {
                                    <option value="@k.Eposta">@k.Ad</option>
                                }
                            </datalist>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-outline">Test e-postası gönder</button>
                        </div>
                    </form>
                    @{ Sonuc("smtp"); }
                </div>

                @* ---- 2) KISILER ---- *@
                <div class="card card-pad settings-card span-2">
                    <p class="section-title">2 · Kişiler</p>
                    <p class="card-desc">E-posta alabilecek kişiler. Burada bir kez tanımlanır, aşağıdaki her e-posta türünde
                        kimin alacağı işaretlenerek seçilir. Satır başına bir kişi:
                        <code>Ad Soyad &lt;adres@ornek.com&gt;</code> ya da yalnızca adres.</p>
                    <form method="post" asp-page-handler="Kisiler" style="display:flex; flex-direction:column;">
                        <div class="field">
                            <label for="kisilerMetni" class="sr-only">Kişiler</label>
                            <textarea id="kisilerMetni" name="kisilerMetni" rows="@Math.Max(3, Model.MailKisileri.Count + 1)"
                                      placeholder="Ferhat Erçetin <ferhat@livhospital.com>">@string.Join("\n", Model.MailKisileri.Select(k => string.IsNullOrWhiteSpace(k.Ad) ? k.Eposta : $"{k.Ad} <{k.Eposta}>"))</textarea>
                            <span class="field-hint">Listeden çıkarılan bir kişi, seçili olduğu türlerden de düşer.</span>
                        </div>
                        <div class="card-actions">
                            <button type="submit" class="btn btn-primary">Kişileri kaydet</button>
                        </div>
                    </form>
                    @{ Sonuc("kisiler"); }
                </div>

                @* ---- 3) TURLER ---- *@
                @foreach (var tur in PusulaEHealthSync.Reporting.MailTurleri.Hepsi)
                {
                    var ayar = Model.MailTurAyarlari.GetValueOrDefault(tur.Kod)
                               ?? new PusulaEHealthSync.Reporting.MailAyarlari.TurAyari(false, [], tur.VarsayilanKonu, tur.VarsayilanMesaj);
                    var id = "mt-" + tur.Kod;
                    // Kisi listesinde olmayan ama secili kalmis adresler de gosteriliyor
                    // (ornegin eski alici listesinden gelen) -- sessizce dusmesinler.
                    var secenekler = Model.MailKisileri
                        .Concat(ayar.Alicilar
                            .Where(a => !Model.MailKisileri.Any(k => k.Eposta.Equals(a, StringComparison.OrdinalIgnoreCase)))
                            .Select(a => new PusulaEHealthSync.Reporting.MailAyarlari.Kisi("(listede yok)", a)))
                        .ToList();

                    <div class="card card-pad settings-card span-2 mail-tur" id="@id">
                        <div class="mail-tur-bas">
                            <p class="section-title" style="margin:0;">3 · @tur.Ad</p>
                            <span class="rchip @(ayar.Acik ? "success" : "disabled")">@(ayar.Acik ? "Açık" : "Kapalı")</span>
                            <span class="rchip neutral">@ayar.Alicilar.Count alıcı</span>
                        </div>
                        <p class="card-desc">@tur.Aciklama</p>

                        <form method="post" asp-page-handler="MailTuru" style="display:flex; flex-direction:column;">
                            <input type="hidden" name="kod" value="@tur.Kod" />
                            <div class="toggle-row">
                                <input type="checkbox" id="@(id)-acik" name="acik" value="true" checked="@ayar.Acik" />
                                <label for="@(id)-acik">Bu e-postayı gönder</label>
                            </div>

                            <fieldset class="mail-alicilar">
                                <legend>Alıcılar</legend>
                                @if (secenekler.Count == 0)
                                {
                                    <span class="field-hint">Önce yukarıdaki <strong>Kişiler</strong> listesine en az bir kişi ekleyin.</span>
                                }
                                @foreach (var k in secenekler)
                                {
                                    var cid = $"{id}-a-{k.Eposta.GetHashCode():x}";
                                    <label for="@cid" class="mail-alici">
                                        <input type="checkbox" id="@cid" name="alicilar" value="@k.Eposta"
                                               checked="@ayar.Alicilar.Contains(k.Eposta, StringComparer.OrdinalIgnoreCase)" />
                                        <span>@(string.IsNullOrWhiteSpace(k.Ad) ? k.Eposta : k.Ad)</span>
                                        @if (!string.IsNullOrWhiteSpace(k.Ad)) { <span class="mail-alici-adres">@k.Eposta</span> }
                                    </label>
                                }
                            </fieldset>

                            @* ZAMANLAMA -- yalnizca zamanlamasi olan turlerde. *@
                            @if (tur.Kod == PusulaEHealthSync.Reporting.MailTurleri.GunSonu)
                            {
                                <div class="field-row-2">
                                    <div class="field"><label for="@(id)-saat">Gönderim saati (0-23)</label>
                                        <input type="number" id="@(id)-saat" name="saat" value="@Model.MailSendHour" min="0" max="23" required />
                                        <span class="field-hint">Bu saatte dünün raporu gider. 7 = sabah işe gelindiğinde hazır.</span></div>
                                    <div class="field"><label for="@(id)-tavan">En fazla kaç hatalı kalem listelensin?</label>
                                        <input type="number" id="@(id)-tavan" name="tavan" value="@Model.MailHataliKalemTavani" min="1" max="5000" required />
                                        <span class="field-hint">Toplam sayı her zaman yazılır; bu yalnızca listenin uzunluğu.</span></div>
                                </div>
                            }
                            else if (tur.Kod == PusulaEHealthSync.Reporting.MailTurleri.ServisDurdu)
                            {
                                <div class="field-row-2">
                                    <div class="field"><label for="@(id)-tol">Kaç dakika sürerse uyarılsın?</label>
                                        <input type="number" id="@(id)-tol" name="tolerans" value="@Model.UyariToleransDakika" min="1" max="1440" required />
                                        <span class="field-hint">Elle yeniden başlatma gibi kısa kesintiler e-posta üretmesin.</span></div>
                                    <div class="field"><label for="@(id)-tekrar">Sorun sürdükçe kaç saatte bir hatırlatılsın?</label>
                                        <input type="number" id="@(id)-tekrar" name="tekrar" value="@Model.UyariTekrarSaat" min="1" max="168" required /></div>
                                </div>
                            }

                            <div class="field">
                                <label for="@(id)-konu">Konu</label>
                                <input type="text" id="@(id)-konu" name="konu" value="@ayar.Konu" required />
                            </div>
                            <div class="field">
                                <label for="@(id)-mesaj">Mesaj</label>
                                <textarea id="@(id)-mesaj" name="mesaj" rows="5">@ayar.Mesaj</textarea>
                                <span class="field-hint">Düz metin; boş satır yeni paragraf.
                                    @if (tur.Kod == PusulaEHealthSync.Reporting.MailTurleri.GunSonu)
                                    {
                                        <text>Raporun tablosu mesajın altına kendiliğinden eklenir; mesaj boş bırakılabilir.</text>
                                    }
                                </span>
                            </div>
                            <div class="mail-degiskenler">
                                <span class="field-hint">Kullanılabilecek değişkenler (tıklayınca mesaja eklenir):</span>
                                @foreach (var d in tur.Degiskenler)
                                {
                                    <button type="button" class="mail-degisken" title="@d.Aciklama — örnek: @d.Ornek"
                                            onclick="mailDegiskenEkle('@(id)-mesaj', '{@d.Ad}')">{@d.Ad}</button>
                                }
                            </div>

                            <div class="card-actions">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                                <a class="btn btn-outline" asp-page="/Ayarlar" asp-page-handler="MailOnizle" asp-route-kod="@tur.Kod"
                                   target="_blank" rel="noopener" title="Kayıtlı ayarla, e-posta göndermeden tarayıcıda gösterir">Ön izle</a>
                                <button type="submit" class="btn btn-outline" form="@(id)-test">Test gönder</button>
                            </div>
                        </form>
                        @* Test AYRI FORM: Kaydet'e bagli olsaydi her kayitta e-posta giderdi. Kayitli
                           ayarla gider -- degisiklik yaptiysaniz once Kaydet. *@
                        <form id="@(id)-test" method="post" asp-page-handler="MailTuruTest" asp-route-kod="@tur.Kod"
                              onsubmit="return confirm('Bu türün seçili alıcılarına GERÇEK bir test e-postası gönderilecek (kayıtlı ayarlarla).\n\nDevam edilsin mi?') && (pusulaLockSubmit(this), true)"></form>
                        @{ Sonuc(tur.Kod); }
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@{
    // Kaydedilen bolume gore ilgili sekme sunucu tarafinda da acik gelsin -- POST/redirect
    // sonrasi JS'in ayrica isi olmasin diye basit bir data-attribute ile isaretliyoruz.
    var savedTab = Model.SavedSection switch
    {
        "veritabani" or "ortam" => "ortam",
        "oto" or "zamanlama" or "kapsam" or "kural" or "takilan" => "oto",
        "icerik" or "tarama" => "param",
        "mail" => "mail",
        _ => null,
    };
}
@if (savedTab is not null)
{
    <script>document.addEventListener('DOMContentLoaded', function () {
        pusulaSettingsNavClick('@savedTab');
        // Sekme acildiktan sonra capaya in (kural tablosu: ?kural=...#gonderim-kurallari).
        var hedef = location.hash && document.getElementById(location.hash.slice(1));
        if (hedef) { hedef.scrollIntoView({ block: 'start' }); }
    });</script>
}

<script>
    // E-posta sablonu: degisken dugmesi imlecin oldugu yere {degisken} ekler.
    function mailDegiskenEkle(alanId, metin) {
        var t = document.getElementById(alanId);
        if (!t) { return; }
        var bas = t.selectionStart ?? t.value.length, son = t.selectionEnd ?? t.value.length;
        t.value = t.value.slice(0, bas) + metin + t.value.slice(son);
        t.focus();
        t.selectionStart = t.selectionEnd = bas + metin.length;
    }
</script>

<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-PusulaEHealthSync-7bd2a2e0-1dde-4b0f-9b1d-c6f36ed9cc21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
  </ItemGroup>

  <!-- PusulaEHealthSync.Web bu projeyi ProjectReference ile kullaniyor. SDK'nin appsettings*.json
       icin uyguladigi varsayilan CopyToOutputDirectory/CopyToPublishDirectory item metadata'si,
       "Content" olsun "None" olsun fark etmeksizin, Web publish edilirken bu projenin
       appsettings dosyalarinin da Web'in appsettings dosyalariyla AYNI goreli yola kopyalanmaya
       calisilmasina yol aciyor (NETSDK1152 cakismasi). Cozum: bu dosyalari MSBuild'in otomatik
       build/publish item takibinden tamamen cikarip (Remove), sadece BU projenin kendi build/
       publish ciktisina, referans eden projelerin ciktisina degil, elle bir Target ile kopyaliyoruz.
       Boylece PusulaEHealthSync STANDALONE calistirildiginda (Worker Service) appsettings.json
       kendi cikti klasorunde olmaya devam ediyor, ama Web'in publish'ine hic sizmiyor.
  -->
  <ItemGroup>
    <Content Remove="appsettings.json" />
    <Content Remove="appsettings.Development.json" />
    <None Remove="appsettings.json" />
    <None Remove="appsettings.Development.json" />
  </ItemGroup>

  <Target Name="CopyOwnAppSettingsOnBuild" AfterTargets="Build">
    <ItemGroup>
      <_OwnAppSettings Include="appsettings.json" Condition="Exists('appsettings.json')" />
      <_OwnAppSettings Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_OwnAppSettings)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(OutDir)' != ''" />
  </Target>

  <Target Name="CopyOwnAppSettingsOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_OwnAppSettings Include="appsettings.json" Condition="Exists('appsettings.json')" />
      <_OwnAppSettings Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_OwnAppSettings)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <!-- AZ ICD-10 kod -> standart Azerbaycanca aciklama (bkz. AzIcd10.cs) -->
    <EmbeddedResource Include="Resources/az-icd-10.tsv" LogicalName="PusulaEHealthSync.Resources.az-icd-10.tsv" />
    <EmbeddedResource Include="Resources/loinc-display.tsv" LogicalName="PusulaEHealthSync.Resources.loinc-display.tsv" />
    <EmbeddedResource Include="Resources/lab-loinc-oneri.tsv" LogicalName="PusulaEHealthSync.Resources.lab-loinc-oneri.tsv" />
    <EmbeddedResource Include="Resources/loinc-tr.tsv" LogicalName="PusulaEHealthSync.Resources.loinc-tr.tsv" />
    <EmbeddedResource Include="Resources/az-procedure-codes.tsv" LogicalName="PusulaEHealthSync.Resources.az-procedure-codes.tsv" />
    <EmbeddedResource Include="Resources/hizmet-eslestirme.tsv" LogicalName="PusulaEHealthSync.Resources.hizmet-eslestirme.tsv" />
    <EmbeddedResource Include="Resources/az-procedure-tr.tsv" LogicalName="PusulaEHealthSync.Resources.az-procedure-tr.tsv" />
  </ItemGroup>

</Project>
